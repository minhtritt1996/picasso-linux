[Unit]
Description=Root shell on the USB gadget console (picasso)
After=usbacm.service dev-ttyGS0.device
Wants=dev-ttyGS0.device

[Service]
Type=simple
ExecStart=/bin/bash --login
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyGS0
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
# A suspend of the USB controller hangs the tty up and bash exits 0, so
# on-failure leaves the phone with no console at all. Always come back.
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
