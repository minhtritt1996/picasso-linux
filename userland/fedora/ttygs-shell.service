[Unit]
Description=Root shell on the USB gadget console (picasso)
After=usbacm.service dev-ttyGS0.device
Wants=dev-ttyGS0.device

[Service]
Type=simple
ExecStart=/bin/bash --login
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyGS0
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
