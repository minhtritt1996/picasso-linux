# Read-only upstream clones and build trees
/upstream/
/build/

# Tool output
__pycache__/
*.pyc
*.o
*.dtb
*.dtbo

# Local dtschema install used by ./build.sh check
/.venv-dtschema/
prebuilt/fw-gpu/

# Build artifacts that must never be tracked
/out/
# Vendor firmware is read from the phone at runtime, never committed
prebuilt/fw-*/
prebuilt/*.dtb
