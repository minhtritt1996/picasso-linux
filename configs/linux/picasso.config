# SM7250 SoC core: clock, pinctrl, RPMh, SPMI. Needed before any board device probes.
CONFIG_SM_GCC_7250=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM7250=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_QCOM_SMD_RPM=y

# PON keys (power = KPDPWR_N, volume down = RESIN_N) hang off the pm8150
# pon@800 node: qcom-pon owns it and creates the regmap that pm8941-pwrkey and
# pm8941-resin need.  Built in, because the RAM initramfs has no module loader.
CONFIG_POWER_RESET_QCOM_PON=y

# Novatek NT36672C touch on GENI SPI SE7 (see drivers/input/touchscreen).
# Exactly one picasso touch driver is built: both match the same
# "xiaomi,picasso-nvt-ts-spi" DT node, so building both would leave the SPI
# device to whichever driver probes first. The vendor-core port is the one
# that should deliver contacts (firmware download, touch IRQ, MT-B reports);
# the earlier hand-written poller stays in the tree as a fallback.
CONFIG_TOUCHSCREEN_PICASSO_NVT_VENDOR=y
# CONFIG_TOUCHSCREEN_PICASSO_NVT is not set

# Console capture that survives a reset: pstore/ramoops at 0xF3F00000.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# The boot chain leaves the APSS watchdog alone. Bringing the driver up now
# starts a 30 s watchdog that userspace does not pet while the kernel is still
# being debugged (a hang then resets the phone before the screen can be read).
#CONFIG_QCOM_WDT=y

# M2 (USB console) — enable together with the DTS nodes in the same change.
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=n
CONFIG_USB_DWC3_HOST=n
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# USB/NoC votes: the dwc3 wrapper refuses to probe without its interconnect
# providers (gem_noc / aggre1_noc / config_noc).
CONFIG_INTERCONNECT_QCOM_SM7250=y

# UFS: root filesystem and the firmware partition (built in, no modules on device)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EXT4_FS=y
CONFIG_EFI_PARTITION=y

# userdata may be f2fs (Android) or ext4; mount it read-only for inspection
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y

# Display: DPU 6.1.0 + DSI + the g7a panel driver (built in)
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_XIAOMI_G7A_37_02_0A=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# DRM_MSM only allows =y when these dependencies are y or n (not m)
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_LLCC=n
CONFIG_QCOM_OCMEM=n
CONFIG_QCOM_AOSS_QMP=y

# display clock controller (patch 02)
CONFIG_SM_DISPCC_7250=y

# DSI host asks for a 'refgen' supply (regulator@ff1000)
CONFIG_REGULATOR_QCOM_REFGEN=y

# Wi-Fi (WCN3990 via ath10k_snoc) and the modem remoteproc that hosts it.
# Modules do not work in this RAM boot (the initramfs carries no .ko files).
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_ATH10K_DEBUG=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=n
CONFIG_RPMSG_QCOM_SMD=n
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y

# Android vendor partition is erofs (firmware, board data for WCN3990)
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y

# rmtfs shared-memory char device (/dev/qcom_rmtfs_mem1) for the modem EFS
CONFIG_QCOM_RMTFS_MEM=y

# Bluetooth: WCN3990 over the GENI UART5 (firmware on the bluetooth partition)
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y

# Audio stack built in (no module loader in the RAM initramfs)
CONFIG_QCOM_APR=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC_USB=y
CONFIG_SND_SOC_QDSP6_USB=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QCOM_COMMON=y
CONFIG_SND_SOC_QCOM_SDW=y
CONFIG_SND_SOC_QDSP6_COMMON=y
CONFIG_SND_SOC_QDSP6_CORE=y
CONFIG_SND_SOC_QDSP6_AFE=y
CONFIG_SND_SOC_QDSP6_AFE_DAI=y
CONFIG_SND_SOC_QDSP6_AFE_CLOCKS=y
CONFIG_SND_SOC_QDSP6_ADM=y
CONFIG_SND_SOC_QDSP6_ROUTING=y
CONFIG_SND_SOC_QDSP6_ASM=y
CONFIG_SND_SOC_QDSP6_ASM_DAI=y
CONFIG_SND_SOC_QDSP6_APM=y
CONFIG_SND_SOC_QDSP6_APM_DAI=y
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=y
CONFIG_SND_SOC_QDSP6_PRM=y
CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS=y
CONFIG_SND_SOC_SM8250=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SDW=y
CONFIG_SND_SOC_WSA881X=y
CONFIG_SND_SOC_TFA9874=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y

# GENI i2c/SPI built in (the amp, touch and PMIC buses are GENI)
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y

# GPU: the clock/power controller is required or the GPU SMMU times out (-110)
CONFIG_SM_GPUCC_7250=y

# The EFI stub is the last thing that runs before the kernel on the resident-ramdisk path:
CONFIG_EFI_DEBUG=y

# Fedora/systemd userspace on the RAM root: the LSM the distro expects, pressure
# stall information for its oom handling, and the hashing interface glibc/systemd
# use for /etc/shadow and machine-id.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_NETWORK_SECMARK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_AUDIT=y
CONFIG_PSI=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# plumbing a real init needs (cgroups, namespaces, seccomp, fanotify, devtmpfs)
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FANOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_KEYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Backlight: PM8150L WLED drives the g7a panel. Built in, not =m: the RAM
# initramfs has no module loader, so a module never loads and /sys/class/backlight
# stays empty while the panel scans out frames into a dark display.
CONFIG_BACKLIGHT_QCOM_WLED=y

# Battery/charging: the SMB5 charger in PM7250B (vendor qcom,qpnp-smb5). Mainline
# has a driver for exactly this PMIC and the board already includes
# pm7250b.dtsi, so this only needs building in (the RAM initramfs has no module
# loader). Gives ONLINE/PRESENT/STATUS/CHARGE_TYPE; capacity needs a gauge and
# mainline has no PM7250B QBG driver yet.
CONFIG_CHARGER_QCOM_PM7250B=y

# Suspend bring-up needs the pm_test ladder (/sys/power/pm_test) and the
# device-level debug knobs that make a failing level name its driver.
CONFIG_PM_TEST_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# FastRPC: the ADSP's sensor user-PD init calls back into the AP over the
# reverse tunnel (apps_std_* file server). Without the driver there is no
# /dev/fastrpc-adsp, the sensor PD never finishes its init and its own watchdog
# resets the whole ADSP every ~40 s (dog_virtual_user.c USER-PD DOG), which also
# kills any audio stream. Built in: the ramdisk has no module loader.
CONFIG_QCOM_FASTRPC=y
