# Boot/console baseline: mainline arm64 Image loaded as an EFI application by linux.efi.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ARM64=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# UEFI GOP framebuffer -> simpledrm -> fbcon (no display driver needed for M1)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y
CONFIG_SERIAL_EARLYCON=y

# Console/logging
CONFIG_PRINTK=y
CONFIG_TTY=y

# Keep the build free of optional firmware/signing dependencies
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_MODULES=y

# bigger console font for reading/photographing the panel
CONFIG_FONT_TER16x32=y
