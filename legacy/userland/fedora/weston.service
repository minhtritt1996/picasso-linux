[Unit]
Description=Weston on the DRM backend (picasso)
After=multi-user.target fw-setup.service
Wants=multi-user.target
# a logind session is what libseat needs for the DRM device
[Service]
Type=simple
PAMName=login
Environment=XDG_RUNTIME_DIR=/run/user/0
TTYPath=/dev/tty1
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/weston --backend=drm-backend.so --idle-time=0 --debug
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
