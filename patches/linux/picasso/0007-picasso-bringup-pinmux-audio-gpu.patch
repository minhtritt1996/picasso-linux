diff --git a/drivers/soc/qcom/picasso-pinmux.c b/drivers/soc/qcom/picasso-pinmux.c
new file mode 100644
index 000000000..c5edb739d
--- /dev/null
+++ b/drivers/soc/qcom/picasso-pinmux.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Early pinmux for the Xiaomi Redmi K30 5G (picasso, SM7250).
+ *
+ * pinctrl-msm cannot be used for the EAST/WEST TLMM tiles on this port yet
+ * (the gpiochip registration dies when more than one tile window is mapped),
+ * so the few pads needed by Bluetooth (uart5, gpio38-41), the speaker amp
+ * (i2c8, gpio49/50) are muxed here before the GENI drivers probe.
+ *
+ * Registers follow the vendor layout: pin N ctl at 0xf000000 + tile + 0x1000*N
+ * with SOUTH 0x100000, WEST 0x500000, EAST 0x900000.
+ */
+#include <linux/init.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/moduleparam.h>
+#include <linux/string.h>
+
+/*
+ * Vendor TLMM layout: pin N ctl at 0xf000000 + tile + 0x1000 * N with
+ * SOUTH 0x100000, WEST 0x500000, EAST 0x900000.  Kernel ioremap writes to the
+ * tile windows work; the same writes through /dev/mem (Normal-NC, merging)
+ * stall the bus, which is why this early mux exists.
+ */
+#define TLMM_BASE		0x0f000000UL
+#define TLMM_SIZE		0x1000000UL
+#define TLMM_TILE_SOUTH		0x00100000UL
+#define TLMM_TILE_WEST		0x00500000UL
+#define TLMM_TILE_EAST		0x00900000UL
+#define REG_SIZE		0x1000UL
+
+#define CFG_MUX_MASK		(0xfU << 2)
+#define CFG_DRV_MASK		(0x7U << 6)
+#define CFG_OUTPUT		(1U << 9)
+#define IO_OUT_BIT		(1U << 1)
+
+
+static void __iomem *tlmm;
+
+static bool do_write;
+
+/* bias: 0 none, 1 pull-down, 2 keeper, 3 pull-up (the vendor's per-pad choice) */
+static void picasso_mux(unsigned int pin, unsigned int tile, unsigned int func,
+			unsigned int drv, unsigned int bias, bool output, int value)
+{
+	void __iomem *ctl = tlmm + tile + REG_SIZE * pin;
+	void __iomem *io = ctl + 4;
+	u32 v;
+
+	if (!tlmm)
+		return;
+	v = readl(ctl);
+	pr_info("picasso-pinmux: pin %u tile %x func %u bias %u out %d: ctl=%08x io=%08x\n",
+		pin, tile, func, bias, output ? value : -1, v, readl(io));
+	if (!do_write)
+		return;
+
+	if (output) {
+		u32 iov = readl(io);
+
+		iov = (iov & ~(IO_OUT_BIT)) | (value ? IO_OUT_BIT : 0);
+		writel(iov, io);
+	}
+	v &= ~(CFG_MUX_MASK | CFG_DRV_MASK | CFG_OUTPUT | 0x3);
+	v |= (func << 2) | (drv << 6) | (bias & 0x3);
+	if (output)
+		v |= CFG_OUTPUT;
+	writel(v, ctl);
+}
+
+static char picasso_pinmux_mode[8] = "read";
+module_param_string(mode, picasso_pinmux_mode, sizeof(picasso_pinmux_mode), 0444);
+MODULE_PARM_DESC(mode, "read (default) or write the mux registers");
+
+static int __init picasso_pinmux_init(void)
+{
+	do_write = !strcmp(picasso_pinmux_mode, "write");
+	tlmm = ioremap(TLMM_BASE, TLMM_SIZE);
+	if (!tlmm) {
+		pr_err("picasso-pinmux: cannot map TLMM\n");
+		return 0;
+	}
+
+	/* Bluetooth: 4-wire UART5 (qup05 = function 1, 2 mA) */
+	/* the vendor's qup05 bias: CTS/RX none, RTS pull-down, TX pull-up */
+	picasso_mux(38, TLMM_TILE_EAST, 1, 2, 0, false, 0);	/* CTS */
+	picasso_mux(39, TLMM_TILE_EAST, 1, 2, 1, false, 0);	/* RTS pull-down */
+	picasso_mux(40, TLMM_TILE_EAST, 1, 2, 3, false, 0);	/* TX pull-up */
+	picasso_mux(41, TLMM_TILE_EAST, 1, 2, 0, false, 0);	/* RX */
+	picasso_mux(73, TLMM_TILE_EAST, 0, 2, 0, false, 0);	/* BT SW_CTRL, input */
+
+	/* Speaker amp bus: i2c8 SDA/SCL (qup12 = function 2, 2 mA) */
+	picasso_mux(49, TLMM_TILE_WEST, 2, 2, 0, false, 0);
+	picasso_mux(50, TLMM_TILE_WEST, 2, 2, 0, false, 0);
+
+	/* Secondary MI2S to the TFA9874 (sec_mi2s = function 1, 8 mA) */
+	picasso_mux(70, TLMM_TILE_WEST, 1, 3, 0, false, 0);	/* bit clock */
+	picasso_mux(71, TLMM_TILE_WEST, 1, 3, 0, false, 0);	/* word select */
+	picasso_mux(72, TLMM_TILE_WEST, 1, 3, 0, false, 0);	/* data0 (amp sense) */
+	picasso_mux(74, TLMM_TILE_WEST, 1, 3, 0, false, 0);	/* data1 */
+
+	/* Touch: SE7 SPI pads (qup11 = function 1, 6 mA) and the reset line
+	 * (gpio4, GPIO out) and interrupt line (gpio5, GPIO in) */
+	picasso_mux(6, TLMM_TILE_WEST, 1, 3, 0, false, 0);		/* MISO */
+	picasso_mux(7, TLMM_TILE_WEST, 1, 3, 0, false, 0);		/* MOSI */
+	picasso_mux(8, TLMM_TILE_WEST, 1, 3, 0, false, 0);		/* CLK */
+	picasso_mux(9, TLMM_TILE_WEST, 1, 3, 0, false, 0);		/* CS */
+	picasso_mux(4, TLMM_TILE_EAST, 0, 2, 0, true, 0);		/* reset, low */
+	picasso_mux(5, TLMM_TILE_EAST, 0, 2, 0, false, 0);		/* interrupt in */
+
+	/* TFA9874 reset: GPIO58, active high per the vendor driver
+	 * (GPIOF_OUT_INIT_LOW idle, 1 -> 0 to reset), so idle is low */
+	picasso_mux(58, TLMM_TILE_WEST, 0, 2, 0, true, 0);
+
+	/* let the touch controller come out of reset and boot its firmware */
+	if (do_write) {
+		picasso_mux(4, TLMM_TILE_EAST, 0, 2, 0, true, 1);
+		mdelay(80);
+	}
+
+	pr_info("picasso-pinmux: uart5, i2c8, sec mi2s, amp reset and touch muxed\n");
+	return 0;
+}
+subsys_initcall(picasso_pinmux_init);
