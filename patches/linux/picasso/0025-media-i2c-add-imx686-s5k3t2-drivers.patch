+static void imx686_fill_pad_format(const struct imx686_mode *mode,
+				   struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx686_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	imx686_fill_pad_format(&imx686_modes[0],
+			       v4l2_subdev_state_get_format(sd_state, 0));
+	return 0;
+}
+
+static int imx686_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int imx686_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(imx686_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = imx686_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = imx686_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int imx686_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx686 *imx686 = to_imx686(sd);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		fmt->format = *v4l2_subdev_state_get_format(sd_state, fmt->pad);
+	else
+		imx686_fill_pad_format(imx686->cur_mode, &fmt->format);
+
+	return 0;
+}
+
+static int imx686_update_controls(struct imx686 *imx686,
+				   const struct imx686_mode *mode)
+{
+	s64 hblank, vblank, vblank_min, exposure_max;
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx686->link_freq, mode->link_freq_idx);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(imx686->pixel_rate, mode->pixel_rate,
+				       mode->pixel_rate, 1, mode->pixel_rate);
+	if (ret)
+		return ret;
+
+	hblank = mode->hts - mode->width;
+	ret = __v4l2_ctrl_modify_range(imx686->hblank, hblank, hblank, 1, hblank);
+	if (ret)
+		return ret;
+
+	vblank = mode->vts - mode->height;
+	vblank_min = mode->vts_min - mode->height;
+	ret = __v4l2_ctrl_modify_range(imx686->vblank, vblank_min,
+				       IMX686_VTS_MAX - mode->height, 1, vblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx686->vblank, vblank);
+	if (ret)
+		return ret;
+
+	exposure_max = mode->vts - IMX686_EXPOSURE_MARGIN;
+	return __v4l2_ctrl_modify_range(imx686->exposure, IMX686_EXPOSURE_MIN,
+					exposure_max, IMX686_EXPOSURE_STEP,
+					min_t(s64, IMX686_EXPOSURE_DEFAULT,
+					      exposure_max));
+}
+
+static int imx686_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx686 *imx686 = to_imx686(sd);
+	const struct imx686_mode *mode;
+	int ret = 0;
+
+	mode = v4l2_find_nearest_size(imx686_modes, ARRAY_SIZE(imx686_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+	imx686_fill_pad_format(mode, &fmt->format);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		*v4l2_subdev_state_get_format(sd_state, fmt->pad) = fmt->format;
+	} else {
+		imx686->cur_mode = mode;
+		ret = imx686_update_controls(imx686, mode);
+		if (!ret)
+			*v4l2_subdev_state_get_format(sd_state, 0) = fmt->format;
+	}
+
+	return ret;
+}
+
+static int imx686_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 u32 pad, u64 streams_mask)
+{
+	struct imx686 *imx686 = to_imx686(sd);
+	const struct imx686_reg_list *reg_list = &imx686->cur_mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx686->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(imx686->regmap, imx686_init_regs,
+				  ARRAY_SIZE(imx686_init_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(imx686->regmap, reg_list->regs,
+				  reg_list->num_regs, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(imx686->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(imx686->regmap, IMX686_REG_MODE_SELECT,
+			IMX686_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put(imx686->dev);
+	return ret;
+}
+
+static int imx686_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct imx686 *imx686 = to_imx686(sd);
+	int ret;
+
+	ret = cci_write(imx686->regmap, IMX686_REG_MODE_SELECT,
+			IMX686_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(imx686->dev, "failed to stop streaming: %d\n", ret);
+
+	usleep_range(1000, 1500);
+	pm_runtime_put(imx686->dev);
+
+	return ret;
+}
