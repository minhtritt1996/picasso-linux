+static int imx686_update_exp_gain(struct imx686 *imx686, u32 exposure, u32 gain)
+{
+	u32 fll = imx686->cur_mode->height + imx686->vblank->val;
+	int ret = 0;
+	int ret_hold;
+
+	cci_write(imx686->regmap, IMX686_REG_GRP_PARAM_HOLD, 1, &ret);
+	cci_write(imx686->regmap, IMX686_REG_FRAME_LENGTH_LINES, fll, &ret);
+	cci_write(imx686->regmap, IMX686_REG_EXPOSURE, exposure, &ret);
+	cci_write(imx686->regmap, IMX686_REG_ANALOG_GAIN, gain, &ret);
+	ret_hold = cci_write(imx686->regmap, IMX686_REG_GRP_PARAM_HOLD, 0, NULL);
+
+	return ret ? ret : ret_hold;
+}
+
+static int imx686_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx686 *imx686 = container_of(ctrl->handler, struct imx686,
+					     ctrl_handler);
+	const struct imx686_mode *mode = imx686->cur_mode;
+	s64 exposure_max;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		exposure_max = mode->height + ctrl->val - IMX686_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(imx686->exposure,
+					 imx686->exposure->minimum,
+					 exposure_max,
+					 imx686->exposure->step,
+					 min_t(s64, imx686->exposure->default_value,
+					       exposure_max));
+	}
+
+	if (!pm_runtime_get_if_in_use(imx686->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = imx686_update_exp_gain(imx686, imx686->exposure->val,
+					     imx686->again->val);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(imx686->regmap, IMX686_REG_FRAME_LENGTH_LINES,
+				mode->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(imx686->regmap, IMX686_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(imx686->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx686_ctrl_ops = {
+	.s_ctrl = imx686_set_ctrl,
+};
