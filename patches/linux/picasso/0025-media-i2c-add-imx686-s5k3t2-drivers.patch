+static int s5k3t2_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(s5k3t2->reset_gpio, 1);
+	usleep_range(1000, 1500);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s5k3t2_supply_names),
+				    s5k3t2->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(s5k3t2->opt_supplies); i++) {
+		if (!s5k3t2->opt_supplies[i])
+			continue;
+		ret = regulator_enable(s5k3t2->opt_supplies[i]);
+		if (ret) {
+			dev_err(dev, "failed to enable optional supply %s: %d\n",
+				s5k3t2_opt_supply_names[i], ret);
+			goto err_opt_reg;
+		}
+	}
+	usleep_range(1000, 1500);
+
+	ret = clk_prepare_enable(s5k3t2->xvclk);
+	if (ret) {
+		dev_err(dev, "failed to enable xvclk: %d\n", ret);
+		goto err_opt_reg;
+	}
+	usleep_range(1000, 1500);
+
+	gpiod_set_value_cansleep(s5k3t2->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	return 0;
+
+err_opt_reg:
+	while (i--) {
+		if (s5k3t2->opt_supplies[i])
+			regulator_disable(s5k3t2->opt_supplies[i]);
+	}
+	regulator_bulk_disable(ARRAY_SIZE(s5k3t2_supply_names),
+			       s5k3t2->supplies);
+	return ret;
+}
+
+static int s5k3t2_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	unsigned int i;
+
+	gpiod_set_value_cansleep(s5k3t2->reset_gpio, 1);
+	clk_disable_unprepare(s5k3t2->xvclk);
+
+	for (i = ARRAY_SIZE(s5k3t2->opt_supplies); i > 0; i--) {
+		if (s5k3t2->opt_supplies[i - 1])
+			regulator_disable(s5k3t2->opt_supplies[i - 1]);
+	}
+	regulator_bulk_disable(ARRAY_SIZE(s5k3t2_supply_names),
+			       s5k3t2->supplies);
+
+	return 0;
+}
+
+static int s5k3t2_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k3t2 *s5k3t2 = container_of(ctrl->handler, struct s5k3t2,
+					     ctrl_handler);
+	const struct s5k3t2_mode *mode = s5k3t2->cur_mode;
+	s64 exposure_max;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		exposure_max = mode->height + ctrl->val - S5K3T2_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5k3t2->exposure,
+					 s5k3t2->exposure->minimum,
+					 exposure_max,
+					 s5k3t2->exposure->step,
+					 min_t(s64, s5k3t2->exposure->default_value,
+					       exposure_max));
+	}
+
+	if (!pm_runtime_get_if_in_use(s5k3t2->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5k3t2->regmap, S5K3T2_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5k3t2->regmap, S5K3T2_REG_ANALOG_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5k3t2->regmap, S5K3T2_REG_FRAME_LENGTH_LINES,
+				mode->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5k3t2->regmap, S5K3T2_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5k3t2->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k3t2_ctrl_ops = {
+	.s_ctrl = s5k3t2_set_ctrl,
+};
