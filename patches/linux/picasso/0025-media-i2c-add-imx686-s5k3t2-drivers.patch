+static int imx686_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx686 *imx686 = to_imx686(sd);
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(imx686->reset_gpio, 1);
+	usleep_range(1000, 1500);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx686_supply_names),
+				    imx686->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(imx686->opt_supplies); i++) {
+		if (!imx686->opt_supplies[i])
+			continue;
+		ret = regulator_enable(imx686->opt_supplies[i]);
+		if (ret) {
+			dev_err(dev, "failed to enable optional supply %s: %d\n",
+				imx686_opt_supply_names[i], ret);
+			goto err_opt_reg;
+		}
+	}
+	usleep_range(1000, 1500);
+
+	ret = clk_prepare_enable(imx686->xvclk);
+	if (ret) {
+		dev_err(dev, "failed to enable xvclk: %d\n", ret);
+		goto err_opt_reg;
+	}
+	usleep_range(1000, 1500);
+
+	gpiod_set_value_cansleep(imx686->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	return 0;
+
+err_opt_reg:
+	while (i--) {
+		if (imx686->opt_supplies[i])
+			regulator_disable(imx686->opt_supplies[i]);
+	}
+	regulator_bulk_disable(ARRAY_SIZE(imx686_supply_names),
+			       imx686->supplies);
+	return ret;
+}
+
+static int imx686_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx686 *imx686 = to_imx686(sd);
+	unsigned int i;
+
+	gpiod_set_value_cansleep(imx686->reset_gpio, 1);
+	clk_disable_unprepare(imx686->xvclk);
+
+	for (i = ARRAY_SIZE(imx686->opt_supplies); i > 0; i--) {
+		if (imx686->opt_supplies[i - 1])
+			regulator_disable(imx686->opt_supplies[i - 1]);
+	}
+	regulator_bulk_disable(ARRAY_SIZE(imx686_supply_names),
+			       imx686->supplies);
+
+	return 0;
+}
