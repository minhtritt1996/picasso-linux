+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-common.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define IMX686_XVCLK_RATE		(19200000)
+#define IMX686_CPHY_TRIOS		3
+
+#define IMX686_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX686_CHIP_ID			0x0686
+
+#define IMX686_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX686_MODE_STANDBY		0x00
+#define IMX686_MODE_STREAMING		0x01
+
+#define IMX686_REG_GRP_PARAM_HOLD	CCI_REG8(0x0104)
+
+#define IMX686_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX686_EXPOSURE_MIN		8
+#define IMX686_EXPOSURE_STEP		1
+#define IMX686_EXPOSURE_MARGIN		48
+#define IMX686_EXPOSURE_DEFAULT		0x0d86
+
+#define IMX686_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define IMX686_AGAIN_MIN		0
+#define IMX686_AGAIN_MAX		1008
+#define IMX686_AGAIN_STEP		1
+#define IMX686_AGAIN_DEFAULT		0
+
+#define IMX686_REG_FRAME_LENGTH_LINES	CCI_REG16(0x0340)
+#define IMX686_VTS_MAX			0xffff
+
+#define IMX686_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define IMX686_SYM_RATE_726P4M		(726400000ULL)
+#define IMX686_SYM_RATE_956P8M		(956800000ULL)
+#define IMX686_SYM_RATE_1459P2M		(1459200000ULL)
+#define IMX686_SYM_RATE_2057P6M		(2057600000ULL)
+
+#define to_imx686(_sd)			container_of(_sd, struct imx686, sd)
+
+struct imx686_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct imx686_mode {
+	u32 width;
+	u32 height;
+	u32 hts;
+	u32 vts;
+	u32 vts_min;
+	u64 pixel_rate;
+	u32 link_freq_idx;
+	struct imx686_reg_list reg_list;
+};
+
+static const s64 imx686_link_freq_menu[] = {
+	IMX686_SYM_RATE_956P8M,
+	IMX686_SYM_RATE_1459P2M,
+	IMX686_SYM_RATE_726P4M,
+	IMX686_SYM_RATE_2057P6M,
+};
+
+static const char * const imx686_test_pattern_menu[] = {
+	"Disabled",
+	"Solid color",
+	"Color bars",
+	"Fade to grey color bars",
+	"PN9",
+};
+
+static const char * const imx686_supply_names[] = {
+	"vana",
+	"vdig",
+	"vio",
+};
+
+static const char * const imx686_opt_supply_names[] = {
+	"custom1",
+	"custom2",
+	"custom3",
+};
+
+struct imx686 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *xvclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx686_supply_names)];
+	struct regulator *opt_supplies[ARRAY_SIZE(imx686_opt_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *again;
+
+	const struct imx686_mode *cur_mode;
+};
