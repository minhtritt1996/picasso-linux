@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5k3t2.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5K3T2 Image Sensor
+
+maintainers:
+  - Picasso Linux <picasso@localhost>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5k3t2
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: xvclk
+
+  reset-gpios:
+    maxItems: 1
+
+  vana-supply:
+    description: Analog power supply.
+
+  vdig-supply:
+    description: Digital core power supply.
+
+  vio-supply:
+    description: Digital I/O power supply.
+
+  custom1-supply:
+    description: Shared CCI bus pull-up / companion supply.
+
+  custom2-supply:
+    description: Shared CCI bus pull-up / companion supply.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@56 {
+            compatible = "samsung,s5k3t2";
+            reg = <0x56>;
+            clocks = <&camcc 0>;
+            clock-names = "xvclk";
+            reset-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
+            vana-supply = <&camera_front_vana_2p8>;
+            vdig-supply = <&camera_front_vdig_1p2>;
+            vio-supply = <&camera_vio_1p8>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <300000000 896000000>;
+                    remote-endpoint = <&camss_csiphy2_ep>;
+                };
+            };
+        };
+    };
+...
