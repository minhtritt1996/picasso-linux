+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@1a {
+            compatible = "sony,imx686";
+            reg = <0x1a>;
+            clocks = <&camcc 0>;
+            clock-names = "xvclk";
+            reset-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
+            vana-supply = <&camera_wide_vana_2p8>;
+            vdig-supply = <&camera_wide_vdig_1p2>;
+            vio-supply = <&camera_vio_1p8>;
+
+            port {
+                endpoint {
+                    bus-type = <1>;
+                    data-lanes = <0 1 2>;
+                    link-frequencies = /bits/ 64 <956800000>;
+                    remote-endpoint = <&camss_csiphy1_ep>;
+                };
+            };
+        };
+    };
+...
