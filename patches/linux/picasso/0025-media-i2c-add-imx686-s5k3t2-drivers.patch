+static int imx686_init_controls(struct imx686 *imx686)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx686->ctrl_handler;
+	const struct imx686_mode *mode = imx686->cur_mode;
+	struct v4l2_fwnode_device_properties props;
+	s64 hblank, vblank, vblank_min, exposure_max;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+	if (ret)
+		return ret;
+
+	imx686->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &imx686_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(imx686_link_freq_menu) - 1,
+						   mode->link_freq_idx,
+						   imx686_link_freq_menu);
+	if (imx686->link_freq)
+		imx686->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx686->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &imx686_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       mode->pixel_rate,
+					       mode->pixel_rate, 1,
+					       mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	imx686->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &imx686_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank,
+					   1, hblank);
+	if (imx686->hblank)
+		imx686->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	vblank_min = mode->vts_min - mode->height;
+	imx686->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &imx686_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank_min,
+					   IMX686_VTS_MAX - mode->height,
+					   1, vblank);
+
+	exposure_max = mode->vts - IMX686_EXPOSURE_MARGIN;
+	imx686->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &imx686_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX686_EXPOSURE_MIN, exposure_max,
+					     IMX686_EXPOSURE_STEP,
+					     min_t(s64, IMX686_EXPOSURE_DEFAULT,
+						   exposure_max));
+
+	imx686->again = v4l2_ctrl_new_std(ctrl_hdlr, &imx686_ctrl_ops,
+					  V4L2_CID_ANALOGUE_GAIN,
+					  IMX686_AGAIN_MIN, IMX686_AGAIN_MAX,
+					  IMX686_AGAIN_STEP,
+					  IMX686_AGAIN_DEFAULT);
+
+	v4l2_ctrl_cluster(2, &imx686->exposure);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &imx686_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx686_test_pattern_menu) - 1,
+				     0, 0, imx686_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(imx686->dev, &props);
+	if (ret)
+		goto err_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &imx686_ctrl_ops,
+					      &props);
+	if (ret)
+		goto err_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto err_free_hdlr;
+	}
+
+	imx686->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+err_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+	return ret;
+}
+
+static int imx686_detect(struct imx686 *imx686)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(imx686->regmap, IMX686_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(imx686->dev, ret,
+				     "failed to read chip id\n");
+
+	if (val != IMX686_CHIP_ID)
+		return dev_err_probe(imx686->dev, -ENODEV,
+				     "chip id mismatch: expected 0x%04x, got 0x%04llx\n",
+				     IMX686_CHIP_ID, val);
+
+	dev_info(imx686->dev, "detected imx686 chip id 0x%04llx\n", val);
+
+	return 0;
+}
+
+static int imx686_parse_hw_config(struct imx686 *imx686)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx686->dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY,
+	};
+	struct fwnode_handle *ep;
+	unsigned long rate;
+	unsigned int i, j;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	imx686->reset_gpio = devm_gpiod_get_optional(imx686->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx686->reset_gpio))
+		return dev_err_probe(imx686->dev, PTR_ERR(imx686->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	imx686->xvclk = devm_v4l2_sensor_clk_get(imx686->dev, "xvclk");
+	if (IS_ERR(imx686->xvclk))
+		return dev_err_probe(imx686->dev, PTR_ERR(imx686->xvclk),
+				     "failed to get xvclk\n");
+
+	rate = clk_get_rate(imx686->xvclk);
+	if (rate != IMX686_XVCLK_RATE) {
+		clk_set_rate(imx686->xvclk, IMX686_XVCLK_RATE);
+		rate = clk_get_rate(imx686->xvclk);
+		if (rate != IMX686_XVCLK_RATE) {
+			dev_err(imx686->dev, "xvclk rate %lu != %u\n",
+				rate, IMX686_XVCLK_RATE);
+			return -EINVAL;
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(imx686_supply_names); i++)
+		imx686->supplies[i].supply = imx686_supply_names[i];
+
+	ret = devm_regulator_bulk_get(imx686->dev,
+				      ARRAY_SIZE(imx686_supply_names),
+				      imx686->supplies);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(imx686_opt_supply_names); i++) {
+		struct regulator *reg;
+
+		reg = devm_regulator_get_optional(imx686->dev,
+						  imx686_opt_supply_names[i]);
+		if (IS_ERR(reg)) {
+			if (PTR_ERR(reg) == -ENODEV)
+				continue;
+			return PTR_ERR(reg);
+		}
+		imx686->opt_supplies[i] = reg;
+	}
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX686_CPHY_TRIOS) {
+		dev_err(imx686->dev, "unsupported C-PHY trio count %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto out_free_ep;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(imx686->dev, "no link frequencies defined\n");
+		ret = -EINVAL;
+		goto out_free_ep;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(imx686_link_freq_menu); i++) {
+		for (j = 0; j < bus_cfg.nr_of_link_frequencies; j++) {
+			if (bus_cfg.link_frequencies[j] == imx686_link_freq_menu[i])
+				break;
+		}
+		if (j == bus_cfg.nr_of_link_frequencies) {
+			dev_err(imx686->dev, "link frequency %lld missing in DT\n",
+				imx686_link_freq_menu[i]);
+			ret = -EINVAL;
+			goto out_free_ep;
+		}
+	}
+
+out_free_ep:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int imx686_probe(struct i2c_client *client)
+{
+	struct imx686 *imx686;
+	int ret;
+
+	imx686 = devm_kzalloc(&client->dev, sizeof(*imx686), GFP_KERNEL);
+	if (!imx686)
+		return -ENOMEM;
+
+	imx686->dev = &client->dev;
+
+	imx686->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx686->regmap))
+		return dev_err_probe(imx686->dev, PTR_ERR(imx686->regmap),
+				     "failed to init CCI regmap\n");
+
+	v4l2_i2c_subdev_init(&imx686->sd, client, &imx686_subdev_ops);
+	imx686->sd.internal_ops = &imx686_internal_ops;
+
+	ret = imx686_parse_hw_config(imx686);
+	if (ret)
+		return ret;
+
+	ret = imx686_power_on(imx686->dev);
+	if (ret)
+		return dev_err_probe(imx686->dev, ret,
+				     "failed to power on sensor\n");
+
+	ret = imx686_detect(imx686);
+	if (ret)
+		goto err_power_off;
+
+	imx686->cur_mode = &imx686_modes[0];
+
+	ret = imx686_init_controls(imx686);
+	if (ret)
+		goto err_power_off;
+
+	imx686->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx686->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	imx686->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&imx686->sd.entity, 1, &imx686->pad);
+	if (ret)
+		goto err_ctrl_free;
+
+	imx686->sd.state_lock = imx686->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&imx686->sd);
+	if (ret < 0)
+		goto err_entity_cleanup;
+
+	pm_runtime_set_active(imx686->dev);
+	pm_runtime_enable(imx686->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx686->sd);
+	if (ret < 0)
+		goto err_subdev_cleanup;
+
+	pm_runtime_idle(imx686->dev);
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&imx686->sd);
+	pm_runtime_disable(imx686->dev);
+	pm_runtime_set_suspended(imx686->dev);
+err_entity_cleanup:
+	media_entity_cleanup(&imx686->sd.entity);
+err_ctrl_free:
+	v4l2_ctrl_handler_free(imx686->sd.ctrl_handler);
+err_power_off:
+	imx686_power_off(imx686->dev);
+	return ret;
+}
+
+static void imx686_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx686_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct dev_pm_ops imx686_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx686_power_off, imx686_power_on, NULL)
+};
+
+static const struct of_device_id imx686_of_match[] = {
+	{ .compatible = "sony,imx686" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx686_of_match);
+
+static struct i2c_driver imx686_driver = {
+	.probe = imx686_probe,
+	.remove = imx686_remove,
+	.driver = {
+		.name = "imx686",
+		.pm = &imx686_pm_ops,
+		.of_match_table = imx686_of_match,
+	},
+};
+module_i2c_driver(imx686_driver);
+
+MODULE_DESCRIPTION("Sony IMX686 image sensor driver");
+MODULE_LICENSE("GPL");
