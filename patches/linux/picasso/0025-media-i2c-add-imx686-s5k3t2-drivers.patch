+static void s5k3t2_fill_pad_format(const struct s5k3t2_mode *mode,
+				   struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = MEDIA_BUS_FMT_SGBRG10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k3t2_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	s5k3t2_fill_pad_format(&s5k3t2_modes[0],
+			       v4l2_subdev_state_get_format(sd_state, 0));
+	return 0;
+}
+
+static int s5k3t2_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SGBRG10_1X10;
+
+	return 0;
+}
+
+static int s5k3t2_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(s5k3t2_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SGBRG10_1X10)
+		return -EINVAL;
+
+	fse->min_width = s5k3t2_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k3t2_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5k3t2_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		fmt->format = *v4l2_subdev_state_get_format(sd_state, fmt->pad);
+	else
+		s5k3t2_fill_pad_format(s5k3t2->cur_mode, &fmt->format);
+
+	return 0;
+}
+
+static int s5k3t2_update_controls(struct s5k3t2 *s5k3t2,
+				   const struct s5k3t2_mode *mode)
+{
+	s64 hblank, vblank, vblank_min, exposure_max;
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(s5k3t2->link_freq, mode->link_freq_idx);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(s5k3t2->pixel_rate, mode->pixel_rate,
+				       mode->pixel_rate, 1, mode->pixel_rate);
+	if (ret)
+		return ret;
+
+	hblank = mode->hts - mode->width;
+	ret = __v4l2_ctrl_modify_range(s5k3t2->hblank, hblank, hblank, 1, hblank);
+	if (ret)
+		return ret;
+
+	vblank = mode->vts - mode->height;
+	vblank_min = mode->vts_min - mode->height;
+	ret = __v4l2_ctrl_modify_range(s5k3t2->vblank, vblank_min,
+				       S5K3T2_VTS_MAX - mode->height, 1, vblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(s5k3t2->vblank, vblank);
+	if (ret)
+		return ret;
+
+	exposure_max = mode->vts - S5K3T2_EXPOSURE_MARGIN;
+	return __v4l2_ctrl_modify_range(s5k3t2->exposure, S5K3T2_EXPOSURE_MIN,
+					exposure_max, S5K3T2_EXPOSURE_STEP,
+					min_t(s64, S5K3T2_EXPOSURE_DEFAULT,
+					      exposure_max));
+}
+
+static int s5k3t2_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	const struct s5k3t2_mode *mode;
+	int ret = 0;
+
+	mode = v4l2_find_nearest_size(s5k3t2_modes, ARRAY_SIZE(s5k3t2_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+	s5k3t2_fill_pad_format(mode, &fmt->format);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		*v4l2_subdev_state_get_format(sd_state, fmt->pad) = fmt->format;
+	} else {
+		s5k3t2->cur_mode = mode;
+		ret = s5k3t2_update_controls(s5k3t2, mode);
+		if (!ret)
+			*v4l2_subdev_state_get_format(sd_state, 0) = fmt->format;
+	}
+
+	return ret;
+}
+
+static int s5k3t2_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 u32 pad, u64 streams_mask)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	const struct s5k3t2_reg_list *reg_list = &s5k3t2->cur_mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k3t2->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(s5k3t2->regmap, s5k3t2_init_pre_reset_regs,
+				  ARRAY_SIZE(s5k3t2_init_pre_reset_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	usleep_range(3000, 4000);
+
+	ret = cci_multi_reg_write(s5k3t2->regmap, s5k3t2_init_post_reset_regs,
+				  ARRAY_SIZE(s5k3t2_init_post_reset_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(s5k3t2->regmap, reg_list->regs,
+				  reg_list->num_regs, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(s5k3t2->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(s5k3t2->regmap, S5K3T2_REG_MODE_SELECT,
+			S5K3T2_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put(s5k3t2->dev);
+	return ret;
+}
+
+static int s5k3t2_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct s5k3t2 *s5k3t2 = to_s5k3t2(sd);
+	int ret;
+
+	ret = cci_write(s5k3t2->regmap, S5K3T2_REG_MODE_SELECT,
+			S5K3T2_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(s5k3t2->dev, "failed to stop streaming: %d\n", ret);
+
+	usleep_range(30000, 31000);
+	pm_runtime_put(s5k3t2->dev);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops s5k3t2_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k3t2_pad_ops = {
+	.enum_mbus_code = s5k3t2_enum_mbus_code,
+	.enum_frame_size = s5k3t2_enum_frame_size,
+	.get_fmt = s5k3t2_get_pad_format,
+	.set_fmt = s5k3t2_set_pad_format,
+	.enable_streams = s5k3t2_enable_streams,
+	.disable_streams = s5k3t2_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k3t2_subdev_ops = {
+	.video = &s5k3t2_video_ops,
+	.pad = &s5k3t2_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k3t2_internal_ops = {
+	.init_state = s5k3t2_init_state,
+};
+
+static int s5k3t2_init_controls(struct s5k3t2 *s5k3t2)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5k3t2->ctrl_handler;
+	const struct s5k3t2_mode *mode = s5k3t2->cur_mode;
+	struct v4l2_fwnode_device_properties props;
+	s64 hblank, vblank, vblank_min, exposure_max;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+	if (ret)
+		return ret;
+
+	s5k3t2->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &s5k3t2_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(s5k3t2_link_freq_menu) - 1,
+						   mode->link_freq_idx,
+						   s5k3t2_link_freq_menu);
+	if (s5k3t2->link_freq)
+		s5k3t2->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k3t2->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3t2_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       mode->pixel_rate,
+					       mode->pixel_rate, 1,
+					       mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	s5k3t2->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3t2_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank,
+					   1, hblank);
+	if (s5k3t2->hblank)
+		s5k3t2->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	vblank_min = mode->vts_min - mode->height;
+	s5k3t2->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3t2_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank_min,
+					   S5K3T2_VTS_MAX - mode->height,
+					   1, vblank);
+
+	exposure_max = mode->vts - S5K3T2_EXPOSURE_MARGIN;
+	s5k3t2->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3t2_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K3T2_EXPOSURE_MIN, exposure_max,
+					     S5K3T2_EXPOSURE_STEP,
+					     min_t(s64, S5K3T2_EXPOSURE_DEFAULT,
+						   exposure_max));
+
+	s5k3t2->again = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3t2_ctrl_ops,
+					  V4L2_CID_ANALOGUE_GAIN,
+					  S5K3T2_AGAIN_MIN, S5K3T2_AGAIN_MAX,
+					  S5K3T2_AGAIN_STEP,
+					  S5K3T2_AGAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &s5k3t2_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k3t2_test_pattern_menu) - 1,
+				     0, 0, s5k3t2_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(s5k3t2->dev, &props);
+	if (ret)
+		goto err_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &s5k3t2_ctrl_ops,
+					      &props);
+	if (ret)
+		goto err_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto err_free_hdlr;
+	}
+
+	s5k3t2->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+err_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+	return ret;
+}
+
+static int s5k3t2_detect(struct s5k3t2 *s5k3t2)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(s5k3t2->regmap, S5K3T2_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(s5k3t2->dev, ret,
+				     "failed to read chip id\n");
+
+	if (val != S5K3T2_CHIP_ID)
+		return dev_err_probe(s5k3t2->dev, -ENODEV,
+				     "chip id mismatch: expected 0x%04x, got 0x%04llx\n",
+				     S5K3T2_CHIP_ID, val);
+
+	dev_info(s5k3t2->dev, "detected s5k3t2 chip id 0x%04llx\n", val);
+
+	return 0;
+}
+
+static int s5k3t2_parse_hw_config(struct s5k3t2 *s5k3t2)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k3t2->dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *ep;
+	unsigned long rate;
+	unsigned int i, j;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	s5k3t2->reset_gpio = devm_gpiod_get_optional(s5k3t2->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3t2->reset_gpio))
+		return dev_err_probe(s5k3t2->dev, PTR_ERR(s5k3t2->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	s5k3t2->xvclk = devm_v4l2_sensor_clk_get(s5k3t2->dev, "xvclk");
+	if (IS_ERR(s5k3t2->xvclk))
+		return dev_err_probe(s5k3t2->dev, PTR_ERR(s5k3t2->xvclk),
+				     "failed to get xvclk\n");
+
+	rate = clk_get_rate(s5k3t2->xvclk);
+	if (rate != S5K3T2_XVCLK_RATE) {
+		clk_set_rate(s5k3t2->xvclk, S5K3T2_XVCLK_RATE);
+		rate = clk_get_rate(s5k3t2->xvclk);
+		if (rate != S5K3T2_XVCLK_RATE) {
+			dev_err(s5k3t2->dev, "xvclk rate %lu != %u\n",
+				rate, S5K3T2_XVCLK_RATE);
+			return -EINVAL;
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(s5k3t2_supply_names); i++)
+		s5k3t2->supplies[i].supply = s5k3t2_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k3t2->dev,
+				      ARRAY_SIZE(s5k3t2_supply_names),
+				      s5k3t2->supplies);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(s5k3t2_opt_supply_names); i++) {
+		struct regulator *reg;
+
+		reg = devm_regulator_get_optional(s5k3t2->dev,
+						  s5k3t2_opt_supply_names[i]);
+		if (IS_ERR(reg)) {
+			if (PTR_ERR(reg) == -ENODEV)
+				continue;
+			return PTR_ERR(reg);
+		}
+		s5k3t2->opt_supplies[i] = reg;
+	}
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K3T2_DATA_LANES) {
+		dev_err(s5k3t2->dev, "unsupported lane count %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto out_free_ep;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(s5k3t2->dev, "no link frequencies defined\n");
+		ret = -EINVAL;
+		goto out_free_ep;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(s5k3t2_link_freq_menu); i++) {
+		for (j = 0; j < bus_cfg.nr_of_link_frequencies; j++) {
+			if (bus_cfg.link_frequencies[j] == s5k3t2_link_freq_menu[i])
+				break;
+		}
+		if (j == bus_cfg.nr_of_link_frequencies) {
+			dev_err(s5k3t2->dev, "link frequency %lld missing in DT\n",
+				s5k3t2_link_freq_menu[i]);
+			ret = -EINVAL;
+			goto out_free_ep;
+		}
+	}
+
+out_free_ep:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int s5k3t2_probe(struct i2c_client *client)
+{
+	struct s5k3t2 *s5k3t2;
+	int ret;
+
+	s5k3t2 = devm_kzalloc(&client->dev, sizeof(*s5k3t2), GFP_KERNEL);
+	if (!s5k3t2)
+		return -ENOMEM;
+
+	s5k3t2->dev = &client->dev;
+
+	s5k3t2->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k3t2->regmap))
+		return dev_err_probe(s5k3t2->dev, PTR_ERR(s5k3t2->regmap),
+				     "failed to init CCI regmap\n");
+
+	v4l2_i2c_subdev_init(&s5k3t2->sd, client, &s5k3t2_subdev_ops);
+	s5k3t2->sd.internal_ops = &s5k3t2_internal_ops;
+
+	ret = s5k3t2_parse_hw_config(s5k3t2);
+	if (ret)
+		return ret;
+
+	ret = s5k3t2_power_on(s5k3t2->dev);
+	if (ret)
+		return dev_err_probe(s5k3t2->dev, ret,
+				     "failed to power on sensor\n");
+
+	ret = s5k3t2_detect(s5k3t2);
+	if (ret)
+		goto err_power_off;
+
+	s5k3t2->cur_mode = &s5k3t2_modes[0];
+
+	ret = s5k3t2_init_controls(s5k3t2);
+	if (ret)
+		goto err_power_off;
+
+	s5k3t2->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k3t2->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	s5k3t2->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&s5k3t2->sd.entity, 1, &s5k3t2->pad);
+	if (ret)
+		goto err_ctrl_free;
+
+	s5k3t2->sd.state_lock = s5k3t2->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&s5k3t2->sd);
+	if (ret < 0)
+		goto err_entity_cleanup;
+
+	pm_runtime_set_active(s5k3t2->dev);
+	pm_runtime_enable(s5k3t2->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k3t2->sd);
+	if (ret < 0)
+		goto err_subdev_cleanup;
+
+	pm_runtime_idle(s5k3t2->dev);
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k3t2->sd);
+	pm_runtime_disable(s5k3t2->dev);
+	pm_runtime_set_suspended(s5k3t2->dev);
+err_entity_cleanup:
+	media_entity_cleanup(&s5k3t2->sd.entity);
+err_ctrl_free:
+	v4l2_ctrl_handler_free(s5k3t2->sd.ctrl_handler);
+err_power_off:
+	s5k3t2_power_off(s5k3t2->dev);
+	return ret;
+}
+
+static void s5k3t2_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		s5k3t2_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct dev_pm_ops s5k3t2_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k3t2_power_off, s5k3t2_power_on, NULL)
+};
+
+static const struct of_device_id s5k3t2_of_match[] = {
+	{ .compatible = "samsung,s5k3t2" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5k3t2_of_match);
+
+static struct i2c_driver s5k3t2_driver = {
+	.probe = s5k3t2_probe,
+	.remove = s5k3t2_remove,
+	.driver = {
+		.name = "s5k3t2",
+		.pm = &s5k3t2_pm_ops,
+		.of_match_table = s5k3t2_of_match,
+	},
+};
+module_i2c_driver(s5k3t2_driver);
+
+MODULE_DESCRIPTION("Samsung S5K3T2 image sensor driver");
+MODULE_LICENSE("GPL");
