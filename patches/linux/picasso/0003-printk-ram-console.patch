  * Just do some early initializations, and do the complex setup
  * later.
  */
+/*
+ * Bring-up aid: mirror the console into a fixed 1 MiB RAM window
+ * (0xF3F00000, reserved by the board DTS) so that the log survives the reset
+ * that follows a hang. The loader reads it back with "oem ramoops".
+ */
+#define RAMLOG_PHYS	0xF3F00000UL
+#define RAMLOG_DATA	0x1000U
+#define RAMLOG_SIZE	0x100000U
+#define RAMLOG_MAGIC	0x474F4C52U	/* "RLOG" */
+
+struct ramlog_hdr {
+	u32 magic;
+	u32 pos;
+	u32 total;
+	u32 reserved;
+};
+
+static void
+ramlog_write(struct console *co, const char *s, unsigned int count)
+{
+	struct ramlog_hdr *h = (struct ramlog_hdr *)__va(RAMLOG_PHYS);
+	char *data = (char *)h + RAMLOG_DATA;
+	unsigned int room = RAMLOG_SIZE - RAMLOG_DATA;
+	unsigned int pos = h->pos;
+
+	if (h->magic != RAMLOG_MAGIC) {
+		h->magic = RAMLOG_MAGIC;
+		h->total = 0;
+		h->reserved = 0;
+		pos = 0;
+	}
+	if (pos >= room)
+		pos = 0;
+	while (count) {
+		unsigned int n = min(count, room - pos);
+
+		memcpy(data + pos, s, n);
+		pos = (pos + n) % room;
+		s += n;
+		count -= n;
+		h->total += n;
+	}
+	h->pos = pos;
+}
+
+static struct console ramlog_console = {
+	.name = "ramlog",
+	.write = ramlog_write,
+	.flags = CON_PRINTBUFFER,
+	.index = -1,
+};
+
 void __init console_init(void)
 {
 	int ret;
 	initcall_t call;
 	initcall_entry_t *ce;
 
+	/* keep a copy of the console log in RAM, including the lines printed so far */
+	register_console(&ramlog_console);
+	{
+		/* marker: proves that a write here survives to the next boot */
+		struct ramlog_hdr *h = (struct ramlog_hdr *)__va(RAMLOG_PHYS);
+
+		h->magic = RAMLOG_MAGIC;
+		h->pos = 0;
+		h->total = 0;
+		h->reserved = 0x12345678;
+	}
+
 #ifdef CONFIG_NULL_TTY_DEFAULT_CONSOLE
 	if (!console_set_on_cmdline)
 		add_preferred_console("ttynull", 0, NULL);
@@ -5186,3 +5265,19 @@ void __printk_cpu_sync_put(void)
 }
 EXPORT_SYMBOL(__printk_cpu_sync_put);
 #endif /* CONFIG_SMP */
+
+/* temporary bring-up probe: is the WEST TLMM window (pin 38 area) readable? */
+static int __init tlmm_probe_addr(void)
+{
+	void __iomem *w;
+	unsigned int v = 0;
+
+	w = ioremap(0x0f926000UL, 0x1000);
+	if (w)
+		v = readl(w);
+	pr_info("tlmm probe: east 0xf926000 = 0x%08x (%s)\n", v, w ? "mapped" : "no ioremap");
+	if (w)
+		iounmap(w);
+	return 0;
+}
+device_initcall(tlmm_probe_addr);
