diff --git a/drivers/power/supply/qcom_pm7250b_charger.c b/drivers/power/supply/qcom_pm7250b_charger.c
index 480aa56f9..f5de6c6d0 100644
--- a/drivers/power/supply/qcom_pm7250b_charger.c
+++ b/drivers/power/supply/qcom_pm7250b_charger.c
@@ -54,6 +54,13 @@
 #define USBIN_INT_RT_STS		0x310
 #define  USBIN_PLUGIN_RT_STS_BIT	BIT(4)
 
+/* QG (Qgauge) peripheral on the same SPMI slave (0x4800) */
+#define QG_S7_PON_OCV_V_DATA0_REG	0x4870
+#define QG_S2_NORMAL_AVG_V_DATA0_REG	0x4880
+#define QG_S2_NORMAL_AVG_I_DATA0_REG	0x4882
+#define QG_LAST_ADC_V_DATA0_REG		0x48c0
+#define QG_LAST_ADC_I_DATA0_REG		0x48c2
+
 #define CHG_LIMIT_POLL_MS		20000
 #define CHG_LIMIT_AUTO_HYST		5	/* resume this far below the end threshold */
 
@@ -61,6 +68,7 @@ struct pm7250b_chg {
 	struct device *dev;
 	struct regmap *regmap;
 	struct power_supply *psy;
+	struct power_supply *bat_psy;
 	struct power_supply *gauge;	/* optional, for the charge limit */
 	struct delayed_work limit_work;
 	struct mutex lock;	/* protects the fields below and the enable bit */
@@ -372,6 +380,184 @@ static const struct power_supply_desc pm7250b_chg_desc = {
 	.property_is_writeable = pm7250b_chg_writeable,
 };
 
+static int pm7250b_qg_read_u16(struct pm7250b_chg *chg, unsigned int reg,
+			       u16 *val)
+{
+	__le16 raw;
+	int ret;
+
+	ret = regmap_bulk_read(chg->regmap, reg, &raw, sizeof(raw));
+	if (ret)
+		return ret;
+
+	*val = le16_to_cpu(raw);
+	return 0;
+}
+
+static int pm7250b_bat_read_uv(struct pm7250b_chg *chg, unsigned int reg,
+			       int *uv)
+{
+	u16 raw;
+	int ret;
+
+	ret = pm7250b_qg_read_u16(chg, reg, &raw);
+	if (ret)
+		return ret;
+	if (!raw || raw == 0x8000 || raw == 0xffff)
+		return -ENODATA;
+
+	*uv = div_u64(194637ULL * raw, 1000);
+	return 0;
+}
+
+static int pm7250b_bat_current_ua(struct pm7250b_chg *chg, int *ua)
+{
+	u16 raw;
+	int ret;
+
+	ret = pm7250b_qg_read_u16(chg, QG_S2_NORMAL_AVG_I_DATA0_REG, &raw);
+	if (!ret && raw != 0x8000 && raw != 0xffff) {
+		*ua = div_s64((s64)(s16)raw * 152588LL, 1000);
+		return 0;
+	}
+
+	ret = pm7250b_qg_read_u16(chg, QG_LAST_ADC_I_DATA0_REG, &raw);
+	if (ret)
+		return ret;
+	if (raw == 0x8000 || raw == 0xffff)
+		return -ENODATA;
+
+	*ua = div_s64((s64)(s16)raw * 152588LL, 1000);
+	return 0;
+}
+
+static int pm7250b_bat_vbat_uv(struct pm7250b_chg *chg, int *uv)
+{
+	if (!pm7250b_bat_read_uv(chg, QG_S2_NORMAL_AVG_V_DATA0_REG, uv))
+		return 0;
+	if (!pm7250b_bat_read_uv(chg, QG_LAST_ADC_V_DATA0_REG, uv))
+		return 0;
+	return pm7250b_bat_read_uv(chg, QG_S7_PON_OCV_V_DATA0_REG, uv);
+}
+
+static int pm7250b_bat_capacity(int uv, int status)
+{
+	static const struct {
+		int mv;
+		int pct;
+	} curve[] = {
+		{ 4400, 100 },
+		{ 4200,  85 },
+		{ 4000,  65 },
+		{ 3850,  45 },
+		{ 3750,  25 },
+		{ 3650,  10 },
+		{ 3400,   0 },
+	};
+	int mv = uv / 1000;
+	int i;
+
+	if (status == POWER_SUPPLY_STATUS_FULL || mv >= curve[0].mv)
+		return 100;
+	if (mv <= curve[ARRAY_SIZE(curve) - 1].mv)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(curve) - 1; i++) {
+		if (mv >= curve[i + 1].mv) {
+			int dv = curve[i].mv - curve[i + 1].mv;
+			int dp = curve[i].pct - curve[i + 1].pct;
+
+			return curve[i + 1].pct +
+			       ((mv - curve[i + 1].mv) * dp) / dv;
+		}
+	}
+
+	return 0;
+}
+
+static int pm7250b_bat_get_property(struct power_supply *psy,
+				    enum power_supply_property psp,
+				    union power_supply_propval *val)
+{
+	struct pm7250b_chg *chg = power_supply_get_drvdata(psy);
+	int ret, uv, status;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_HEALTH:
+		val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = 4450000;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = 3400000;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		val->intval = 4500000;
+		return 0;
+	case POWER_SUPPLY_PROP_STATUS:
+		return pm7250b_chg_status(chg, &val->intval);
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		return pm7250b_bat_vbat_uv(chg, &val->intval);
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		return pm7250b_bat_read_uv(chg, QG_S7_PON_OCV_V_DATA0_REG,
+					   &val->intval);
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		return pm7250b_bat_current_ua(chg, &val->intval);
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = pm7250b_chg_status(chg, &status);
+		if (ret)
+			return ret;
+		ret = pm7250b_bat_vbat_uv(chg, &uv);
+		if (ret)
+			return ret;
+		val->intval = pm7250b_bat_capacity(uv, status);
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		ret = pm7250b_chg_status(chg, &status);
+		if (ret)
+			return ret;
+		ret = pm7250b_bat_vbat_uv(chg, &uv);
+		if (ret)
+			return ret;
+		val->intval = pm7250b_bat_capacity(uv, status) * 45000;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const enum power_supply_property pm7250b_bat_props[] = {
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+};
+
+static const struct power_supply_desc pm7250b_bat_desc = {
+	.name = "pm7250b-battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = pm7250b_bat_props,
+	.num_properties = ARRAY_SIZE(pm7250b_bat_props),
+	.get_property = pm7250b_bat_get_property,
+};
+
 static int pm7250b_chg_probe(struct platform_device *pdev)
 {
 	struct power_supply_config cfg = {};
@@ -438,6 +624,11 @@ static int pm7250b_chg_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, PTR_ERR(chg->psy),
 				     "failed to register power supply\n");
 
+	chg->bat_psy = devm_power_supply_register(dev, &pm7250b_bat_desc, &cfg);
+	if (IS_ERR(chg->bat_psy))
+		dev_warn(dev, "failed to register battery supply: %pe\n",
+			 chg->bat_psy);
+
 	if (chg->gauge)
 		schedule_delayed_work(&chg->limit_work,
 				      msecs_to_jiffies(CHG_LIMIT_POLL_MS));
