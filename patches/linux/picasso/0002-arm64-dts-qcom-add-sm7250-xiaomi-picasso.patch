--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm7250-xiaomi-picasso.dts
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi Redmi K30 5G (picasso), Qualcomm SM7250.
+ *
+ * Milestone 1: mainline arm64 Image started as an EFI application by the
+ * Mu-Silicium UEFI boot chain, EFI GOP simpledrm console, initramfs.
+ * Later milestones add USB, UFS, display, touch and Wi-Fi; see
+ * docs/mainline-linux-plan.md and docs/dts-crosswalk.md.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+
+/* PM7250B is configured to use SID2/3 */
+#define PM7250B_SID 2
+#define PM7250B_SID1 3
+
+#include "sm7250.dtsi"
+#include "pm8150.dtsi"
+#include "pm8150l.dtsi"
+#include "pm7250b.dtsi"
+
+/ {
+	model = "Xiaomi Redmi K30 5G";
+	compatible = "xiaomi,picasso", "qcom,sm7250";
+	chassis-type = "handset";
+
+	chosen {
+		/*
+		 * The launcher may override this through EFI LoadOptions.
+		 * ttyMSM0 never binds on this platform; tty0 (simpledrm) and
+		 * the USB console are the useful outputs.
+		 */
+		bootargs = "console=tty0 loglevel=8 ignore_loglevel printk.time=1 panic=10 clk_ignore_unused pd_ignore_unused regulator_ignore_unused";
+	};
+
+	/*
+	 * Only the two low banks are listed: memory above 4 GiB is described by
+	 * the UEFI memory map on this boot path, and the downstream DT leaves
+	 * the top bank for the bootloader to trim (6 GiB devices end below
+	 * 0x180000000). Declaring RAM that does not exist is worse than
+	 * declaring less.
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x3cc00000>,
+		      <0x0 0xc0000000 0x0 0x40000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		hyp_mem: hyp@80000000 {
+			reg = <0x0 0x80000000 0x0 0x600000>;
+			no-map;
+		};
+
+		xbl_aop_mem: xbl-aop@80600000 {
+			reg = <0x0 0x80600000 0x0 0x260000>;
+			no-map;
+		};
+
+		cmd_db: cmd-db@80860000 {
+			compatible = "qcom,cmd-db";
+			reg = <0x0 0x80860000 0x0 0x20000>;
+			no-map;
+		};
+
+		xbl_uefi_mem: xbl-uefi@80880000 {
+			reg = <0x0 0x80880000 0x0 0x14000>;
+			no-map;
+		};
+
+		smem_mem: smem@80900000 {
+			compatible = "qcom,smem";
+			reg = <0x0 0x80900000 0x0 0x200000>;
+			no-map;
+			hwlocks = <&tcsr_mutex 3>;
+		};
+
+		sec_apps_mem: sec-apps@808ff000 {
+			reg = <0x0 0x808ff000 0x0 0x1000>;
+			no-map;
+		};
+
+		removed_mem: removed@80b00000 {
+			reg = <0x0 0x80b00000 0x0 0x1300000>;
+			no-map;
+		};
+
+		qtee_apps_mem: qtee-apps@81e00000 {
+			reg = <0x0 0x81e00000 0x0 0x4200000>;
+			no-map;
+		};
+
+		camera_mem: camera@86000000 {
+			reg = <0x0 0x86000000 0x0 0x500000>;
+			no-map;
+		};
+
+		npu_mem: npu@86500000 {
+			reg = <0x0 0x86500000 0x0 0x500000>;
+			no-map;
+		};
+
+		video_mem: video@86a00000 {
+			reg = <0x0 0x86a00000 0x0 0x500000>;
+			no-map;
+		};
+
+		cdsp_mem: cdsp@87400000 {
+			reg = <0x0 0x87400000 0x0 0x1e00000>;
+			no-map;
+		};
+
+		adsp_mem: adsp@89200000 {
+			reg = <0x0 0x89200000 0x0 0x2800000>;
+			no-map;
+		};
+
+		wlan_fw_mem: wlan-fw@8ba00000 {
+			reg = <0x0 0x8ba00000 0x0 0x200000>;
+			no-map;
+		};
+
+		ipa_fw_mem: ipa-fw@8bc00000 {
+			reg = <0x0 0x8bc00000 0x0 0x10000>;
+			no-map;
+		};
+
+		ipa_gsi_mem: ipa-gsi@8bc10000 {
+			reg = <0x0 0x8bc10000 0x0 0x5400>;
+			no-map;
+		};
+
+		/*
+		 * Downstream reserves 0x8bc15400..0x8bc17400 for the GPU zap
+		 * shader; TrustZone only accepts a 4 KiB aligned load address,
+		 * so the unaligned head is a separate region.
+		 */
+		gpu_pad_mem: gpu-pad@8bc15400 {
+			reg = <0x0 0x8bc15400 0x0 0xc00>;
+			no-map;
+		};
+
+		gpu_mem: gpu@8bc16000 {
+			reg = <0x0 0x8bc16000 0x0 0x1400>;
+			no-map;
+		};
+
+		reserved_pil_mem: reserved-pil@8bc17400 {
+			reg = <0x0 0x8bc17400 0x0 0x3e8c00>;
+			no-map;
+		};
+
+		modem_wlan_mem: modem-wlan@8c000000 {
+			reg = <0x0 0x8c000000 0x0 0xf800000>;
+			no-map;
+		};
+
+		cdsp_sec_mem: cdsp-sec@9f400000 {
+			reg = <0x0 0x9f400000 0x0 0xc00000>;
+			no-map;
+		};
+
+		cont_splash_mem: cont-splash@a0000000 {
+			reg = <0x0 0xa0000000 0x0 0x2300000>;
+			iommu-addresses = <&mdss 0x0 0xa0000000 0x0 0x2300000>;
+			no-map;
+		};
+
+		dfps_data_mem: dfps-data@a2300000 {
+			reg = <0x0 0xa2300000 0x0 0x100000>;
+			no-map;
+		};
+	};
+};
