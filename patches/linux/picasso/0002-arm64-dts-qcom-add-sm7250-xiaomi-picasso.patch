+/*
+ * Secondary MI2S to the TFA9874: downstream feeds the amplifier from data
+ * line 1 (gpio74, sec_i2s_data1_active with output-high) and reads its sense
+ * output on line 0 (gpio72, input-enable), same wiring as avicii.
+ */
+&q6afedai {
+	dai@21 {
+		reg = <SECONDARY_MI2S_RX>;
+		/* qcom,sd-lines is the list of data-line *indices*, not a count
+		 * (q6afe-dai.c builds sd_line_mask as BIT(entries)); <2> selected
+		 * SD2 and left the amp's line (SD1, gpio74) undriven, which is
+		 * why the card played but nothing came out. Line 0 (gpio72) is
+		 * the amp's sense output, not an audio line. */
+		qcom,sd-lines = <0 1>;
+	};
+};
+
+/* q6asm-dai needs one child per frontend; Q6ASM_DAI_RX removes the capture
+ * stream, Q6ASM_DAI_TX removes playback (q6asm-dai.c).  dai@1 (MultiMedia2)
+ * is the capture frontend. */
+&q6asmdai {
+	dai@0 { reg = <0x0>; direction = <Q6ASM_DAI_RX>; };
+	dai@1 { reg = <0x1>; direction = <Q6ASM_DAI_TX>; };
+	dai@2 { reg = <0x2>; direction = <Q6ASM_DAI_RX>; };
+	dai@3 { reg = <0x3>; direction = <Q6ASM_DAI_RX>; };
+};
