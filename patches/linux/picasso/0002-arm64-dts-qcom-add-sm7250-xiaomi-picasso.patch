index 000000000..3fbc7b028
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm7250-xiaomi-picasso.dts
@@ -0,0 +1,734 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi Redmi K30 5G (picasso), Qualcomm SM7250.
+ *
+ * Milestone 1: mainline arm64 Image started as an EFI application by the
+ * Mu-Silicium UEFI boot chain, EFI GOP simpledrm console, initramfs.
+ * Later milestones add USB, UFS, display, touch and Wi-Fi; see
+ * docs/mainline-linux-plan.md and docs/dts-crosswalk.md.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+
+/* PM7250B is configured to use SID2/3 */
+#define PM7250B_SID 2
+#define PM7250B_SID1 3
+
+#include "sm7250.dtsi"
+#include "pm8150.dtsi"
+#include "pm8150l.dtsi"
+#include "pm7250b.dtsi"
+
+/ {
+	model = "Xiaomi Redmi K30 5G";
+	compatible = "xiaomi,picasso", "qcom,sm7250";
+	chassis-type = "handset";
+
+	chosen {
+		/*
+		 * The launcher may override this through EFI LoadOptions.
+		 * ttyMSM0 never binds on this platform; tty0 (simpledrm) and
+		 * the USB console are the useful outputs.
+		 */
+		bootargs = "console=tty0 loglevel=8 ignore_loglevel initcall_debug printk.time=1 panic=0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused";
+	};
+
+	/*
+	 * Only the two low banks are listed: memory above 4 GiB is described by
+	 * the UEFI memory map on this boot path, and the downstream DT leaves
+	 * the top bank for the bootloader to trim (6 GiB devices end below
+	 * 0x180000000). Declaring RAM that does not exist is worse than
+	 * declaring less.
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x3cc00000>,
+		      <0x0 0xc0000000 0x0 0x40000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		hyp_mem: hyp@80000000 {
+			reg = <0x0 0x80000000 0x0 0x600000>;
+			no-map;
+		};
+
+		xbl_aop_mem: xbl-aop@80600000 {
+			reg = <0x0 0x80600000 0x0 0x260000>;
+			no-map;
+		};
+
+		cmd_db: cmd-db@80860000 {
+			compatible = "qcom,cmd-db";
+			reg = <0x0 0x80860000 0x0 0x20000>;
+			no-map;
+		};
+
+		xbl_uefi_mem: xbl-uefi@80880000 {
+			reg = <0x0 0x80880000 0x0 0x14000>;
+			no-map;
+		};
+
+		smem_mem: smem@80900000 {
+			compatible = "qcom,smem";
+			reg = <0x0 0x80900000 0x0 0x200000>;
+			no-map;
+			hwlocks = <&tcsr_mutex 3>;
+		};
+
+		sec_apps_mem: sec-apps@808ff000 {
+			reg = <0x0 0x808ff000 0x0 0x1000>;
+			no-map;
+		};
+
+		removed_mem: removed@80b00000 {
+			reg = <0x0 0x80b00000 0x0 0x1300000>;
+			no-map;
+		};
+
+		qtee_apps_mem: qtee-apps@81e00000 {
+			reg = <0x0 0x81e00000 0x0 0x4200000>;
+			no-map;
+		};
+
+		camera_mem: camera@86000000 {
+			reg = <0x0 0x86000000 0x0 0x500000>;
+			no-map;
+		};
+
+		npu_mem: npu@86500000 {
+			reg = <0x0 0x86500000 0x0 0x500000>;
+			no-map;
+		};
+
+		video_mem: video@86a00000 {
+			reg = <0x0 0x86a00000 0x0 0x500000>;
+			no-map;
+		};
+
+		cdsp_mem: cdsp@87400000 {
+			reg = <0x0 0x87400000 0x0 0x1e00000>;
+			no-map;
+		};
+
+		adsp_mem: adsp@89200000 {
+			reg = <0x0 0x89200000 0x0 0x2800000>;
+			no-map;
+		};
+
+		/*
+		 * rmtfs: the modem's EFS buffer, served from userspace by
+		 * rmtfs through /dev/qcom_rmtfs_mem1.
+		 */
+		rmtfs_mem: rmtfs {
+			compatible = "qcom,rmtfs-mem";
+			size = <0x0 0x280000>;
+			alloc-ranges = <0x0 0xa4000000 0x0 0x10000000>;
+			alignment = <0x0 0x400000>;
+			no-map;
+
+			qcom,client-id = <1>;
+			qcom,vmid = <15>;
+		};
+
+		wlan_fw_mem: wlan-fw@8ba00000 {
+			reg = <0x0 0x8ba00000 0x0 0x200000>;
+			no-map;
+		};
+
+		ipa_fw_mem: ipa-fw@8bc00000 {
+			reg = <0x0 0x8bc00000 0x0 0x10000>;
+			no-map;
+		};
+
+		ipa_gsi_mem: ipa-gsi@8bc10000 {
+			reg = <0x0 0x8bc10000 0x0 0x5400>;
+			no-map;
+		};
+
+		/*
+		 * Downstream reserves 0x8bc15400..0x8bc17400 for the GPU zap
+		 * shader; TrustZone only accepts a 4 KiB aligned load address,
+		 * so the unaligned head is a separate region.
+		 */
+		gpu_pad_mem: gpu-pad@8bc15400 {
+			reg = <0x0 0x8bc15400 0x0 0xc00>;
+			no-map;
+		};
+
+		gpu_mem: gpu@8bc16000 {
+			reg = <0x0 0x8bc16000 0x0 0x1400>;
+			no-map;
+		};
+
+		reserved_pil_mem: reserved-pil@8bc17400 {
+			reg = <0x0 0x8bc17400 0x0 0x3e8c00>;
+			no-map;
+		};
+
+		modem_wlan_mem: modem-wlan@8c000000 {
+			reg = <0x0 0x8c000000 0x0 0xf800000>;
+			no-map;
+		};
+
+		cdsp_sec_mem: cdsp-sec@9f400000 {
+			reg = <0x0 0x9f400000 0x0 0xc00000>;
+			no-map;
+		};
+
+		cont_splash_mem: cont-splash@a0000000 {
+			reg = <0x0 0xa0000000 0x0 0x2300000>;
+			iommu-addresses = <&mdss 0x0 0xa0000000 0x0 0x2300000>;
+			no-map;
+		};
+
+		dfps_data_mem: dfps-data@a2300000 {
+			reg = <0x0 0xa2300000 0x0 0x100000>;
+			no-map;
+		};
+
+		/*
+		 * The XNUP payload window used by the Mu-Silicium chain: linux.efi,
+		 * the kernel Image, the ramdisk and this DTB live here. Reserved
+		 * but not no-map, so the kernel never hands it out yet can read
+		 * the ramdisk at the address in /chosen/linux,initrd-start.
+		 */
+		/*
+		 * The last MiB of the payload window is the RAM console: the
+		 * kernel mirrors printk there and the loader reads it with
+		 * "oem ramoops" after a reset (kernel/printk/printk.c).
+		 */
+		linux_payload_mem: linux-payload@f0000000 {
+			reg = <0x0 0xf0000000 0x0 0x3f00000>;
+		};
+
+		/* console mirror written by the kernel (kernel/printk/printk.c) */
+		ramlog_mem: ramlog@f3f00000 {
+			reg = <0x0 0xf3f00000 0x0 0x100000>;
+		};
+	};
+};
+
+
+/*
+ * Only the south tile answers on this board: reads of the west (0xf500000)
+ * and east (0xf900000) tiles never return and hang the accessing worker, so
+ * they are left out of the mapping (the driver skips unmapped tiles).
+ * South holds the touch reset/IRQ (gpio4/5), the panel TE (gpio10) and the
+ * UFS reset pin.
+ */
+/*
+ * PM8150 rails used by the USB PHY. The bootloader leaves all of them on;
+ * Linux is the only RPMh voter on this boot, so they stay always-on until the
+ * consumers are known to be safe.
+ */
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8150-rpmh-regulators";
+		qcom,pmic-id = "a";
+
+		vreg_s4a_1p8: smps4 {
+			regulator-name = "vreg_s4a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		vreg_l2a_3p1: ldo2 {
+			regulator-name = "vreg_l2a_3p1";
+			regulator-min-microvolt = <3072000>;
+			regulator-max-microvolt = <3072000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		vreg_l5a_0p88: ldo5 {
+			regulator-name = "vreg_l5a_0p88";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <880000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		vreg_l12a_1p8: ldo12 {
+			regulator-name = "vreg_l12a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		/* WLAN cx-mx: downstream icnss asks 0.752 V */
+		vreg_l1a_0p75: ldo1 {
+			regulator-name = "vreg_l1a_0p75";
+			regulator-min-microvolt = <752000>;
+			regulator-max-microvolt = <752000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		/* WLAN xo: downstream icnss asks 1.8 V */
+		vreg_l14a_1p8: ldo14 {
+			regulator-name = "vreg_l14a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		/* UFS PHY PLL (downstream ldoa9 1.16 - 1.32 V) */
+		vreg_l9a_1p2: ldo9 {
+			regulator-name = "vreg_l9a_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+	};
+
+	/* PM8150L: UFS vcc (downstream ldoc7, 2.704 - 3.304 V; UFS asks 2.95) */
+	regulators-1 {
+		compatible = "qcom,pm8150l-rpmh-regulators";
+		qcom,pmic-id = "c";
+
+		/* panel I/O (downstream ldoc1, 1.8 V) */
+		vreg_l1c_1p8: ldo1 {
+			regulator-name = "vreg_l1c_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		/* WLAN rfa: downstream icnss asks 1.304 V */
+		vreg_l2c_1p3: ldo2 {
+			regulator-name = "vreg_l2c_1p3";
+			regulator-min-microvolt = <1304000>;
+			regulator-max-microvolt = <1304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/* WLAN ch0/ch1: downstream icnss asks 3.312 V */
+		vreg_l10c_3p3: ldo10 {
+			regulator-name = "vreg_l10c_3p3";
+			regulator-min-microvolt = <3312000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l11c_3p3: ldo11 {
+			regulator-name = "vreg_l11c_3p3";
+			regulator-min-microvolt = <3312000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l7c_2p95: ldo7 {
+			regulator-name = "vreg_l7c_2p95";
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <2960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+	};
+};
+
+/* UFS 2.1: root filesystem (read-only first) and the firmware partition. */
+&ufs_mem_hc {
+	vcc-supply = <&vreg_l7c_2p95>;
+	vcc-max-microamp = <800000>;
+	vccq2-supply = <&vreg_s4a_1p8>;
+	vccq2-max-microamp = <800000>;
+
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&vreg_l5a_0p88>;
+	vdda-pll-supply = <&vreg_l9a_1p2>;
+
+	status = "okay";
+};
+
+/* USB 2.0 gadget: the console and the file channel during bring-up. */
+&usb_1 {
+	status = "okay";
+};
+
+&usb_1_dwc3 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+};
+
+&usb_1_hsphy {
+	vdda-pll-supply = <&vreg_l5a_0p88>;
+	vdda18-supply = <&vreg_l12a_1p8>;
+	vdda33-supply = <&vreg_l2a_3p1>;
+
+	status = "okay";
+};
+
+/* Panel tearing-effect line (downstream sde_te_active, TLMM gpio10) */
+&tlmm {
+	reg = <0x0 0x0f100000 0x0 0x300000>;
+	reg-names = "south";
+};
+
+&tlmm {
+	mdp_vsync_te_active: mdp-vsync-te-active-state {
+		pins = "gpio10";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_mdp {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l9a_1p2>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "xiaomi,g7a-37-02-0a";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l1c_1p8>;
+		reset-gpios = <&pm8150l_gpios 3 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&mdp_vsync_te_active>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+	qcom,te-source = "mdp_vsync_p";
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p88>;
+
+	status = "okay";
+};
+
+/*
+ * Wi-Fi: WCN3990 behind the modem's wlan_pd. The firmware comes from the
+ * phone's own partitions, mounted by init under /lib/firmware:
+ *   qcom/sm7250/xiaomi/picasso/image/modem.mdt  (modem partition)
+ *   vendor/... (vendor partition, board data)
+ */
+&mpss {
+	firmware-name = "qcom/sm7250/xiaomi/picasso/image/modem.mdt";
+	status = "okay";
+};
+
+&wifi {
+	vdd-0.8-cx-mx-supply = <&vreg_l1a_0p75>;
+	vdd-1.8-xo-supply = <&vreg_l14a_1p8>;
+	vdd-1.3-rfa-supply = <&vreg_l2c_1p3>;
+	vdd-3.3-ch0-supply = <&vreg_l10c_3p3>;
+	vdd-3.3-ch1-supply = <&vreg_l11c_3p3>;
+	firmware-name = "picasso";
+	status = "okay";
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+/* geni-serial needs a line number, otherwise it fails with "Invalid line -19" */
+/ {
+	aliases {
+		serial1 = &uart5;
+	};
+};
+
+/*
+ * Bluetooth: WCN3990 on GENI UART SE5 (0x894000). The pads (gpio38-41, qup05)
+ * are muxed by picasso-pinmux.c with the vendor's bias per pin; the firmware
+ * (qca/crbtfw32.tlv + qca/crnv32.bin) comes from the phone's "bluetooth"
+ * partition, linked into /lib/firmware/qca by fw-mount.sh.
+ *
+ * Only the SE interrupt is wired: the RX wake interrupt on gpio41 that the SoC
+ * dtsi adds makes the patch/NVM download time out (avicii hit the same thing
+ * and notes the RX wake IRQ must not be on that pad).
+ */
+&uart5 {
+	/delete-property/ interrupts-extended;
+	interrupts-extended = <&intc GIC_SPI 606 IRQ_TYPE_LEVEL_HIGH>;
+	status = "okay";
+
+	bluetooth {
+		/* the chip on picasso answers as a WCN3991 (SOC 0x40010320);
+		 * binding it as wcn3990 makes the version read time out */
+		compatible = "qcom,wcn3991-bt";
+
+		vddio-supply = <&vreg_s4a_1p8>;
+		vddxo-supply = <&vreg_l14a_1p8>;
+		vddrf-supply = <&vreg_l2c_1p3>;
+		vddch0-supply = <&vreg_l10c_3p3>;
+
+		max-speed = <3200000>;
+
+		/* status line from the chip (the vendor's qca,bt-sw-ctrl-gpio) */
+		swctrl-gpios = <&tlmm 73 GPIO_ACTIVE_HIGH>;
+
+		/* btqca sets HCI_QUIRK_USE_BDADDR_PROPERTY for wcn399x: without
+		 * this property the controller stays HCI_UNCONFIGURED, hci_init_sync
+		 * never runs and mgmt lists no index (btmgmt: "Index list with 0
+		 * items"). The real address is provisioned at the factory and lives
+		 * in the phone's persist partition; this locally administered one
+		 * is the bring-up placeholder until it is read from there. */
+		local-bd-address = [ 01 00 00 00 00 02 ];
+
+		/* order matters: [0] is the NVM, [1] the patch (rampatch); the
+		 * driver prefixes "qca/" itself */
+		firmware-name = "crnv32.bin", "crbtfw32.tlv";
+	};
+};
+
+
+&qupv3_id_1 {
+	status = "okay";
+
+	i2c8: i2c@988000 {
+		compatible = "qcom,geni-i2c";
+		reg = <0 0x00988000 0 0x4000>;
+		clock-names = "se";
+		clocks = <&gcc GCC_QUPV3_WRAP1_S2_CLK>;
+		interrupts = <GIC_SPI 355 IRQ_TYPE_LEVEL_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&qup_i2c8_default>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		interconnects = <&qup_virt MASTER_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS
+				 &qup_virt SLAVE_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS>,
+				<&gem_noc MASTER_AMPSS_M0 QCOM_ICC_TAG_ACTIVE_ONLY
+				 &config_noc SLAVE_QUP_1 QCOM_ICC_TAG_ACTIVE_ONLY>,
+				<&aggre1_noc MASTER_QUP_1 QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI_CH0 QCOM_ICC_TAG_ALWAYS>;
+		interconnect-names = "qup-core", "qup-config", "qup-memory";
+		status = "okay";
+
+		speaker_amp: audio-codec@34 {
+			compatible = "nxp,tfa9874";
+			reg = <0x34>;
+			/* active high: the vendor driver idles it low and
+			 * pulses 1 -> 0 to reset the amp */
+			reset-gpios = <&tlmm 58 GPIO_ACTIVE_HIGH>;
+			vddd-supply = <&vreg_s4a_1p8>;
+			#sound-dai-cells = <0>;
+		};
+	};
+};
+
+&sound {
+	compatible = "qcom,sm8250-sndcard";
+	model = "Xiaomi-Redmi-K30-5G";
+	pinctrl-names = "default";
+	pinctrl-0 = <&sec_mi2s_default>;
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		};
+
+	};
+
+	sec-mi2s-dai-link {
+		link-name = "Secondary MI2S Playback";
+
+		cpu {
+			sound-dai = <&q6afedai SECONDARY_MI2S_RX>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
+		codec {
+			sound-dai = <&speaker_amp>;
+		};
+	};
+};
+
+/*
+ * Secondary MI2S to the TFA9874: downstream feeds the amplifier from data
+ * line 1 (gpio74, sec_i2s_data1_active with output-high) and reads its sense
+ * output on line 0 (gpio72, input-enable), same wiring as avicii.
+ */
+&q6afedai {
+	dai@21 {
+		reg = <SECONDARY_MI2S_RX>;
+		/* vendor sec MI2S uses tx-lines = 2: the amp listens on
+		 * data line 1 (gpio74), line 0 (gpio72) is its sense output */
+		qcom,sd-lines = <2>;
+	};
+};
+
+/* q6asm-dai needs one child per frontend dai; MM1 (id 0) is playback */
+&q6asmdai {
+	dai@0 { reg = <0x0>; direction = <Q6ASM_DAI_RX>; };
+	dai@1 { reg = <0x1>; direction = <Q6ASM_DAI_RX>; };
+	dai@2 { reg = <0x2>; direction = <Q6ASM_DAI_RX>; };
+	dai@3 { reg = <0x3>; direction = <Q6ASM_DAI_RX>; };
+};
+
+/* Audio DSP: PAS subsystem whose firmware sits in the modem image dir */
+&adsp {
+	firmware-name = "qcom/sm7250/xiaomi/picasso/image/adsp.mdt";
+	status = "okay";
+};
+
+/* GPU: Adreno 620 + GMU (firmware packed into the initramfs) */
+/* Panel backlight: the PM8150L WLED boost converter (vendor
+ * qcom,string-cfg = <7>, qcom,ovp = <28000>). Without this node the panel scans
+ * out frames but the display stays dark: nothing drives the LED strings. */
+/* Charging: the SMB5 charger in PM7250B, disabled by default in pm7250b.dtsi.
+ * The vendor's charging stack also reads its ADC channels and a QBG gauge;
+ * mainline's charger driver only needs the register block, so this gives
+ * ONLINE/PRESENT/STATUS/CHARGE_TYPE and a charge_behaviour knob. */
+&pm7250b_charger {
+	status = "okay";
+};
+
+&pm8150l_wled {
+	status = "okay";
+	/* only one of num-strings / enabled-strings may be given */
+	qcom,enabled-strings = <0 1 2>;
+	qcom,ovp-millivolt = <28000>;
+};
+
+&gpu {
+	status = "okay";
+};
+
+&gmu {
+	status = "okay";
+};
+
+/* audio pad states: i2c8 (amp) and secondary MI2S */
+&tlmm {
+	qup_i2c8_default: qup-i2c8-default-state {
+		pins = "gpio49", "gpio50";
+		function = "qup12";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	sec_mi2s_default: sec-mi2s-default-state {
+		pins = "gpio70", "gpio71", "gpio72", "gpio74";
+		function = "sec_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+};
+
+/*
+ * Buttons. None of the three is a TLMM pin: power is KPDPWR_N of the PM8150
+ * PON block, volume down is its RESIN_N, and volume up is PM8150L GPIO5 with
+ * a pull-up (the key shorts it to ground) — same arrangement as the vendor
+ * tree (lito-mic-overlay: key_vol_up_default) and the other Xiaomi boards.
+ */
+/ {
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_vol_up_default>;
+
+		key-vol-up {
+			label = "Volume Up";
+			gpios = <&pm8150l_gpios 5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+			/* wake source: the power key wakes through the PON, which on
+			 * this phone ends in a PS_HOLD drop when resume dies; a second
+			 * key that can wake isolates the two paths. */
+			wakeup-source;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+};
+
+&pm8150l_gpios {
+	key_vol_up_default: key-vol-up-state {
+		pins = "gpio5";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+		power-source = <0>;
+	};
+};
+
+&pon {
+	mode-bootloader = <0x2>;
+	mode-recovery = <0x1>;
+};
+
+&pon_pwrkey {
+	/* wakeup-source is what lets the power key wake the SoC from s2idle;
+	 * without it the key is an input device only and a suspended phone can
+	 * only be recovered by holding the key (which powers it off). */
+	wakeup-source;
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	wakeup-source;
+	status = "okay";
+};
+
+/*
+ * Touch. The NT36672C hangs off GENI SPI SE7; its reset (tlmm 4) and interrupt
+ * (tlmm 5) pads are muxed early by picasso-pinmux.c, and the driver polls the
+ * report buffer because the interrupt pad lives in a TLMM tile the mainline
+ * pinctrl driver does not map on this port yet.
+ */
+&spi1 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "xiaomi,picasso-nvt-ts-spi";
+		reg = <0>;
+		spi-max-frequency = <5000000>;
+	};
+};
