+++ b/arch/arm64/boot/dts/qcom/sm7250-xiaomi-picasso.dts
@@ -0,0 +1,387 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi Redmi K30 5G (picasso), Qualcomm SM7250.
+ *
+ * Milestone 1: mainline arm64 Image started as an EFI application by the
+ * Mu-Silicium UEFI boot chain, EFI GOP simpledrm console, initramfs.
+ * Later milestones add USB, UFS, display, touch and Wi-Fi; see
+ * docs/mainline-linux-plan.md and docs/dts-crosswalk.md.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+
+/* PM7250B is configured to use SID2/3 */
+#define PM7250B_SID 2
+#define PM7250B_SID1 3
+
+#include "sm7250.dtsi"
+#include "pm8150.dtsi"
+#include "pm8150l.dtsi"
+#include "pm7250b.dtsi"
+
+/ {
+	model = "Xiaomi Redmi K30 5G";
+	compatible = "xiaomi,picasso", "qcom,sm7250";
+	chassis-type = "handset";
+
+	chosen {
+		/*
+		 * The launcher may override this through EFI LoadOptions.
+		 * ttyMSM0 never binds on this platform; tty0 (simpledrm) and
+		 * the USB console are the useful outputs.
+		 */
+		bootargs = "console=tty0 loglevel=8 ignore_loglevel initcall_debug printk.time=1 panic=0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused";
+	};
+
+	/*
+	 * Only the two low banks are listed: memory above 4 GiB is described by
+	 * the UEFI memory map on this boot path, and the downstream DT leaves
+	 * the top bank for the bootloader to trim (6 GiB devices end below
+	 * 0x180000000). Declaring RAM that does not exist is worse than
+	 * declaring less.
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x3cc00000>,
+		      <0x0 0xc0000000 0x0 0x40000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		hyp_mem: hyp@80000000 {
+			reg = <0x0 0x80000000 0x0 0x600000>;
+			no-map;
+		};
+
+		xbl_aop_mem: xbl-aop@80600000 {
+			reg = <0x0 0x80600000 0x0 0x260000>;
+			no-map;
+		};
+
+		cmd_db: cmd-db@80860000 {
+			compatible = "qcom,cmd-db";
+			reg = <0x0 0x80860000 0x0 0x20000>;
+			no-map;
+		};
+
+		xbl_uefi_mem: xbl-uefi@80880000 {
+			reg = <0x0 0x80880000 0x0 0x14000>;
+			no-map;
+		};
+
+		smem_mem: smem@80900000 {
+			compatible = "qcom,smem";
+			reg = <0x0 0x80900000 0x0 0x200000>;
+			no-map;
+			hwlocks = <&tcsr_mutex 3>;
+		};
+
+		sec_apps_mem: sec-apps@808ff000 {
+			reg = <0x0 0x808ff000 0x0 0x1000>;
+			no-map;
+		};
+
+		removed_mem: removed@80b00000 {
+			reg = <0x0 0x80b00000 0x0 0x1300000>;
+			no-map;
+		};
+
+		qtee_apps_mem: qtee-apps@81e00000 {
+			reg = <0x0 0x81e00000 0x0 0x4200000>;
+			no-map;
+		};
+
+		camera_mem: camera@86000000 {
+			reg = <0x0 0x86000000 0x0 0x500000>;
+			no-map;
+		};
+
+		npu_mem: npu@86500000 {
+			reg = <0x0 0x86500000 0x0 0x500000>;
+			no-map;
+		};
+
+		video_mem: video@86a00000 {
+			reg = <0x0 0x86a00000 0x0 0x500000>;
+			no-map;
+		};
+
+		cdsp_mem: cdsp@87400000 {
+			reg = <0x0 0x87400000 0x0 0x1e00000>;
+			no-map;
+		};
+
+		adsp_mem: adsp@89200000 {
+			reg = <0x0 0x89200000 0x0 0x2800000>;
+			no-map;
+		};
+
+		wlan_fw_mem: wlan-fw@8ba00000 {
+			reg = <0x0 0x8ba00000 0x0 0x200000>;
+			no-map;
+		};
+
+		ipa_fw_mem: ipa-fw@8bc00000 {
+			reg = <0x0 0x8bc00000 0x0 0x10000>;
+			no-map;
+		};
+
+		ipa_gsi_mem: ipa-gsi@8bc10000 {
+			reg = <0x0 0x8bc10000 0x0 0x5400>;
+			no-map;
+		};
+
+		/*
+		 * Downstream reserves 0x8bc15400..0x8bc17400 for the GPU zap
+		 * shader; TrustZone only accepts a 4 KiB aligned load address,
+		 * so the unaligned head is a separate region.
+		 */
+		gpu_pad_mem: gpu-pad@8bc15400 {
+			reg = <0x0 0x8bc15400 0x0 0xc00>;
+			no-map;
+		};
+
+		gpu_mem: gpu@8bc16000 {
+			reg = <0x0 0x8bc16000 0x0 0x1400>;
+			no-map;
+		};
+
+		reserved_pil_mem: reserved-pil@8bc17400 {
+			reg = <0x0 0x8bc17400 0x0 0x3e8c00>;
+			no-map;
+		};
+
+		modem_wlan_mem: modem-wlan@8c000000 {
+			reg = <0x0 0x8c000000 0x0 0xf800000>;
+			no-map;
+		};
+
+		cdsp_sec_mem: cdsp-sec@9f400000 {
+			reg = <0x0 0x9f400000 0x0 0xc00000>;
+			no-map;
+		};
+
+		cont_splash_mem: cont-splash@a0000000 {
+			reg = <0x0 0xa0000000 0x0 0x2300000>;
+			iommu-addresses = <&mdss 0x0 0xa0000000 0x0 0x2300000>;
+			no-map;
+		};
+
+		dfps_data_mem: dfps-data@a2300000 {
+			reg = <0x0 0xa2300000 0x0 0x100000>;
+			no-map;
+		};
+
+		/*
+		 * The XNUP payload window used by the Mu-Silicium chain: linux.efi,
+		 * the kernel Image, the ramdisk and this DTB live here. Reserved
+		 * but not no-map, so the kernel never hands it out yet can read
+		 * the ramdisk at the address in /chosen/linux,initrd-start.
+		 */
+		/*
+		 * The last MiB of the payload window is the RAM console: the
+		 * kernel mirrors printk there and the loader reads it with
+		 * "oem ramoops" after a reset (kernel/printk/printk.c).
+		 */
+		linux_payload_mem: linux-payload@f0000000 {
+			reg = <0x0 0xf0000000 0x0 0x3f00000>;
+		};
+
+		/* console mirror written by the kernel (kernel/printk/printk.c) */
+		ramlog_mem: ramlog@f3f00000 {
+			reg = <0x0 0xf3f00000 0x0 0x100000>;
+		};
+	};
+};
+
+
+/*
+ * Only the south tile answers on this board: reads of the west (0xf500000)
+ * and east (0xf900000) tiles never return and hang the accessing worker, so
+ * they are left out of the mapping (the driver skips unmapped tiles).
+ * South holds the touch reset/IRQ (gpio4/5), the panel TE (gpio10) and the
+ * UFS reset pin.
+ */
+&tlmm {
+	reg = <0x0 0x0f100000 0x0 0x300000>;
+	reg-names = "south";
+};
+
+/*
+ * PM8150 rails used by the USB PHY. The bootloader leaves all of them on;
+ * Linux is the only RPMh voter on this boot, so they stay always-on until the
+ * consumers are known to be safe.
+ */
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8150-rpmh-regulators";
+		qcom,pmic-id = "a";
+
+		vreg_s4a_1p8: smps4 {
+			regulator-name = "vreg_s4a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		vreg_l2a_3p1: ldo2 {
+			regulator-name = "vreg_l2a_3p1";
+			regulator-min-microvolt = <3072000>;
+			regulator-max-microvolt = <3072000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		vreg_l5a_0p88: ldo5 {
+			regulator-name = "vreg_l5a_0p88";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <880000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		vreg_l12a_1p8: ldo12 {
+			regulator-name = "vreg_l12a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		/* UFS PHY PLL (downstream ldoa9 1.16 - 1.32 V) */
+		vreg_l9a_1p2: ldo9 {
+			regulator-name = "vreg_l9a_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+	};
+
+	/* PM8150L: UFS vcc (downstream ldoc7, 2.704 - 3.304 V; UFS asks 2.95) */
+	regulators-1 {
+		compatible = "qcom,pm8150l-rpmh-regulators";
+		qcom,pmic-id = "c";
+
+		/* panel I/O (downstream ldoc1, 1.8 V) */
+		vreg_l1c_1p8: ldo1 {
+			regulator-name = "vreg_l1c_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		vreg_l7c_2p95: ldo7 {
+			regulator-name = "vreg_l7c_2p95";
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <2960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+	};
+};
+
+/* UFS 2.1: root filesystem (read-only first) and the firmware partition. */
+&ufs_mem_hc {
+	vcc-supply = <&vreg_l7c_2p95>;
+	vcc-max-microamp = <800000>;
+	vccq2-supply = <&vreg_s4a_1p8>;
+	vccq2-max-microamp = <800000>;
+
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&vreg_l5a_0p88>;
+	vdda-pll-supply = <&vreg_l9a_1p2>;
+
+	status = "okay";
+};
+
+/* USB 2.0 gadget: the console and the file channel during bring-up. */
+&usb_1 {
+	status = "okay";
+};
+
+&usb_1_dwc3 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+};
+
+&usb_1_hsphy {
+	vdda-pll-supply = <&vreg_l5a_0p88>;
+	vdda18-supply = <&vreg_l12a_1p8>;
+	vdda33-supply = <&vreg_l2a_3p1>;
+
+	status = "okay";
+};
+
+/* Panel tearing-effect line (downstream sde_te_active, TLMM gpio10) */
+&tlmm {
+	mdp_vsync_te_active: mdp-vsync-te-active-state {
+		pins = "gpio10";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_mdp {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l9a_1p2>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "xiaomi,g7a-37-02-0a";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l1c_1p8>;
+		reset-gpios = <&pm8150l_gpios 3 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&mdp_vsync_te_active>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+	qcom,te-source = "mdp_vsync_p";
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p88>;
+
+	status = "okay";
+};
