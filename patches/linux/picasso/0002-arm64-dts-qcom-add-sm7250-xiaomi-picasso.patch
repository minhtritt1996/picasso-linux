+/*
+ * Buttons. None of the three is a TLMM pin: power is KPDPWR_N of the PM8150
+ * PON block, volume down is its RESIN_N, and volume up is PM8150L GPIO5 with
+ * a pull-up (the key shorts it to ground) — same arrangement as the vendor
+ * tree (lito-mic-overlay: key_vol_up_default) and the other Xiaomi boards.
+ */
+/ {
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_vol_up_default>;
+
+		key-vol-up {
+			label = "Volume Up";
+			gpios = <&pm8150l_gpios 5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+			/* wake source: the power key wakes through the PON, which on
+			 * this phone ends in a PS_HOLD drop when resume dies; a second
+			 * key that can wake isolates the two paths. */
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+};
+
+&pm8150l_gpios {
+	key_vol_up_default: key-vol-up-state {
+		pins = "gpio5";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+		power-source = <0>;
+	};
+};
