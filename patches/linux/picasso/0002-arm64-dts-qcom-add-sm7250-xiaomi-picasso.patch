+/*
+ * ---- Cellular data path: IPA v4.7 --------------------------------------
+ *
+ * AP<->modem IP data path.  There is no ipa_fws image on this device: the
+ * modem performs the GSI firmware load and signals completion over the "ipa"
+ * SMP2P entry, hence qcom,gsi-loader = "modem" (the binding requires a
+ * memory-region only for "self").  Register block: 0x1e00000 + the IPAv4.7
+ * reg-base offset 0x40000; local SRAM at +0x10000; GSI at 0x1e04000.
+ *
+ * The first bring-up uses the qcom,sm6350-ipa compatible alone: ipa_main.c
+ * maps it to ipa_data_v4_7, so no driver/binding patch is needed yet.
+ */
+&soc {
+	ipa: ipa@1e40000 {
+		compatible = "qcom,sm6350-ipa";
+
+		reg = <0x0 0x01e40000 0x0 0x8000>,
+		      <0x0 0x01e50000 0x0 0x3000>,
+		      <0x0 0x01e04000 0x0 0x23000>;
+		reg-names = "ipa-reg", "ipa-shared", "gsi";
+
+		interrupts-extended = <&intc GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>,
+				      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>,
+				      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "ipa", "gsi",
+				  "ipa-clock-query", "ipa-setup-ready";
+
+		iommus = <&apps_smmu 0x520 0x0>,
+			 <&apps_smmu 0x522 0x0>;
+
+		clocks = <&rpmhcc RPMH_IPA_CLK>;
+		clock-names = "core";
+
+		interconnects = <&aggre2_noc MASTER_IPA QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI_CH0 QCOM_ICC_TAG_ALWAYS>,
+				<&aggre2_noc MASTER_IPA QCOM_ICC_TAG_ALWAYS
+				 &system_noc SLAVE_OCIMEM QCOM_ICC_TAG_ALWAYS>,
+				<&gem_noc MASTER_AMPSS_M0 QCOM_ICC_TAG_ACTIVE_ONLY
+				 &config_noc SLAVE_IPA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>;
+		interconnect-names = "memory", "imem", "config";
+
+		qcom,qmp = <&aoss_qmp>;
+		qcom,smem-states = <&ipa_smp2p_out 0>,
+				   <&ipa_smp2p_out 1>;
+		qcom,smem-state-names = "ipa-clock-enabled-valid",
+					"ipa-clock-enabled";
+		qcom,gsi-loader = "modem";
+
+		status = "okay";
+	};
+};
+
+/*
+ * ---- Health regressions: notification LED and Type-C/PD -----------------
+ */
+
+/*
+ * Notification LED: PM8150L TRILED, channel 2 is the only populated emitter.
+ * Downstream (vendor/qcom/picasso-sm7250.dtsi:628-640) disables red and green
+ * and relabels blue as "white", so expose exactly that one channel.
+ */
+&pm8150l_lpg {
+	status = "okay";
+
+	led@2 {
+		reg = <2>;
+		color = <LED_COLOR_ID_BLUE>;
+		function = LED_FUNCTION_INDICATOR;
+		default-state = "off";
+	};
+};
+
+/* Type-C: PM7250B port + PD PHY. PD PHY VDD is PM8150 LDO2 (3.072 V), exactly
+ * as the vendor lito overlay wires it (lito-pmic-overlay.dtsi:451-455). PD is
+ * left disabled so the current peripheral-mode USB gadget keeps working. */
+&pm7250b_vbus {
+	status = "okay";
+};
+
+&pm7250b_typec {
+	vdd-pdphy-supply = <&vreg_l2a_3p1>;
+	status = "okay";
+
+	connector {
+		compatible = "usb-c-connector";
+
+		power-role = "dual";
+		data-role = "dual";
+		self-powered;
+		typec-power-opmode = "default";
+		pd-disable;
+
+		vbus-supply = <&pm7250b_vbus>;
+	};
+};
