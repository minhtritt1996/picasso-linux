+/*
+ * Touch. The NT36672C hangs off GENI SPI SE7; its reset (tlmm 4) and interrupt
+ * (tlmm 5) pads are muxed early by picasso-pinmux.c, and the driver polls the
+ * report buffer because the interrupt pad lives in a TLMM tile the mainline
+ * pinctrl driver does not map on this port yet.
+ */
+&spi1 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "xiaomi,picasso-nvt-ts-spi";
+		reg = <0>;
+		spi-max-frequency = <9600000>;
+		/* this unit's lockdown bytes (0x46,0x36,...) select the cfg_2 entry
+		 * of the vendor DT, i.e. fw03 rather than fw01 */
+		firmware-name = "novatek/novatek_nt36672c_g7a_fw03.bin";
+		/* vendor: novatek,reset-gpio = <&tlmm 4 0> */
+		reset-gpios = <&tlmm 4 GPIO_ACTIVE_LOW>;
+		/* vendor: novatek,irq-gpio = <&tlmm 5 0x2001>; the controller
+		 * idles INT low and pulses it high (vendor uses EDGE_RISING) */
+		interrupt-parent = <&tlmm>;
+		interrupts = <5 IRQ_TYPE_EDGE_RISING>;
+	};
+};
