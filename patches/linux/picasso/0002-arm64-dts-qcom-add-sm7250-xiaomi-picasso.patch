+	camera_wide_vdig_1p2: regulator-camera-wide-vdig {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_wide_vdig_1p2";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		gpio = <&tlmm 45 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_wide_vdig_en>;
+		regulator-enable-ramp-delay = <135>;
+		vin-supply = <&vreg_s8c_1p2>;
+	};
+
+	/* WCD9385: split codec on Bolero, SoundWire RX/TX slaves on swr1/swr2.
+	 * Values from lito-audio-overlay.dtsi:177-222, picasso-audio-overlay.dtsi
+	 * (:129-135 micbias 2.75 V, :58-59 jack switches).  Reset is active low
+	 * on WEST-tile gpio57 and is pulsed by picasso-pinmux, because gpiod
+	 * writes never reach that tile. */
+	wcd9385: audio-codec {
+		compatible = "qcom,wcd9385-codec";
+
+		reset-gpios = <&tlmm 57 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&vreg_s4a_1p8>;
+		vdd-rxtx-supply = <&vreg_s4a_1p8>;
+		vdd-io-supply = <&vreg_s4a_1p8>;
+		vdd-mic-bias-supply = <&vreg_bob>;
+
+		qcom,micbias1-microvolt = <2750000>;
+		qcom,micbias2-microvolt = <2750000>;
+		qcom,micbias3-microvolt = <2750000>;
+		qcom,micbias4-microvolt = <2750000>;
+
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,hphl-jack-type-normally-closed;
+		qcom,ground-jack-type-normally-closed;
+
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+};
