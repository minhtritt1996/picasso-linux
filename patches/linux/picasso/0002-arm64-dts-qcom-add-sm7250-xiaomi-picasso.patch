+	 * No wakeup-source here, and none is needed: pm8941-pwrkey marks the
+	 * pwrkey as a wake source by default (wakeup_source_default) and calls
+	 * enable_irq_wake() at suspend through the SPMI->PDC wake chain. The
+	 * binding rejects the property for this compatible. An earlier comment
+	 * here claimed the key was not a wake source because "the phone powers
+	 * off instead of resuming" - that was logind acting on the queued
+	 * KEY_POWER after a successful resume (HandlePowerKey=poweroff), not a
+	 * missing wake IRQ.
+	 */
+	status = "okay";
+};
