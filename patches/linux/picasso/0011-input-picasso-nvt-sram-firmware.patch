diff --git a/drivers/input/touchscreen/picasso-nvt-spi.c b/drivers/input/touchscreen/picasso-nvt-spi.c
new file mode 100644
index 000000000..44c27716a
--- /dev/null
+++ b/drivers/input/touchscreen/picasso-nvt-spi.c
@@ -0,0 +1,997 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Novatek NT36672C touchscreen on the Xiaomi Redmi K30 5G (picasso, SM7250).
+ *
+ * The panel's touch controller sits on GENI SPI SE7 (0x984000) as an SPI
+ * slave and speaks Novatek's register protocol, which the vendor driver
+ * (nt36672c/nt36xxx.c, downstream 4.19) documents:
+ *
+ *   set page   write 3 bytes: 0xff, (addr >> 15) & 0xff, (addr >> 7) & 0xff
+ *   write      1 command byte with bit 7 set, then the data bytes
+ *   read       the command byte has bit 7 masked off, the transfer is one
+ *              byte longer than the data, and the data comes back from the
+ *              third received byte on
+ *
+ * The controller requires host-downloaded SRAM firmware. This driver
+ * loads it, checks reset state, and polls the touch report buffer: no
+ * persistent firmware update, no MP test, no gesture.  The reset and the SPI pads are
+ * muxed early by drivers/soc/qcom/picasso-pinmux.c, because the TLMM tiles
+ * these pins live in are not mapped by the mainline pinctrl driver on this
+ * port yet.
+ *
+ * Report layout (10 slots of 6 bytes after the first byte):
+ *   byte 0        status: bits 2:0 = 1 down, 2 move, 3 up; bits 7:3 = slot id
+ *   bytes 1, 2    x and y, high 8 bits
+ *   byte 3        low nibbles: bits 7:4 = x, bits 3:0 = y
+ *   bytes 4, 5    pressure / area, unused here
+ */
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/property.h>
+#include <linux/unaligned.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/module.h>
+#include <linux/spi/spi.h>
+#include <linux/workqueue.h>
+#include <linux/atomic.h>
+
+#define NVT_MAX_FINGERS		10
+#define NVT_REPORT_LEN		(1 + 6 * NVT_MAX_FINGERS)
+#define NVT_POLL_MS		8
+
+/* Bring-up switch: skip the controller reset entirely. The bootloader leaves
+ * the chip running its own firmware; if resetting it only lands it in the
+ * bootloader (fw reset state never reaches 0xa0), the reset is the problem, not
+ * the reporting path. Set with picasso_nvt_spi.no_reset=1 on the kernel cmdline. */
+static char *firmware_name = "novatek/novatek_nt36672c_g7a_fw03.bin";
+module_param(firmware_name, charp, 0444);
+MODULE_PARM_DESC(firmware_name, "SRAM firmware file (DT firmware-name overrides default)");
+static bool no_reset;
+module_param(no_reset, bool, 0444);
+MODULE_PARM_DESC(no_reset, "do not reset the controller at probe");
+
+#define NVT_PAGE_CMD		0xff
+#define NVT_READ_MASK		0x7f
+#define NVT_WRITE_MASK		0x80
+
+/* chip id lives at 0x1f64e; the page command addresses 23-bit space */
+#define NVT_ID_ADDR		0x1f64e
+/* The SPI variant of the vendor driver resets through SWRST_N8, not through
+ * the I2C engine-reset register: DT novatek,swrst-n8-addr = <0x03f0fe> for the
+ * NT36672A map, 0x69 boots the fw, 0xaa idles the MCU. */
+#define NVT_SWRST_N8_ADDR	0x03f0fe
+#define NVT_SWRST_N8_BOOT	0x69
+#define NVT_SWRST_N8_IDLE	0xaa
+#define NVT_SPI_RD_FAST_ADDR	0x03f310
+
+/* event-map offsets, from nt36xxx.h of the vendor driver */
+#define NVT_MAP_RESET_COMPLETE	0x60	/* 0xa0..0xaf once the fw is running */
+#define NVT_MAP_FWINFO		0x78	/* fw_ver, ~fw_ver, x_num, y_num, ... */
+#define NVT_RESET_STATE_INIT	0xa0
+#define NVT_RESET_STATE_MAX	0xaf
+
+/* event buffer base per chip variant, from the vendor trim id table */
+#define NVT_EVENT_BUF_36675	0x22d00		/* id .. 72 66 03 / 75 66 03 */
+#define NVT_EVENT_BUF_36672A	0x11a00		/* id .. 70 66 03 and friends */
+#define NVT_EVENT_BUF_DEFAULT	0x22d00	/* nt36xxx_mem_map.h, nt36672c map */
+#define NVT_HANDSHAKE_BYTE	0x51
+#define NVT_THP_HEADER_LEN	0x20
+#define NVT_MATRIX_NODES	(18 * 36)
+#define NVT_THP_FRAME_LEN	(NVT_THP_HEADER_LEN + NVT_MATRIX_NODES * 2)	/* EVENT_MAP_HANDSHAKING_or_SUB_CMD_BYTE */
+
+struct nvt_ts {
+	struct spi_device *spi;
+	struct input_dev *input;
+	struct gpio_desc *reset_gpio;
+	struct delayed_work poll;
+	/* large enough for a whole THP frame (32-byte header + 18x36 int16) */
+	u8 tx[1408];
+	u8 rx[1408];
+	u32 event_buf;
+	bool have_event_buf;
+	atomic_t report_count;
+	u8 last_report[NVT_REPORT_LEN];
+	u32 nonzero_reports;
+	u32 acks;
+	u32 valid_reports;
+	u8 last_off, last_slot;
+	u32 irq_count;
+	u32 matrix_abs;
+	u32 matrix_hot;
+	u8 frame[NVT_THP_FRAME_LEN];
+	s16 matrix[648];
+	s16 reference[648];
+	bool ref_valid;
+	u32 contacts;
+	u16 last_x, last_y;
+	u8 last_slot_state[NVT_MAX_FINGERS];
+	int last_nz;
+	u8 best_report[NVT_REPORT_LEN];
+};
+
+static int nvt_write_reg(struct nvt_ts *ts, const u8 *buf, size_t len)
+{
+	u8 *tx = ts->tx;
+	int ret;
+
+	if (len > sizeof(ts->tx))
+		return -EINVAL;
+	memcpy(tx, buf, len);
+	tx[0] |= NVT_WRITE_MASK;
+	ret = spi_write(ts->spi, tx, len);
+	return ret;
+}
+
+static int nvt_set_page(struct nvt_ts *ts, u32 addr)
+{
+	u8 buf[3] = {
+		NVT_PAGE_CMD,
+		(addr >> 15) & 0xff,
+		(addr >> 7) & 0xff,
+	};
+
+	return nvt_write_reg(ts, buf, sizeof(buf));
+}
+
+/* Downstream framing for the report pipe: one address byte, then the data
+ * (nt36xxx.c CTP_SPI_READ, t.len = len + DUMMY_BYTES, data at rx[1]). */
+static int nvt_read_vendor(struct nvt_ts *ts, u8 offset, u8 *dst, size_t len)
+{
+	struct spi_transfer t = {
+		.tx_buf = ts->tx,
+		.rx_buf = ts->rx,
+		.len = len + 1,
+	};
+	int ret;
+
+	if (len + 1 > sizeof(ts->tx))
+		return -EINVAL;
+	memset(ts->tx, 0, len + 1);
+	memset(ts->rx, 0, len + 1);
+	ts->tx[0] = offset & 0x7f;
+	ret = spi_sync_transfer(ts->spi, &t, 1);
+	if (ret)
+		return ret;
+	memcpy(dst, ts->rx + 1, len);
+	return 0;
+}
+
+static int nvt_read(struct nvt_ts *ts, u8 offset, u8 *dst, size_t len)
+{
+	struct spi_transfer t = {
+		.tx_buf = ts->tx,
+		.rx_buf = ts->rx,
+		.len = len + 1 + 1,	/* command + one turnaround byte */
+	};
+	int ret;
+
+	if (len + 2 > sizeof(ts->tx))
+		return -EINVAL;
+	memset(ts->tx, 0, len + 2);
+	memset(ts->rx, 0, len + 2);
+	ts->tx[0] = offset & NVT_READ_MASK;
+	ret = spi_sync_transfer(ts->spi, &t, 1);
+	if (ret)
+		return ret;
+	memcpy(dst, ts->rx + 2, len);
+	return 0;
+}
+
+static int nvt_write_addr(struct nvt_ts *ts, u32 addr, u8 val)
+{
+	u8 buf[2] = { addr & 0x7f, val };
+	int ret;
+
+	ret = nvt_set_page(ts, addr);
+	if (ret)
+		return ret;
+	return nvt_write_reg(ts, buf, sizeof(buf));
+}
+
+static int nvt_read_mapped(struct nvt_ts *ts, u32 addr, u8 *dst, size_t len)
+{
+	int ret;
+
+	ret = nvt_set_page(ts, addr);
+	if (ret)
+		return ret;
+	return nvt_read(ts, addr & 0x7f, dst, len);
+}
+
+/* Host-download flow from downstream nt36672c/nt36xxx_fw_update.c.
+ * NT36675 hw_crc=2; these writes target controller SRAM, never UFS/flash.
+ */
+static int nvt_write_bytes(struct nvt_ts *ts, u32 addr, const u8 *data, size_t len)
+{
+	u8 buf[65];
+	int ret;
+
+	while (len) {
+		size_t n = min_t(size_t, len, min_t(size_t, 64, 128 - (addr & 127)));
+
+		ret = nvt_set_page(ts, addr);
+		if (ret)
+			return ret;
+		buf[0] = addr & 127;
+		memcpy(buf + 1, data, n);
+		ret = nvt_write_reg(ts, buf, n + 1);
+		if (ret)
+			return ret;
+		addr += n;
+		data += n;
+		len -= n;
+	}
+	return 0;
+}
+
+static int nvt_upload_once(struct nvt_ts *ts)
+{
+	const struct firmware *fw;
+	const char *name = firmware_name;
+	u32 hdr, count, overlay, dlm, i, end;
+	u8 value;
+	int ret;
+
+	device_property_read_string(&ts->spi->dev, "firmware-name", &name);
+	ret = request_firmware(&fw, name, &ts->spi->dev);
+	if (ret)
+		return dev_err_probe(&ts->spi->dev, ret, "request firmware %s\n", name);
+	ret = -EINVAL;
+	if (fw->size < 0x30)
+		goto out;
+	for (end = fw->size / 4096 * 4096; end >= 4096; end -= 4096)
+		if (!memcmp(fw->data + end - 3, "NVT", 3))
+			break;
+	if (!end || (u8)(fw->data[end - 4096] + fw->data[end - 4096 + 1]) != 255)
+		goto out;
+	dev_info(&ts->spi->dev, "firmware %s size=%zu end flag NVT at %#x\n", name, fw->size, end - 3);
+	hdr = get_unaligned_le32(fw->data);
+	dlm = get_unaligned_le32(fw->data + 12);
+	if (hdr < 0x30 || hdr > fw->size || (hdr - 0x30) % 16)
+		goto out;
+	count = 2 + (hdr - 0x30) / 16;
+	overlay = fw->data[0x28] & 0x10 ? fw->data[0x28] & 15 : 0;
+	/* Validate all partitions before resetting or writing the controller. */
+	for (i = 0; i < count + overlay; i++) {
+		u32 pos = i < 2 ? i * 12 : i < count ? 0x30 + (i - 2) * 16 : dlm + (i - count) * 16;
+		u32 bin, len, addr;
+
+		if (pos > fw->size - 16)
+			goto out;
+		bin = get_unaligned_le32(fw->data + pos + (i < 2 ? 0 : 8));
+		addr = get_unaligned_le32(fw->data + pos + (i < 2 ? 4 : 0));
+		len = get_unaligned_le32(fw->data + pos + (i < 2 ? 8 : 4));
+		if (len && (bin >= fw->size || len >= fw->size - bin || addr > 0x7fffff || len > 0x7fffff - addr))
+			goto out;
+	}
+	ret = nvt_write_addr(ts, NVT_SWRST_N8_ADDR, NVT_SWRST_N8_BOOT);
+	if (ret)
+		goto out;
+	msleep(5);
+	ret = nvt_write_addr(ts, NVT_SPI_RD_FAST_ADDR, 0);
+	if (ret)
+		goto out;
+	for (i = 0; i < count + overlay; i++) {
+		u32 pos = i < 2 ? i * 12 : i < count ? 0x30 + (i - 2) * 16 : dlm + (i - count) * 16;
+		u32 bin = get_unaligned_le32(fw->data + pos + (i < 2 ? 0 : 8));
+		u32 addr = get_unaligned_le32(fw->data + pos + (i < 2 ? 4 : 0));
+		u32 len = get_unaligned_le32(fw->data + pos + (i < 2 ? 8 : 4));
+
+		if (!len)
+			continue;
+		ret = nvt_write_bytes(ts, addr, fw->data + bin, len + 1);
+		if (ret)
+			goto out;
+		dev_info(&ts->spi->dev, "SRAM partition %u addr=%#x bytes=%u\n", i, addr, len + 1);
+		if (i < 2) {
+			u8 bank[4];
+			put_unaligned_le32(addr, bank);
+			ret = nvt_write_bytes(ts, i ? 0x3f12c : 0x3f128, bank, 3);
+			if (ret) goto out;
+			put_unaligned_le32(len, bank);
+			/* hw_crc=2: command plus three length bytes, bit 16 only. */
+			bank[2] &= 1;
+			ret = nvt_write_bytes(ts, i ? 0x3f130 : 0x3f118, bank, 3);
+			if (ret) goto out;
+			memcpy(bank, fw->data + 0x18 + i * 4, 4);
+			ret = nvt_write_bytes(ts, 0x3f100 + i * 4, bank, 4);
+			if (ret) goto out;
+			dev_info(&ts->spi->dev, "partition %u golden CRC=%#x\n", i, get_unaligned_le32(bank));
+		}
+	}
+	ret = nvt_read_mapped(ts, 0x3f30e, &value, 1);
+	if (ret) goto out;
+	ret = nvt_write_addr(ts, 0x3f30e, value | 0x80);
+	if (ret) goto out;
+	ret = nvt_write_addr(ts, ts->event_buf + 0x60, 0);
+	if (ret) goto out;
+	ret = nvt_write_addr(ts, ts->event_buf + 0x50, 0xae);
+	if (ret) goto out;
+	ret = nvt_write_addr(ts, 0x3f10d, 1);
+	msleep(5);
+	dev_info(&ts->spi->dev, "SRAM upload CRC enabled BOOT_RDY ret=%d\n", ret);
+	if (ret)
+		goto out;
+	ret = -ETIMEDOUT;
+	for (i = 0; i < 100; i++) {
+		msleep(10);
+		if (!nvt_read_mapped(ts, ts->event_buf + 0x60, &value, 1) &&
+		    value >= NVT_RESET_STATE_INIT && value <= NVT_RESET_STATE_MAX) {
+			ret = 0;
+			break;
+		}
+	}
+	dev_info(&ts->spi->dev, "upload reset state=%#x polls=%u ret=%d\n",
+		 value, i + 1, ret);
+	{
+		u8 flags;
+		int err = nvt_read_mapped(ts, 0x3f133, &flags, 1);
+
+		if (!err)
+			dev_info(&ts->spi->dev,
+				 "upload CRC flags=%#x done=%u ilm=%u dlm=%u\n",
+				 flags, !!(flags & 4), !!(flags & 1), !!(flags & 2));
+	}
+
+ out:
+	release_firmware(fw);
+	return ret;
+}
+
+/* Downstream retries the entire reset/download/CRC/boot sequence three times. */
+static int nvt_upload(struct nvt_ts *ts)
+{
+	int attempt, ret;
+
+	for (attempt = 1; attempt <= 3; attempt++) {
+		dev_info(&ts->spi->dev, "SRAM upload attempt %d/3\n", attempt);
+		ret = nvt_upload_once(ts);
+		if (!ret)
+			return 0;
+		dev_warn(&ts->spi->dev, "SRAM upload attempt %d failed: %d\n", attempt, ret);
+	}
+	return ret;
+}
+
+static int nvt_read_id(struct nvt_ts *ts, u8 *id, size_t len)
+{
+	int ret;
+
+	ret = nvt_set_page(ts, NVT_ID_ADDR);
+	if (ret)
+		return ret;
+	return nvt_read(ts, NVT_ID_ADDR & 0x7f, id, len);
+}
+
+static void nvt_report(struct nvt_ts *ts, const u8 *report)
+{
+	atomic_inc(&ts->report_count);
+	memcpy(ts->last_report, report, NVT_REPORT_LEN);
+	if (memchr_inv(report, 0, NVT_REPORT_LEN))
+		ts->nonzero_reports++;
+	struct input_dev *input = ts->input;
+	bool touch = false;
+	int i, base;
+
+	/*
+	 * The report is 65 bytes holding ten 6-byte contact records, but the
+	 * record grid does not necessarily start at byte 0 of the pipe; use the
+	 * alignment the scanner found (ts->last_off).
+	 */
+	base = ts->last_off;
+
+	for (i = 0; i < NVT_MAX_FINGERS; i++) {
+		const u8 *p = report + base + 6 * i;
+		unsigned int status = p[0] & 0x07;
+		unsigned int slot = p[0] >> 3;
+		unsigned int x, y;
+
+		if (status != 1 && status != 2)
+			continue;
+		if (slot == 0 || slot > NVT_MAX_FINGERS)
+			continue;
+		x = (p[1] << 4) | (p[3] >> 4);
+		y = (p[2] << 4) | (p[3] & 0x0f);
+		if (x >= 1080 || y >= 2400)
+			continue;
+		input_mt_slot(input, slot - 1);
+		input_mt_report_slot_state(input, MT_TOOL_FINGER, true);
+		input_report_abs(input, ABS_MT_POSITION_X, x);
+		input_report_abs(input, ABS_MT_POSITION_Y, y);
+		touch = true;
+	}
+	input_mt_sync_frame(input);
+	input_report_key(input, BTN_TOUCH, touch);
+	input_sync(input);
+}
+
+/*
+ * The controller raises 0xA5 in the event buffer's handshake byte when a report
+ * is ready and waits for the host to clear it (downstream nvt_check_fw_status /
+ * nvt_clear_fw_status). Without the acknowledgement the point pipe never
+ * advances, which looks exactly like a dead touchscreen.
+ */
+static int nvt_handshake(struct nvt_ts *ts)
+{
+	u8 b = 0;
+
+	if (nvt_read_mapped(ts, ts->event_buf | NVT_HANDSHAKE_BYTE, &b, 1))
+		return -EIO;
+	if (b != 0xA5)
+		return 1;			/* nothing to acknowledge */
+	if (nvt_write_addr(ts, ts->event_buf | NVT_HANDSHAKE_BYTE, 0x00))
+		return -EIO;
+	ts->acks++;
+	return 0;
+}
+
+static irqreturn_t nvt_irq(int irq, void *data)
+{
+	struct nvt_ts *ts = data;
+
+	ts->irq_count++;
+	return IRQ_WAKE_THREAD;
+}
+
+/* The firmware publishes one report per interrupt: read it here, in process
+ * context, so the next report is allowed through. */
+static irqreturn_t nvt_irq_thread(int irq, void *data)
+{
+	struct nvt_ts *ts = data;
+	u8 report[NVT_REPORT_LEN];
+
+	if (!nvt_read_mapped(ts, ts->event_buf, report, sizeof(report)))
+		nvt_report(ts, report);
+	return IRQ_HANDLED;
+}
+
+/*
+ * The event buffer may hold a THP frame (32-byte header + the 18x36 int16
+ * matrix) instead of contact records. Summing the matrix settles whether the
+ * controller senses a finger at all, independently of the record format.
+ */
+static void nvt_sample_matrix(struct nvt_ts *ts)
+{
+	u32 sum = 0, hot = 0;
+	int i;
+
+	if (nvt_read_mapped(ts, ts->event_buf, ts->frame, sizeof(ts->frame)))
+		return;
+	for (i = 0; i < NVT_MATRIX_NODES; i++) {
+		s16 v;
+
+		memcpy(&v, ts->frame + NVT_THP_HEADER_LEN + 2 * i, 2);
+		if (v < 0)
+			v = -v;
+		sum += v;
+		if (v > 200)
+			hot++;
+	}
+	ts->matrix_abs = sum;
+	ts->matrix_hot = hot;
+}
+
+#define NVT_ROWS	36
+#define NVT_COLS	18
+#define NVT_NODES	(NVT_ROWS * NVT_COLS)
+#define NVT_PEAK_THRESHOLD	220
+#define NVT_DOWN_THRESHOLD	300
+#define NVT_CENTROID_FLOOR	30
+#define NVT_REFERENCE_RATE	32
+#define NVT_MAX_CONTACTS	10
+
+/* Node centres in panel pixels (Apache-2.0, UniXNU-picasso NativeNovatekTouch). */
+static const s16 nvt_row_map[NVT_ROWS] = {
+	33, 100, 167, 233, 300, 367, 433, 500, 567, 633, 700, 767, 833, 900, 967,
+	1033, 1100, 1167, 1233, 1300, 1367, 1433, 1500, 1567, 1633, 1700, 1767,
+	1833, 1900, 1967, 2033, 2100, 2167, 2233, 2300, 2367,
+};
+static const s16 nvt_col_map[NVT_COLS] = {
+	30, 90, 150, 210, 270, 330, 390, 450, 510, 570, 630, 690, 750, 810, 870,
+	930, 990, 1050,
+};
+
+/*
+ * The controller's event buffer holds a THP frame: a 32-byte header followed by
+ * the raw 18x36 int16 capacitance matrix. Contacts are computed here against a
+ * slowly drifting reference, because this panel's firmware does not publish the
+ * classic 6-byte contact records the vendor driver reads.
+ */
+static void nvt_matrix_report(struct nvt_ts *ts)
+{
+	struct input_dev *input = ts->input;
+	s16 delta[NVT_NODES];
+	int i, n, touched = 0, emitted = 0;
+
+	if (nvt_read_mapped(ts, ts->event_buf, ts->frame, sizeof(ts->frame)))
+		return;
+	for (i = 0; i < NVT_NODES; i++) {
+		__le16 raw;
+
+		memcpy(&raw, ts->frame + NVT_THP_HEADER_LEN + 2 * i, 2);
+		ts->matrix[i] = (s16)le16_to_cpu(raw);
+	}
+	if (!ts->ref_valid) {
+		memcpy(ts->reference, ts->matrix, sizeof(ts->matrix));
+		ts->ref_valid = true;
+		return;
+	}
+	for (i = 0; i < NVT_NODES; i++) {
+		delta[i] = ts->matrix[i] - ts->reference[i];
+		if (delta[i] >= NVT_PEAK_THRESHOLD)
+			touched = 1;
+	}
+	if (!touched) {
+		for (i = 0; i < NVT_NODES; i++) {
+			int step = delta[i] / NVT_REFERENCE_RATE;
+
+			if (!step && delta[i])
+				step = delta[i] > 0 ? 1 : -1;
+			ts->reference[i] += step;
+		}
+		ts->contacts = 0;
+		input_mt_sync_frame(input);
+		input_report_key(input, BTN_TOUCH, 0);
+		input_sync(input);
+		return;
+	}
+	/* Local maxima above the down threshold become contacts, with a
+	 * weighted centroid over the surrounding nodes. */
+	for (i = 0; i < NVT_NODES && emitted < NVT_MAX_CONTACTS; i++) {
+		int r = i / NVT_COLS, c = i % NVT_COLS, dr, dc, peak = delta[i];
+		s64 sw = 0, sx = 0, sy = 0;
+
+		if (peak < NVT_DOWN_THRESHOLD)
+			continue;
+		for (dr = -1; dr <= 1; dr++) {
+			for (dc = -1; dc <= 1; dc++) {
+				int rr = r + dr, cc = c + dc;
+
+				if ((dr || dc) && rr >= 0 && rr < NVT_ROWS &&
+				    cc >= 0 && cc < NVT_COLS &&
+				    delta[rr * NVT_COLS + cc] > peak) {
+					peak = -1;
+					break;
+				}
+			}
+			if (peak < 0)
+				break;
+		}
+		if (peak < 0)
+			continue;
+		for (dr = -2; dr <= 2; dr++) {
+			for (dc = -2; dc <= 2; dc++) {
+				int rr = r + dr, cc = c + dc, v, w, floor;
+
+				if (rr < 0 || rr >= NVT_ROWS || cc < 0 || cc >= NVT_COLS)
+					continue;
+				v = delta[rr * NVT_COLS + cc];
+				floor = peak * NVT_CENTROID_FLOOR / 100;
+				if (v <= floor)
+					continue;
+				w = v - floor;
+				sw += w;
+				sx += (s64)w * nvt_col_map[cc];
+				sy += (s64)w * nvt_row_map[rr];
+			}
+		}
+		if (!sw)
+			continue;
+		input_mt_slot(input, emitted);
+		input_mt_report_slot_state(input, MT_TOOL_FINGER, true);
+		input_report_abs(input, ABS_MT_POSITION_X, div_s64(sx, sw));
+		input_report_abs(input, ABS_MT_POSITION_Y, div_s64(sy, sw));
+		emitted++;
+	}
+	for (n = emitted; n < NVT_MAX_CONTACTS; n++) {
+		input_mt_slot(input, n);
+		input_mt_report_slot_state(input, MT_TOOL_FINGER, false);
+	}
+	ts->contacts = emitted;
+	input_mt_sync_frame(input);
+	input_report_key(input, BTN_TOUCH, emitted > 0);
+	input_sync(input);
+}
+
+static void nvt_poll_work(struct work_struct *work)
+{
+	struct nvt_ts *ts = container_of(work, struct nvt_ts, poll.work);
+	u8 report[NVT_REPORT_LEN];
+
+	/* The report pipe is at address 0: downstream reads a zero-initialised
+	 * buffer with CTP_SPI_READ (nt36xxx.c nvt_ts_work_func). The fw-info
+	 * address printed at probe is unrelated memory and never changes. */
+	int ret;
+
+	nvt_handshake(ts);	/* counts acknowledgements, read is unconditional */
+	nvt_sample_matrix(ts);
+	nvt_matrix_report(ts);
+	ret = nvt_read_mapped(ts, ts->event_buf, report, sizeof(report));
+	/*
+	 * Scan every plausible record alignment for one entry that decodes as a
+	 * finger (status 1/2, slot 1..NVT_MAX_FINGERS, coordinates inside the
+	 * panel). A counter here settles whether the controller ever reports a
+	 * touch at all, independently of when the operator touches the panel.
+	 */
+	{
+		int off, i;
+
+		for (off = 0; off < 6; off++) {
+			for (i = 0; i < NVT_MAX_FINGERS; i++) {
+				const u8 *q = report + off + 6 * i;
+				unsigned int st = q[0] & 0x07, slot = q[0] >> 3;
+				unsigned int x = (q[1] << 4) | (q[3] >> 4);
+				unsigned int y = (q[2] << 4) | (q[3] & 0x0f);
+
+				if ((st == 1 || st == 2) && slot >= 1 &&
+				    slot <= NVT_MAX_FINGERS && x < 1080 && y < 2400) {
+					ts->valid_reports++;
+					ts->last_off = off;
+					ts->last_slot = slot;
+					ts->last_x = x;
+					ts->last_y = y;
+					goto scanned;
+				}
+			}
+		}
+scanned:	;
+	}
+
+	if (!ret) {
+		nvt_report(ts, report);
+	} else
+		dev_warn_once(&ts->spi->dev, "report read failed: %d; retrying\n", ret);
+	schedule_delayed_work(&ts->poll, msecs_to_jiffies(NVT_POLL_MS));
+}
+
+static ssize_t report_count_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+	return sysfs_emit(buf, "%d\n", atomic_read(&ts->report_count));
+}
+static DEVICE_ATTR_RO(report_count);
+
+/* Raw bytes of the last report the controller returned, so a silent touchscreen
+ * can be told apart from a report-buffer protocol problem without a debugger. */
+static ssize_t last_report_show(struct device *dev, struct device_attribute *attr,
+				char *buf)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+	int i, n = 0;
+
+	n += sysfs_emit(buf, "nonzero=%u ", ts->nonzero_reports);
+	for (i = 0; i < NVT_REPORT_LEN; i++)
+		n += sysfs_emit_at(buf, n, "%02x ", ts->last_report[i]);
+	n += sysfs_emit_at(buf, n, "\n");
+	return n;
+}
+static DEVICE_ATTR_RO(last_report);
+
+static ssize_t acks_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", ts->acks);
+}
+static DEVICE_ATTR_RO(acks);
+
+static ssize_t valid_reports_show(struct device *dev, struct device_attribute *attr,
+				  char *buf)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", ts->valid_reports);
+}
+static DEVICE_ATTR_RO(valid_reports);
+
+static ssize_t finger_show(struct device *dev, struct device_attribute *attr,
+			   char *buf)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "off=%u slot=%u x=%u y=%u\n", ts->last_off,
+			  ts->last_slot, ts->last_x, ts->last_y);
+}
+static DEVICE_ATTR_RO(finger);
+
+static ssize_t matrix_show(struct device *dev, struct device_attribute *attr,
+			   char *buf)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "abs=%u hot=%u irq=%u\n", ts->matrix_abs,
+			  ts->matrix_hot, ts->irq_count);
+}
+static DEVICE_ATTR_RO(matrix);
+
+static ssize_t contacts_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", ts->contacts);
+}
+static DEVICE_ATTR_RO(contacts);
+
+/* Address scanner: "echo <hex addr> > read_addr; cat read_addr" dumps up to 128
+ * bytes of controller memory, so a payload region can be located empirically. */
+static u8 dump_buf[128];
+static size_t dump_len;
+
+static ssize_t read_addr_store(struct device *dev, struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+	u32 addr, len = 64;
+
+	if (sscanf(buf, "%x %x", &addr, &len) < 1)
+		return -EINVAL;
+	if (len > sizeof(dump_buf))
+		len = sizeof(dump_buf);
+	if (nvt_read_mapped(ts, addr, dump_buf, len))
+		return -EIO;
+	dump_len = len;
+	return count;
+}
+
+static ssize_t read_addr_show(struct device *dev, struct device_attribute *attr,
+			      char *buf)
+{
+	int i, n = 0;
+
+	for (i = 0; i < dump_len; i++)
+		n += sysfs_emit_at(buf, n, "%02x ", dump_buf[i]);
+	n += sysfs_emit_at(buf, n, "\n");
+	return n;
+}
+static DEVICE_ATTR_RW(read_addr);
+static struct attribute *nvt_attrs[] = { &dev_attr_report_count.attr,
+					 &dev_attr_last_report.attr,
+					 &dev_attr_read_addr.attr,
+					 &dev_attr_acks.attr,
+					 &dev_attr_valid_reports.attr,
+					 &dev_attr_finger.attr,
+					 &dev_attr_matrix.attr,
+					 &dev_attr_contacts.attr, NULL };
+static const struct attribute_group nvt_attr_group = { .attrs = nvt_attrs };
+
+static int nvt_probe(struct spi_device *spi)
+{
+	struct nvt_ts *ts;
+	struct input_dev *input;
+	u8 id[6] = {0};
+	int ret;
+
+	ts = devm_kzalloc(&spi->dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+	ts->spi = spi;
+	spi_set_drvdata(spi, ts);
+
+	spi->bits_per_word = 8;
+	spi->mode = SPI_MODE_0;
+	ret = spi_setup(spi);
+	if (ret)
+		return dev_err_probe(&spi->dev, ret, "spi_setup\n");
+
+	/* Vendor nvt_bootloader_reset() is a raw two-byte write of {0x00, 0x5a}
+	 * to the controller's hardware address, not a page-mapped register write;
+	 * the page form left the chip answering reads in state 0xb9 and never
+	 * running its firmware (fw reset state 0xb9 after 101 polls). */
+	if (!no_reset) {
+		/* vendor nvt_bootloader_reset(): SWRST_N8 <- 0x69, then
+		 * nvt_write_addr(SPI_RD_FAST_ADDR, 0x00) */
+		ret = nvt_write_addr(ts, NVT_SWRST_N8_ADDR, NVT_SWRST_N8_BOOT);
+		if (ret)
+			return dev_err_probe(&spi->dev, ret, "swrst-n8 boot write\n");
+		mdelay(5);
+	} else {
+		dev_info(&spi->dev, "reset skipped (no_reset=1)\n");
+	}
+
+	/* the normal register read path, not the "read fast" one */
+	ret = nvt_write_addr(ts, NVT_SPI_RD_FAST_ADDR, 0x00);
+	if (ret)
+		dev_warn(&spi->dev, "read-fast disable failed: %d\n", ret);
+
+	/* the controller boots its own firmware; ask it who it is */
+	ret = nvt_read_id(ts, id, sizeof(id));
+	if (ret) {
+		dev_err(&spi->dev, "chip id read failed: %d\n", ret);
+		return ret;
+	}
+	dev_info(&spi->dev, "NT36672C id %*ph\n", (int)sizeof(id), id);
+
+	/* vendor trim id table: {0x0c,..,0x72,0x66,0x03} and {..,0x75,0x66,0x03}
+	 * are the NT36675 map, everything else we know uses the NT36672A map */
+	if (id[3] == 0x72 && id[4] == 0x66 && id[5] == 0x03 && id[0] == 0x0c)
+		ts->event_buf = NVT_EVENT_BUF_36675;
+	else if (id[4] == 0x66 && id[5] == 0x03)
+		ts->event_buf = NVT_EVENT_BUF_36672A;
+	else
+		ts->event_buf = NVT_EVENT_BUF_DEFAULT;
+	ts->have_event_buf = true;
+	/* Only the measured NT36675 map with hw_crc=2 is supported. */
+	if (ts->event_buf != NVT_EVENT_BUF_36675)
+		return -ENODEV;
+	/* The controller shares the display's TDDI reset (vendor DT:
+	 * novatek,reset-tddi = <&pm8150l_gpios 3 0>, and nvt_ts_resume insists the
+	 * panel reset and DSI commands come first). The panel driver pulses that
+	 * reset when it prepares, which happens after this probe, so wait for the
+	 * panel before uploading - otherwise the chip is reset out of its freshly
+	 * loaded firmware and stays in the ReK calibration state forever. */
+	msleep(8000);
+	/*
+	 * Drive the controller's own reset (vendor: novatek,reset-gpio = tlmm 4).
+	 * The panel's TDDI reset is a different line; without this pulse the chip
+	 * answers register reads but never starts reporting contacts.
+	 */
+	ts->reset_gpio = devm_gpiod_get_optional(&spi->dev, "reset", GPIOD_OUT_LOW);
+	if (ts->reset_gpio) {
+		gpiod_set_value_cansleep(ts->reset_gpio, 1);	/* assert (active low) */
+		msleep(10);
+		gpiod_set_value_cansleep(ts->reset_gpio, 0);	/* release */
+		msleep(5);
+		dev_info(&spi->dev, "controller reset pulsed\n");
+	}
+	ret = nvt_upload(ts);
+	if (ret)
+		return dev_err_probe(&spi->dev, ret, "SRAM firmware upload failed\n");
+
+
+	/* The vendor's probe does the same three steps here; skipping them is
+	 * what left the controller answering register reads but never scanning
+	 * (no report ever reached the input device):
+	 *   nvt_check_fw_reset_state(RESET_STATE_INIT)  then  nvt_get_fw_info()
+	 */
+	{
+		u8 st = 0;
+		int i, ready = 0;
+
+		for (i = 0; i < 100; i++) {
+			mdelay(10);
+			if (nvt_read_mapped(ts, ts->event_buf | NVT_MAP_RESET_COMPLETE,
+					    &st, 1))
+				continue;
+			if (st >= NVT_RESET_STATE_INIT && st <= NVT_RESET_STATE_MAX) {
+				ready = 1;
+				break;
+			}
+		}
+		dev_info(&spi->dev, "fw reset state 0x%02x after %d polls (%s)\n",
+			 st, i + 1, ready ? "fw running" : "NOT running");
+		if (!ready) {
+			u8 raw = 0;
+
+			if (!nvt_read_mapped(ts, NVT_SWRST_N8_ADDR, &raw, 1))
+				dev_info(&spi->dev, "swrst-n8 reads 0x%02x\n", raw);
+		}
+
+		{
+			u8 crc[9] = {0};
+			int err = nvt_read_mapped(ts, 0x3f133, crc, 1);
+
+			dev_info(&spi->dev, "boot CRC flags=%#x read=%d\n", crc[0], err);
+			if (!nvt_read_mapped(ts, 0x3f120, crc, 8))
+				dev_info(&spi->dev, "boot CRC result ILM=%#x DLM=%#x\n",
+					 get_unaligned_le32(crc), get_unaligned_le32(crc + 4));
+		}
+		if (!ready)
+			return -ETIMEDOUT;
+
+		if (ready) {
+			u8 info[17] = {0};
+
+			if (nvt_read_mapped(ts, ts->event_buf | NVT_MAP_FWINFO,
+					    info, sizeof(info)) == 0) {
+				u16 xmax = (info[4] << 8) | info[5];
+				u16 ymax = (info[6] << 8) | info[7];
+
+				dev_info(&spi->dev,
+					 "fw info: ver 0x%02x (~0x%02x) x_num %u y_num %u abs %ux%u\n",
+					 info[0], info[1], info[2], info[3], xmax, ymax);
+				if ((u8)(info[0] + info[1]) != 0xff)
+					dev_warn(&spi->dev, "fw info is broken\n");
+			} else {
+				dev_warn(&spi->dev, "fw info read failed\n");
+			}
+		}
+	}
+
+	input = devm_input_allocate_device(&spi->dev);
+	if (!input)
+		return -ENOMEM;
+	ts->input = input;
+	input->name = "Novatek NT36672C Touchscreen";
+	input->id.bustype = BUS_SPI;
+
+	input_set_abs_params(input, ABS_MT_POSITION_X, 0, 1079, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_Y, 0, 2399, 0, 0);
+	input_set_abs_params(input, ABS_MT_PRESSURE, 0, 0xff, 0, 0);
+	input_set_abs_params(input, ABS_MT_TOUCH_MAJOR, 0, 0xff, 0, 0);
+	input_set_capability(input, EV_KEY, BTN_TOUCH);
+	ret = input_mt_init_slots(input, NVT_MAX_FINGERS,
+				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return dev_err_probe(&spi->dev, ret, "input_mt_init_slots\n");
+	atomic_set(&ts->report_count, 0);
+	ret = devm_device_add_group(&spi->dev, &nvt_attr_group);
+	if (ret)
+		return ret;
+	ret = input_register_device(input);
+	if (ret)
+		return dev_err_probe(&spi->dev, ret, "input_register_device\n");
+
+	if (spi->irq > 0) {
+		if (!devm_request_threaded_irq(&spi->dev, spi->irq, nvt_irq,
+					       nvt_irq_thread,
+					       IRQF_ONESHOT | IRQF_TRIGGER_LOW,
+					       "picasso-nvt", ts))
+			dev_info(&spi->dev, "irq %d requested\n", spi->irq);
+	}
+	INIT_DELAYED_WORK(&ts->poll, nvt_poll_work);
+	schedule_delayed_work(&ts->poll, msecs_to_jiffies(200));
+
+	dev_info(&spi->dev, "ready, event buffer %#x, polling every %d ms\n",
+		 ts->event_buf, NVT_POLL_MS);
+	return 0;
+}
+
+static void nvt_remove(struct spi_device *spi)
+{
+	struct nvt_ts *ts = spi_get_drvdata(spi);
+
+	cancel_delayed_work_sync(&ts->poll);
+}
+
+static int nvt_suspend(struct device *dev)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+
+	cancel_delayed_work_sync(&ts->poll);
+	return 0;
+}
+
+static int nvt_resume(struct device *dev)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+	int ret;
+
+	ret = nvt_upload(ts);
+	dev_info(dev, "resume SRAM reinit ret=%d (partition/reset details above)\n", ret);
+	if (ret)
+		return ret;
+	schedule_delayed_work(&ts->poll, msecs_to_jiffies(200));
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(nvt_pm_ops, nvt_suspend, nvt_resume);
+
+static const struct spi_device_id nvt_id[] = {
+	{ "picasso-nvt-ts-spi", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, nvt_id);
+
+static const struct of_device_id nvt_of_match[] = {
+	{ .compatible = "xiaomi,picasso-nvt-ts-spi" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nvt_of_match);
+
+static struct spi_driver nvt_driver = {
+	.driver = {
+		.name = "picasso-nvt-ts",
+		.of_match_table = nvt_of_match,
+		.pm = pm_sleep_ptr(&nvt_pm_ops),
+	},
+	.id_table = nvt_id,
+	.probe = nvt_probe,
+	.remove = nvt_remove,
+};
+module_spi_driver(nvt_driver);
+
+MODULE_DESCRIPTION("Novatek NT36672C SPI touchscreen (Xiaomi Redmi K30 5G)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/input/touchscreen/picasso-nvt-vendor.c b/drivers/input/touchscreen/picasso-nvt-vendor.c
new file mode 100644
index 000000000..2a68e6a49
--- /dev/null
+++ b/drivers/input/touchscreen/picasso-nvt-vendor.c
@@ -0,0 +1,1243 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Novatek NT36672C touchscreen on the Xiaomi Redmi K30 5G (picasso, SM7250):
+ * port of the downstream Novatek core to mainline Linux.
+ *
+ * Ported from the 4.19 vendor driver (Novatek "$Revision: 32206 $", XiaoMi
+ * 2021) in drivers/input/touchscreen/nt36672c/ of the downstream tree:
+ *   nt36xxx.c          probe, eng/bootloader reset, chip id trim, firmware
+ *                      status waits, fw info, IRQ work function, suspend/resume
+ *   nt36xxx_fw_update.c host SRAM download, bin header parser, BLD hw CRC
+ *                      staging, boot ready, per-partition write
+ *   nt36xxx_mem_map.h  memory map and trim id table (NT36675, NT36672A)
+ *   nt36xxx.h          event map offsets, SPI masks, swrst/read-fast addrs
+ *
+ * Dropped (Android/Xiaomi-only, no mainline equivalent in this tree): procfs
+ * and debugfs nodes, MP/selftest/limit data, gesture and double tap, palm
+ * sensor, Xiaomi touchfeature modes, DRM/fb notifiers and earlysuspend,
+ * lockdown info (panel -> firmware selection), ESD/WDT recovery workqueues,
+ * tp_common, IRQ boosting and LPM votes.
+ *
+ * Kept verbatim because it is what works on this phone: page select is the
+ * 3-byte write {0xff, addr >> 15, addr >> 7}; a write is one command byte
+ * with bit 7 set followed by data; a read transfers two bytes more than the
+ * payload and the payload starts at rx[2].  The controller runs host-downloaded
+ * SRAM firmware and shares the panel's TDDI reset (pm8150l gpio3), so the
+ * download is deferred until after the panel has been prepared (vendor does
+ * the same from a workqueue 14 s after probe).
+ *
+ * Test on hardware (RAM boot only, this driver never writes storage):
+ *   ./build.sh linux && ./build.sh loader && ./build.sh bootimg   # needs
+ *   UEFI_FD/BOOTSHIM/UEFI_DTB; then `fastboot boot build/out/boot-linux.img`
+ *   dmesg | grep -iE 'spi1\.0|novatek' expects, in order:
+ *     "mode 0, 5000000 Hz"
+ *     "chip id 0c 00 00 72 66 03"            (the g7a panel's NT36675)
+ *     "NT3667x at event buffer 0x22d00, hw crc 2"
+ *     "novatek_nt36672c_g7a_fw01.bin: .. partitions"
+ *     "SRAM partition 0: sram 0x0 size .." / "partition 1: sram 0x27140 .."
+ *     "fw reset state 0xa0.." then "fw info: ver .. abs 1080x2400"
+ *     "ready: event buffer 0x22d00, polling every 20 ms"
+ *   /sys/class/input/eventN/device/name = NVTCapacitiveTouchScreen, and
+ *   evtest reports BTN_TOUCH + ABS_MT_POSITION_X/Y on a touch.  Add
+ *   picasso_nvt_vendor.debug=1 on the cmdline to log every report read.
+ */
+#include <linux/delay.h>
+#include <linux/picasso-g7a.h>
