+/* ---------------------------------------------------------------- SPI core */
+
+/* Send whatever ts->tx already holds as a write: the first byte is the offset
+ * and gets bit 7 set, the controller increments the address after it. */
+static int nvt_tx_send(struct nvt_ts *ts, size_t len)
+{
+	int ret = -EIO, i;
+
+	ts->tx[0] |= NVT_WRITE_MASK;
+	for (i = 0; i < NVT_RETRIES; i++) {
+		ret = spi_write(ts->spi, ts->tx, len);
+		if (!ret)
+			return 0;
+	}
+	ts->page_valid = false;
+	dev_err(&ts->spi->dev, "spi write of %zu bytes failed: %d\n", len, ret);
+	return -EIO;
+}
+
+static int nvt_spi_write(struct nvt_ts *ts, const u8 *buf, size_t len)
+{
+	if (len > NVT_WRITE_CHUNK + 1)
+		return -EINVAL;
+	memcpy(ts->tx, buf, len);
+	return nvt_tx_send(ts, len);
+}
+
+/* Read: two more bytes on the wire than the payload, payload at rx[2]. */
+static int nvt_spi_read(struct nvt_ts *ts, u32 addr, u8 *dst, size_t len)
+{
+	struct spi_transfer xfer = {
+		.tx_buf = ts->tx,
+		.rx_buf = ts->rx,
+		.len = len + 2,
+	};
+	int ret = -EIO, i;
+
+	if (len + 2 > NVT_XFER_MAX + 2)
+		return -EINVAL;
+	memset(ts->tx, 0, len + 2);
+	ts->tx[0] = addr & NVT_READ_MASK;
+	for (i = 0; i < NVT_RETRIES; i++) {
+		ret = spi_sync_transfer(ts->spi, &xfer, 1);
+		if (!ret)
+			break;
+	}
+	if (ret) {
+		ts->page_valid = false;
+		dev_err(&ts->spi->dev, "spi read of %zu bytes at %#x failed: %d\n",
+			len, addr, ret);
+		return -EIO;
+	}
+	memcpy(dst, ts->rx + 2, len);
+	return 0;
+}
+
+static int nvt_set_page(struct nvt_ts *ts, u32 addr)
+{
+	u32 page_id = (addr >> 7) & 0xffff;
+	u8 page[3] = { 0xff, (addr >> 15) & 0xff, (addr >> 7) & 0xff };
+	int ret;
+
+	if (ts->page_valid && ts->cur_page == page_id)
+		return 0;
+
+	ret = nvt_spi_write(ts, page, sizeof(page));
+	if (!ret) {
+		ts->cur_page = page_id;
+		ts->page_valid = true;
+	} else {
+		ts->page_valid = false;
+	}
+	return ret;
+}
+
+static int nvt_write_addr(struct nvt_ts *ts, u32 addr, u8 val)
+{
+	u8 buf[2] = { addr & NVT_READ_MASK, val };
+	int ret;
+
+	ret = nvt_set_page(ts, addr);
+	if (ret)
+		return ret;
+	return nvt_spi_write(ts, buf, sizeof(buf));
+}
+
+static int nvt_read_mapped(struct nvt_ts *ts, u32 addr, u8 *dst, size_t len)
+{
+	int ret;
+
+	ret = nvt_set_page(ts, addr);
+	if (ret)
+		return ret;
+	return nvt_spi_read(ts, addr, dst, len);
+}
+
+static int nvt_read_byte(struct nvt_ts *ts, u32 addr, u8 *val)
+{
+	return nvt_read_mapped(ts, addr, val, 1);
+}
+
+/* Bulk SRAM write: page select, then the offset byte and the payload, one
+ * half page at a time so a burst never crosses a page boundary. */
+static int nvt_write_mapped(struct nvt_ts *ts, u32 addr, const u8 *data,
+			    size_t len)
+{
+	size_t done = 0;
+	int ret;
+
+	while (done < len) {
+		u32 cur = addr + done;
+		/* Never let a burst run past the current 128-byte page. */
+		size_t n = min3(len - done, (size_t)NVT_WRITE_CHUNK,
+				(size_t)(128 - (cur & NVT_READ_MASK)));
+
+		ret = nvt_set_page(ts, cur);
+		if (ret)
+			return ret;
+		ts->tx[0] = cur & NVT_READ_MASK;
+		memcpy(ts->tx + 1, data + done, n);
+		ret = nvt_tx_send(ts, n + 1);
+		if (ret)
+			return ret;
+		done += n;
+	}
+	return 0;
+}
+
+/* --------------------------------------------------------- reset and chips */
+
+static int nvt_eng_reset(struct nvt_ts *ts)
+{
+	int ret;
+
+	ts->page_valid = false;
+	/* Vendor holds TP_RESX low around the engineering reset. */
+	if (ts->reset_gpio) {
+		gpiod_set_value_cansleep(ts->reset_gpio, 1);
+		mdelay(1);
+	}
+	ret = nvt_write_addr(ts, NVT_ENG_RST_ADDR, NVT_ENG_RST_VAL);
+	if (ts->reset_gpio) {
+		gpiod_set_value_cansleep(ts->reset_gpio, 0);
+		mdelay(10);	/* tRT2BRST */
+	}
+	ts->page_valid = false;
+	return ret;
+}
+
+/* nvt_bootloader_reset(): park the MCU in the bootloader and turn the SPI
+ * read-fast path off, which is required before host SRAM writes. */
+static int nvt_bootloader_reset(struct nvt_ts *ts)
+{
+	int ret;
+
+	ts->page_valid = false;
+	ret = nvt_write_addr(ts, ts->swrst_n8_addr, NVT_SWRST_BOOT);
+	if (ret)
+		return ret;
+	mdelay(5);		/* tBRST2FR */
+	ts->page_valid = false;
+	if (ts->spi_rd_fast_addr)
+		return nvt_write_addr(ts, ts->spi_rd_fast_addr, 0x00);
+	return 0;
+}
+
+static int nvt_check_fw_reset_state(struct nvt_ts *ts, u8 want)
+{
+	u8 buf[5] = { 0 };
+	int i, ret = -ETIMEDOUT;
+
+	for (i = 0; i < 50; i++) {
+		ret = nvt_read_mapped(ts, ts->map->event_buf | NVT_EVENT_RESET_STATE,
+				      buf, sizeof(buf));
+		if (ret)
+			break;
+		if (buf[0] >= want && buf[0] <= NVT_STATE_MAX) {
+			ret = 0;
+			break;
+		}
+		usleep_range(10000, 10000);
+	}
+	if (ret)
+		dev_err(&ts->spi->dev,
+			"fw reset state 0x%02x after %d polls (5 bytes: %*ph)\n",
+			buf[0], i + 1, 5, buf);
+	else
+		dev_info(&ts->spi->dev, "fw reset state 0x%02x after %d polls\n",
+			 buf[0], i + 1);
+	return ret;
+}
+
+static const struct nvt_mem_map *nvt_check_chip_id(struct nvt_ts *ts, u8 *id)
+{
+	unsigned int retry, list, i;
+	int ret;
+
+	for (retry = 0; retry < 5; retry++) {
+		ret = nvt_bootloader_reset(ts);
+		if (ret)
+			continue;
+		ret = nvt_read_mapped(ts, NVT_CHIP_ID_ADDR | NVT_CHIP_ID_OFFSET,
+				      id, NVT_ID_BYTE_MAX);
+		if (ret)
+			continue;
+		dev_info(&ts->spi->dev, "chip id %*ph\n", NVT_ID_BYTE_MAX, id);
+		for (list = 0; list < ARRAY_SIZE(nvt_trim_ids); list++) {
+			const struct nvt_trim_id *t = &nvt_trim_ids[list];
+
+			for (i = 0; i < NVT_ID_BYTE_MAX; i++) {
+				if (t->mask[i] && id[i] != t->id[i])
+					break;
+			}
+			if (i == NVT_ID_BYTE_MAX)
+				return t->map;
+		}
+		msleep(10);
+	}
+	return NULL;
+}
+
+static int nvt_get_fw_info(struct nvt_ts *ts)
+{
+	u8 buf[17], pid[2] = { 0 };
+	u32 xmax, ymax;
+	int ret;
+
+	ret = nvt_read_mapped(ts, ts->map->event_buf | NVT_EVENT_FWINFO, buf,
+			      sizeof(buf));
+	if (ret)
+		return ret;
+	if ((u8)(buf[0] + buf[1]) != 0xff) {
+		dev_err(&ts->spi->dev, "fw info is broken (0x%02x/0x%02x)\n",
+			buf[0], buf[1]);
+		return -EIO;
+	}
+	xmax = (buf[4] << 8) | buf[5];
+	ymax = (buf[6] << 8) | buf[7];
+	dev_info(&ts->spi->dev,
+		 "fw info: ver 0x%02x x_num %u y_num %u abs %ux%u type 0x%02x\n",
+		 buf[0], buf[2], buf[3], xmax, ymax, buf[13]);
+	/* The input device is registered with the panel's geometry before this
+	 * runs (the download must follow the panel prepare), so a different
+	 * firmware range would silently clip reports. */
+	if (xmax && ymax && (xmax != ts->abs_x_max || ymax != ts->abs_y_max))
+		dev_warn(&ts->spi->dev,
+			 "fw reports %ux%u, input device stays %ux%u\n",
+			 xmax, ymax, ts->abs_x_max, ts->abs_y_max);
+	if (nvt_read_mapped(ts, ts->map->event_buf | NVT_EVENT_PROJECTID, pid,
+			    sizeof(pid)) == 0)
+		dev_info(&ts->spi->dev, "project id 0x%04x\n",
+			 (pid[1] << 8) | pid[0]);
+	return 0;
+}
+
+/* -------------------------------------------------------- firmware download */
+
+/* nvt_get_fw_need_write_size(): the image ends with "NVT" or "MOD" in the
+ * last three bytes of its final 4 KiB sector. */
+static int nvt_fw_write_size(struct nvt_fw *fw)
+{
+	size_t sectors = fw->file->size / 4096;
+	size_t i;
+
+	for (i = sectors; i > 0; i--) {
+		const u8 *end = fw->file->data + i * 4096 - 3;
+
+		if (!strncmp(end, "NVT", 3) || !strncmp(end, "MOD", 3)) {
+			fw->write_size = i * 4096;
+			return 0;
+		}
+	}
+	return -EINVAL;
+}
+
+/* nvt_bin_header_parser(): ILM/DLM header at 0, then 16-byte info sections
+ * starting at 0x30, then overlay sections that live at the DLM image start. */
+static int nvt_fw_parse(struct nvt_fw *fw)
+{
+	const u8 *data = fw->file->data;
+	size_t fwsize = fw->file->size;
+	unsigned int info_sec_num, ovly_sec_num, i;
+	u32 end, pos;
+
+	if (fwsize < 0x30)
+		return -EINVAL;
+	end = get_unaligned_le32(data);
+	if (end < 0x30 || end > fwsize || (end - 0x30) % 0x10)
+		return -EINVAL;
+	info_sec_num = (end - 0x30) / 0x10;
+	ovly_sec_num = (data[0x28] & 0x10) ? (data[0x28] & 0x0f) : 0;
+	fw->partitions = 2 + info_sec_num + ovly_sec_num;
+	if (fw->partitions > NVT_MAX_PARTITIONS)
+		return -EINVAL;
+
+	for (i = 0; i < fw->partitions; i++) {
+		struct nvt_bin *b = &fw->bin[i];
+
+		if (i < 2) {
+			b->bin = get_unaligned_le32(data + i * 12);
+			b->sram = get_unaligned_le32(data + i * 12 + 4);
+			b->size = get_unaligned_le32(data + i * 12 + 8);
+			b->crc = get_unaligned_le32(data + 0x18 + i * 4);
+		} else if (i < 2 + info_sec_num) {
+			pos = 0x30 + (i - 2) * 0x10;
+			b->sram = get_unaligned_le32(data + pos);
+			b->size = get_unaligned_le32(data + pos + 4);
+			b->bin = get_unaligned_le32(data + pos + 8);
+			b->crc = get_unaligned_le32(data + pos + 12);
+		} else {
+			pos = fw->bin[1].bin + (i - 2 - info_sec_num) * 0x10;
+			if (pos > fwsize - 0x10)
+				return -EINVAL;
+			b->sram = get_unaligned_le32(data + pos);
+			b->size = get_unaligned_le32(data + pos + 4);
+			b->bin = get_unaligned_le32(data + pos + 8);
+			b->crc = get_unaligned_le32(data + pos + 12);
+		}
+		if (b->size && (b->bin > fwsize ||
+				b->size + 1 > fwsize - b->bin))
+			return -EINVAL;
+	}
+	return 0;
+}
+
+/* Destination, length and golden CRC all live in the same 0x3f100 page, so
+ * the vendor selects that page once (through DES_ADDR) and then addresses the
+ * three fields by their in-page offset. */
+static int nvt_set_bld_crc_bank(struct nvt_ts *ts, u32 des_addr,
+				u32 sram_addr, u32 len_addr, u32 size,
+				u32 golden_addr, u32 crc)
+{
+	u8 addr[3] = { sram_addr, sram_addr >> 8, sram_addr >> 16 };
+	u8 lenb[4] = { size, size >> 8, size >> 16, (size >> 16) & 1 };
+	u8 gold[4] = { crc, crc >> 8, crc >> 16, crc >> 24 };
+	size_t lenlen = ts->map->hw_crc > 1 ? sizeof(lenb) : 3;
+	u8 buf[sizeof(gold) + 1];
+	int ret;
+
+	ret = nvt_set_page(ts, des_addr);
+	if (ret)
+		return ret;
+
+	buf[0] = des_addr & NVT_READ_MASK;
+	memcpy(buf + 1, addr, sizeof(addr));
+	ret = nvt_spi_write(ts, buf, sizeof(addr) + 1);
+	if (ret)
+		return ret;
+
+	buf[0] = len_addr & NVT_READ_MASK;
+	memcpy(buf + 1, lenb, lenlen);
+	ret = nvt_spi_write(ts, buf, lenlen + 1);
+	if (ret)
+		return ret;
+
+	buf[0] = golden_addr & NVT_READ_MASK;
+	memcpy(buf + 1, gold, sizeof(gold));
+	return nvt_spi_write(ts, buf, sizeof(gold) + 1);
+}
+
+static int nvt_set_bld_hw_crc(struct nvt_ts *ts, const struct nvt_fw *fw)
+{
+	int ret;
+
+	ret = nvt_set_bld_crc_bank(ts, ts->map->ilm_des, fw->bin[0].sram,
+				   ts->map->ilm_len, fw->bin[0].size,
+				   ts->map->g_ilm_crc, fw->bin[0].crc);
+	if (ret)
+		return ret;
+	return nvt_set_bld_crc_bank(ts, ts->map->dlm_des, fw->bin[1].sram,
+				    ts->map->dlm_len, fw->bin[1].size,
+				    ts->map->g_dlm_crc, fw->bin[1].crc);
+}
+
+static void nvt_log_hw_crc(struct nvt_ts *ts, const struct nvt_fw *fw)
+{
+	u8 flag = 0, crc[8];
+	u32 r_ilm = 0, r_dlm = 0;
+
+	if (!ts->map->hw_crc)
+		return;
+	if (nvt_read_byte(ts, ts->map->bld_ilm_dlm_crc, &flag))
+		return;
+	if (!nvt_read_mapped(ts, ts->map->r_ilm_crc, crc, sizeof(crc))) {
+		r_ilm = get_unaligned_le32(crc);
+		r_dlm = get_unaligned_le32(crc + 4);
+	}
+	/* The result registers are diagnostic only: this part reports a DLM
+	 * sum that differs from the image header even when every SRAM byte
+	 * matches the file, so the download is not gated on it. */
+	dev_info(&ts->spi->dev,
+		 "boot crc flags %#04x: ilm file %#x read %#x, dlm file %#x read %#x\n",
+		 flag, fw->bin[0].crc, r_ilm, fw->bin[1].crc, r_dlm);
+}
+
+static int nvt_bld_crc_enable(struct nvt_ts *ts)
+{
+	u8 val;
+	int ret;
+
+	ret = nvt_read_byte(ts, ts->map->bld_crc_en, &val);
+	if (ret)
+		return ret;
+	return nvt_write_addr(ts, ts->map->bld_crc_en, val | 0x80);
+}
+
+/* Clear the fw reset status and let the fw verify the downloaded image. */
+static int nvt_fw_crc_enable(struct nvt_ts *ts)
+{
+	int ret;
+
+	ret = nvt_write_addr(ts, ts->map->event_buf | NVT_EVENT_RESET_STATE, 0);
+	if (ret)
+		return ret;
+	return nvt_write_addr(ts, ts->map->event_buf | NVT_EVENT_HOST_CMD, 0xae);
+}
+
+static int nvt_boot_ready(struct nvt_ts *ts)
+{
+	int ret;
+
+	ret = nvt_write_addr(ts, ts->map->boot_rdy, 1);
+	if (ret)
+		return ret;
+	mdelay(5);
+	return 0;
+}
+
+static int nvt_download_firmware(struct nvt_ts *ts, const struct firmware *file)
+{
+	struct nvt_fw fw = { .file = file };
+	unsigned int attempt, i;
+	int ret;
+
+	ret = nvt_fw_write_size(&fw);
+	if (ret) {
+		dev_err(&ts->spi->dev, "%s: no NVT/MOD end flag\n", ts->fw_name);
+		return ret;
+	}
+	if ((u8)(file->data[fw.write_size - 4096] +
+		  file->data[fw.write_size - 4095]) != 0xff) {
+		dev_err(&ts->spi->dev, "%s: fw version/bar mismatch\n",
+			ts->fw_name);
+		return -ENOEXEC;
+	}
+	ret = nvt_fw_parse(&fw);
+	if (ret) {
+		dev_err(&ts->spi->dev, "%s: bin header parse failed\n",
+			ts->fw_name);
+		return ret;
+	}
+	dev_info(&ts->spi->dev,
+		 "%s: %zu of %zu bytes, %u partitions, hw crc %u\n",
+		 ts->fw_name, fw.write_size, file->size, fw.partitions,
+		 ts->map->hw_crc);
+
+	for (attempt = 1; attempt <= 3; attempt++) {
+		ret = nvt_bootloader_reset(ts);
+		if (ret)
+			continue;
+		if (!ts->map->hw_crc)
+			nvt_write_addr(ts, ts->map->event_buf | NVT_EVENT_RESET_STATE,
+				       0);
+
+		for (i = 0; i < fw.partitions; i++) {
+			const struct nvt_bin *b = &fw.bin[i];
+
+			if (!b->size)
+				continue;
+			/* Vendor writes size + 1 bytes per partition. */
+			ret = nvt_write_mapped(ts, b->sram, file->data + b->bin,
+					       b->size + 1);
+			if (ret)
+				break;
+			dev_info(&ts->spi->dev,
+				 "SRAM partition %u: sram %#x size %u (file %#x)\n",
+				 i, b->sram, b->size + 1, b->bin);
+		}
+		if (ret)
+			continue;
+		if (ts->map->hw_crc) {
+			ret = nvt_set_bld_hw_crc(ts, &fw);
+			if (ret)
+				continue;
+			nvt_bld_crc_enable(ts);
+			nvt_fw_crc_enable(ts);
+		}
+		ret = nvt_boot_ready(ts);
+		if (ret)
+			continue;
+		ret = nvt_check_fw_reset_state(ts, NVT_STATE_INIT);
+		nvt_log_hw_crc(ts, &fw);
+		if (!ret)
+			break;
+		dev_err(&ts->spi->dev, "download attempt %u/3 failed: %d\n",
+			attempt, ret);
+	}
+	return ret;
+}
+
+static int nvt_update_firmware(struct nvt_ts *ts)
+{
+	const struct firmware *file;
+	int ret;
+
+	ret = request_firmware(&file, ts->fw_name, &ts->spi->dev);
+	if (ret) {
+		dev_err(&ts->spi->dev, "firmware %s not available: %d\n",
+			ts->fw_name, ret);
+		return ret;
+	}
+	ret = nvt_download_firmware(ts, file);
+	release_firmware(file);
+	if (ret)
+		return ret;
+	/* Vendor only logs a failed fw-info read; the download already
+	 * confirmed the image by reaching the reset-state window. */
+	nvt_get_fw_info(ts);
+	return 0;
+}
+
+/* ------------------------------------------------------------ touch reports */
+
+static int nvt_read_report(struct nvt_ts *ts, u8 *point)
+{
+	int ret;
+
+	ret = nvt_read_mapped(ts, ts->map->event_buf, point,
+			      NVT_POINT_DATA_LEN);
+	if (ret)
+		return ret;
+	if (debug || (!ts->dumped && memchr_inv(point, 0, NVT_POINT_DATA_LEN))) {
+		dev_info(&ts->spi->dev, "report: %*ph\n", NVT_POINT_DATA_LEN,
+			 point);
+		ts->dumped = true;
+	}
+	return 0;
+}
+
+/* Emit MT protocol B from the ten 6-byte records, which start at byte 0 of
+ * the pipe: status in bits 2:0 (1 down, 2 move, 3 up), slot in bits 7:3,
+ * x/y split across three bytes. An empty slot reads 0xff, i.e. status 7 and
+ * slot 31, which the range checks below drop. */
+static void nvt_report_touch(struct nvt_ts *ts, const u8 *point)
+{
+	struct input_dev *input = ts->input;
+	u16 x[NVT_MAX_FINGERS], y[NVT_MAX_FINGERS];
+	u32 slots = 0;
+	int i, s;
+
+	for (i = 0; i < NVT_MAX_FINGERS; i++) {
+		const u8 *p = point + 6 * i;
+		unsigned int status = p[0] & 0x07;
+		unsigned int slot = p[0] >> 3;
+		unsigned int px, py;
+
+		if (!slot || slot > NVT_MAX_FINGERS)
+			continue;
+		if (status != 0x01 && status != 0x02)
+			continue;
+		px = (p[1] << 4) | (p[3] >> 4);
+		py = (p[2] << 4) | (p[3] & 0x0f);
+		if (px >= ts->abs_x_max || py >= ts->abs_y_max)
+			continue;
+		s = slot - 1;
+		slots |= BIT(s);
+		x[s] = px;
+		y[s] = py;
+	}
+
+	/* The poll re-reads the same record set up to 50 times a second and the
+	 * interrupt reads it too, so only forward a real change.  Empty
+	 * SYN_REPORTs would otherwise reach every evdev client - and stop an
+	 * idle phone from staying idle. */
+	if (slots == ts->slots) {
+		for (s = 0; s < NVT_MAX_FINGERS; s++) {
+			if ((slots & BIT(s)) &&
+			    (x[s] != ts->last_x[s] || y[s] != ts->last_y[s]))
+				break;
+		}
+		if (s == NVT_MAX_FINGERS)
+			return;
+	}
+	ts->slots = slots;
+
+	for (s = 0; s < NVT_MAX_FINGERS; s++) {
+		if (!(slots & BIT(s)))
+			continue;
+		ts->last_x[s] = x[s];
+		ts->last_y[s] = y[s];
+		ts->contacts++;
+		input_mt_slot(input, s);
+		input_mt_report_slot_state(input, MT_TOOL_FINGER, true);
+		input_report_abs(input, ABS_MT_POSITION_X, x[s]);
+		input_report_abs(input, ABS_MT_POSITION_Y, y[s]);
+	}
+	input_mt_sync_frame(input);
+	input_report_key(input, BTN_TOUCH, slots != 0);
+	ts->report_count++;
+	input_sync(input);
+}
+
+static int nvt_fetch_report(struct nvt_ts *ts)
+{
+	u8 point[NVT_POINT_DATA_LEN];
+	int ret;
+
+	ret = nvt_read_report(ts, point);
+	if (ret)
+		return ret;
+	nvt_report_touch(ts, point);
+	return 0;
+}
+
+static irqreturn_t nvt_irq(int irq, void *data)
+{
+	struct nvt_ts *ts = data;
+
+	ts->irq_count++;
+	return IRQ_WAKE_THREAD;
+}
+
+static irqreturn_t nvt_irq_thread(int irq, void *data)
+{
+	struct nvt_ts *ts = data;
+
+	mutex_lock(&ts->lock);
+	if (!ts->suspended)
+		nvt_fetch_report(ts);
+	mutex_unlock(&ts->lock);
+	return IRQ_HANDLED;
+}
+
+/*
+ * Once the touch IRQ is live, the threaded IRQ handler reads every report at
+ * the controller's full scan rate and the worker only performs idle health
+ * checks so a kworker never contends on ts->lock during active touch.
+ */
+static void nvt_poll_work(struct work_struct *work)
+{
+	struct nvt_ts *ts = container_of(to_delayed_work(work), struct nvt_ts,
+					 poll);
+	unsigned int interval = NVT_POLL_MS;
+	bool check_health = false;
+
+	mutex_lock(&ts->lock);
+	if (!ts->suspended) {
+		if (!ts->irq_count) {
+			nvt_fetch_report(ts);
+			if (!(++ts->polls_since_health % NVT_HEALTH_POLLS))
+				check_health = true;
+		} else {
+			if (!ts->irq_note) {
+				ts->irq_note = true;
+				dev_info(&ts->spi->dev,
+					 "irq is live (%u), health check every %d ms\n",
+					 ts->irq_count, NVT_POLL_MS_IRQ);
+			}
+			if (!ts->slots)
+				check_health = true;
+			interval = NVT_POLL_MS_IRQ;
+		}
+		/*
+		 * Any panel prepare (DPMS on, resume, a blanking cycle) pulses
+		 * the shared TDDI reset and leaves a deaf bootloader behind.
+		 * Notice that here and feed the controller again.
+		 */
+		if (check_health) {
+			u8 st = 0;
+
+			ts->page_valid = false;
+			if (!nvt_read_mapped(ts, ts->map->event_buf |
+					     NVT_EVENT_RESET_STATE, &st, 1) &&
+			    st < NVT_STATE_NORMAL &&
+			    picasso_g7a_panel_prepared() &&
+			    !delayed_work_pending(&ts->bringup)) {
+				dev_info(&ts->spi->dev,
+					 "controller state 0x%02x, rebuilding\n", st);
+				schedule_delayed_work(&ts->bringup,
+						      msecs_to_jiffies(NVT_PANEL_SETTLE_MS));
+			}
+		}
+	}
+	mutex_unlock(&ts->lock);
+	schedule_delayed_work(&ts->poll, msecs_to_jiffies(interval));
+}
+
+/* ------------------------------------------------------- bring-up and PM */
+
+/*
+ * Fired at the end of every panel prepare (boot, DPMS on, resume). That is the
+ * moment the DDIC is out of reset and streaming, and also the moment the
+ * controller lost its firmware to the shared TDDI reset - so rebuild it.
+ */
+static int nvt_panel_prepare(struct notifier_block *nb, unsigned long action,
+			     void *data)
+{
+	struct nvt_ts *ts = container_of(nb, struct nvt_ts, panel_nb);
+
+	if (ts->suspended)
+		return NOTIFY_OK;
+	ts->bringup_attempts = 0;
+	schedule_delayed_work(&ts->bringup, msecs_to_jiffies(NVT_PANEL_SETTLE_MS));
+	return NOTIFY_OK;
+}
+
+/* Runs upload_delay_ms after probe: the panel's prepare resets this chip
+ * through the shared TDDI reset, so firmware loaded earlier is thrown away. */
+static void nvt_bringup_work(struct work_struct *work)
+{
+	struct nvt_ts *ts = container_of(to_delayed_work(work), struct nvt_ts,
+					 bringup);
+	int ret, i;
+	u8 st = 0;
+
+	mutex_lock(&ts->lock);
+	if (ts->suspended)
+		goto out;
+
+	/*
+	 * Panel off means the controller is unpowered or held in the shared
+	 * TDDI reset: every read is 0xff and an upload cannot stick. Wait for
+	 * the panel's prepare event instead of guessing a delay.
+	 */
+	if (!picasso_g7a_panel_prepared()) {
+		schedule_delayed_work(&ts->bringup,
+				      msecs_to_jiffies(NVT_PANEL_GATE_MS));
+		goto out;
+	}
+
+	/* Vendor preamble of nvt_download_firmware(): engineering reset with
+	 * TP_RESX low, then release and wait tRT2BRST. Needed on every attempt,
+	 * including after resume, where the controller sits in deep sleep. */
+	if (ts->reset_gpio) {
+		nvt_eng_reset(ts);
+		dev_info(&ts->spi->dev, "controller reset pulsed\n");
+	}
+
+	ret = nvt_update_firmware(ts);
+	if (ret) {
+		dev_err(&ts->spi->dev, "SRAM firmware upload failed: %d\n", ret);
+		/* upload_delay_ms is a guess at when the panel has finished
+		 * resetting the controller; a miss should not kill the device. */
+		if (++ts->bringup_attempts < NVT_BRINGUP_TRIES) {
+			dev_info(&ts->spi->dev, "retrying the upload in %d ms\n",
+				 NVT_BRINGUP_RETRY_MS);
+			schedule_delayed_work(&ts->bringup,
+					      msecs_to_jiffies(NVT_BRINGUP_RETRY_MS));
+		}
+		goto out;
+	}
+	if (nvt_check_fw_reset_state(ts, NVT_STATE_REK))
+		dev_warn(&ts->spi->dev, "baseline (ReK) not reached yet\n");
+
+	/*
+	 * ReK (0xA1) only means the controller booted. It publishes contact
+	 * reports once it reaches normal run (0xA3) - until then the event
+	 * buffer reads back filled with 0xFD. Wait for 0xA3 before reading.
+	 */
+	for (i = 0; i < NVT_NORMAL_WAIT_MS / 10; i++) {
+		if (!nvt_read_mapped(ts, ts->map->event_buf | NVT_EVENT_RESET_STATE,
+				     &st, 1) && st >= NVT_STATE_NORMAL)
+			break;
+		msleep(10);
+	}
+	dev_info(&ts->spi->dev, "normal run state 0x%02x after %d ms\n",
+		 st, i * 10);
+
+	if (st < NVT_STATE_NORMAL && ++ts->bringup_attempts < NVT_BRINGUP_TRIES) {
+		dev_info(&ts->spi->dev, "still not scanning after the upload\n");
+		schedule_delayed_work(&ts->bringup,
+				      msecs_to_jiffies(NVT_BRINGUP_RETRY_MS));
+		goto out;
+	}
+	ts->bringup_attempts = 0;
+	dev_info(&ts->spi->dev, "ready: event buffer %#x, polling every %d ms\n",
+		 ts->map->event_buf, NVT_POLL_MS);
+	schedule_delayed_work(&ts->poll, msecs_to_jiffies(NVT_POLL_MS));
+out:
+	mutex_unlock(&ts->lock);
+}
+
+static int nvt_suspend(struct device *dev)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+
+	cancel_delayed_work_sync(&ts->poll);
+	mutex_lock(&ts->lock);
+	ts->suspended = true;
+	ts->page_valid = false;
+	/* Vendor: host command 0x11 puts the controller into deep sleep. */
+	nvt_write_addr(ts, ts->map->event_buf | NVT_EVENT_HOST_CMD, 0x11);
+	input_mt_sync_frame(ts->input);
+	input_report_key(ts->input, BTN_TOUCH, false);
+	input_sync(ts->input);
+	ts->slots = 0;		/* the first report after resume re-emits */
+	mutex_unlock(&ts->lock);
+	if (ts->irq_enabled) {
+		disable_irq(ts->spi->irq);
+		ts->irq_enabled = false;
+	}
+	return 0;
+}
+
+static int nvt_resume(struct device *dev)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+
+	mutex_lock(&ts->lock);
+	ts->suspended = false;
+	ts->page_valid = false;
+	ts->bringup_attempts = 0;
+	mutex_unlock(&ts->lock);
+	/*
+	 * nvt_suspend put the controller in deep sleep (host command 0x11), so
+	 * it has to be reset and fed again - and the panel's own resume may
+	 * come after this one, which would reset it once more. Let the bring-up
+	 * worker do it, gated on the panel being prepared.
+	 */
+	schedule_delayed_work(&ts->bringup, msecs_to_jiffies(NVT_PANEL_SETTLE_MS));
+	schedule_delayed_work(&ts->poll, msecs_to_jiffies(NVT_POLL_MS));
+	if (ts->spi->irq > 0 && !ts->irq_enabled) {
+		enable_irq(ts->spi->irq);
+		ts->irq_enabled = true;
+	}
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(nvt_pm_ops, nvt_suspend, nvt_resume);
+
+/* ------------------------------------------------------------- probe/remove */
+
+/*
+ * Observability for bring-up: the controller's reset state, interrupt count and
+ * whether the last report decoded into contacts. These settle, without a
+ * debugger, whether the firmware reached normal run and reports touches.
+ */
+static ssize_t state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nvt_ts *ts = dev_get_drvdata(dev);
+	u8 st = 0;
+
+	nvt_read_mapped(ts, ts->map->event_buf | NVT_EVENT_RESET_STATE, &st, 1);
+	return sysfs_emit(buf, "state=0x%02x irq=%u reports=%u contacts=%u\n",
+			  st, ts->irq_count, ts->report_count, ts->contacts);
+}
+static DEVICE_ATTR_RO(state);
+
+static struct attribute *nvt_attrs[] = { &dev_attr_state.attr, NULL };
+static const struct attribute_group nvt_attr_group = { .attrs = nvt_attrs };
+
+static int nvt_probe(struct spi_device *spi)
+{
+	int ret_group;
+	struct nvt_ts *ts;
+	const struct nvt_mem_map *map;
+	u8 id[NVT_ID_BYTE_MAX] = { 0 };
+	int ret;
+
+	ts = devm_kzalloc(&spi->dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+	ts->spi = spi;
+	ts->fw_name = NVT_DEFAULT_FW;
+	ts->swrst_n8_addr = NVT_SWRST_N8_ADDR;
+	ts->spi_rd_fast_addr = NVT_SPI_RD_FAST_ADDR;
+	ts->abs_x_max = 1080;
+	ts->abs_y_max = 2400;
+	mutex_init(&ts->lock);
+	spi_set_drvdata(spi, ts);
+
+	ts->tx = devm_kzalloc(&spi->dev, NVT_XFER_MAX + 2, GFP_KERNEL);
+	ts->rx = devm_kzalloc(&spi->dev, NVT_XFER_MAX + 2, GFP_KERNEL);
+	if (!ts->tx || !ts->rx)
+		return -ENOMEM;
+
+	spi->bits_per_word = 8;
+	spi->mode = SPI_MODE_0;
+	ret = spi_setup(spi);
+	if (ret)
+		return dev_err_probe(&spi->dev, ret, "spi_setup\n");
+	dev_info(&spi->dev, "mode %d, %u Hz\n", spi->mode, spi->max_speed_hz);
+
+	device_property_read_string(&spi->dev, "firmware-name", &ts->fw_name);
+	device_property_read_u32(&spi->dev, "novatek,swrst-n8-addr",
+				 &ts->swrst_n8_addr);
+	device_property_read_u32(&spi->dev, "novatek,spi-rd-fast-addr",
+				 &ts->spi_rd_fast_addr);
+	ts->reset_gpio = devm_gpiod_get_optional(&spi->dev, "reset",
+						 GPIOD_OUT_LOW);
+	if (IS_ERR(ts->reset_gpio))
+		return dev_err_probe(&spi->dev, PTR_ERR(ts->reset_gpio),
+				     "reset gpio\n");
+	if (!ts->reset_gpio)
+		dev_warn(&spi->dev, "no reset gpio, the panel owns the reset\n");
+
+	mutex_lock(&ts->lock);
+	nvt_eng_reset(ts);
+	map = nvt_check_chip_id(ts, id);
+	mutex_unlock(&ts->lock);
+	if (!map)
+		return dev_err_probe(&spi->dev, -ENODEV,
+				     "not a supported Novatek controller (%*ph)\n",
+				     NVT_ID_BYTE_MAX, id);
+	ts->map = map;
+	dev_info(&spi->dev, "NT3667x at event buffer %#x, hw crc %u\n",
+		 map->event_buf, map->hw_crc);
+
+	ts->input = devm_input_allocate_device(&spi->dev);
+	if (!ts->input)
+		return -ENOMEM;
+	ts->input->name = NVT_NAME;
+	ts->input->phys = "input/ts";
+	ts->input->id.bustype = BUS_SPI;
+	input_set_capability(ts->input, EV_KEY, BTN_TOUCH);
+	input_set_abs_params(ts->input, ABS_MT_POSITION_X, 0, ts->abs_x_max - 1,
+			     0, 0);
+	input_set_abs_params(ts->input, ABS_MT_POSITION_Y, 0, ts->abs_y_max - 1,
+			     0, 0);
+	ret = input_mt_init_slots(ts->input, NVT_MAX_FINGERS,
+				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return dev_err_probe(&spi->dev, ret, "input_mt_init_slots\n");
+	ret = input_register_device(ts->input);
+	if (ret)
+		return dev_err_probe(&spi->dev, ret, "input_register_device\n");
+
+	if (spi->irq > 0) {
+		/* Vendor DT asks for the INT pad as an edge (flag 0x2001); the
+		 * board DTS still says level low, so override the trigger here
+		 * rather than editing the DTS. */
+		ret = devm_request_threaded_irq(&spi->dev, spi->irq, nvt_irq,
+						nvt_irq_thread,
+						IRQF_ONESHOT | IRQF_TRIGGER_RISING,
+						"picasso-nvt-vendor", ts);
+		if (ret)
+			dev_warn(&spi->dev,
+				 "irq %d request failed (%d), polling only\n",
+				 spi->irq, ret);
+		else {
+			ts->irq_enabled = true;
+			dev_info(&spi->dev, "irq %d requested (falling, threaded)\n",
+				 spi->irq);
+		}
+	} else {
+		dev_info(&spi->dev, "no irq in DT, polling only\n");
+	}
+
+	INIT_DELAYED_WORK(&ts->bringup, nvt_bringup_work);
+	INIT_DELAYED_WORK(&ts->poll, nvt_poll_work);
+
+	ts->panel_nb.notifier_call = nvt_panel_prepare;
+	blocking_notifier_chain_register(&picasso_g7a_prepare_chain,
+					 &ts->panel_nb);
+
+	ret_group = devm_device_add_group(&spi->dev, &nvt_attr_group);
+	if (ret_group)
+		dev_warn(&spi->dev, "cannot expose state (%d)\n", ret_group);
+	/* Firmware must follow the panel prepare (shared TDDI reset). */
+	schedule_delayed_work(&ts->bringup,
+			      msecs_to_jiffies(upload_delay_ms));
+	dev_info(&spi->dev, "probed, firmware %s in %d ms\n", ts->fw_name,
+		 upload_delay_ms);
+	return 0;
+}
+
+static void nvt_remove(struct spi_device *spi)
+{
+	struct nvt_ts *ts = spi_get_drvdata(spi);
+
+	blocking_notifier_chain_unregister(&picasso_g7a_prepare_chain,
+					   &ts->panel_nb);
+	cancel_delayed_work_sync(&ts->bringup);
+	cancel_delayed_work_sync(&ts->poll);
+}
+
+static const struct spi_device_id nvt_id[] = {
+	{ "picasso-nvt-ts-spi", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, nvt_id);
+
+static const struct of_device_id nvt_of_match[] = {
+	{ .compatible = "xiaomi,picasso-nvt-ts-spi" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nvt_of_match);
+
+static struct spi_driver nvt_driver = {
+	.driver = {
+		.name = "picasso-nvt-vendor",
+		.of_match_table = nvt_of_match,
+		.pm = pm_sleep_ptr(&nvt_pm_ops),
+	},
+	.id_table = nvt_id,
+	.probe = nvt_probe,
+	.remove = nvt_remove,
+};
+module_spi_driver(nvt_driver);
+
+MODULE_DESCRIPTION("Novatek NT36672C touchscreen, vendor core (Redmi K30 5G)");
+MODULE_LICENSE("GPL");
