+#define NVT_NAME		"NVTCapacitiveTouchScreen"
+#define NVT_DEFAULT_FW		"novatek/novatek_nt36672c_g7a_fw01.bin"
+
+#define NVT_MAX_FINGERS		10
+#define NVT_POINT_DATA_LEN	65	/* 1 status byte + 10 x 6-byte records */
+#define NVT_ID_BYTE_MAX		6
+#define NVT_MAX_PARTITIONS	32
+
+/* SPI framing: command bit 7 marks a write, clearing it marks a read; the
+ * chip returns two lead-in bytes before the payload of a read. */
+#define NVT_WRITE_MASK		0x80
+#define NVT_READ_MASK		0x7f
+/* Controller SRAM burst: one page select then at most half a page of data, so
+ * a burst never straddles the 128-byte page.  This is the size the earlier
+ * on-device bring-up verified against SRAM read-back with this GENI controller
+ * (the vendor's 63 KiB bursts assume a different SPI master). */
+#define NVT_WRITE_CHUNK		64
+/* Largest single register read: the 65-byte touch report. */
+#define NVT_XFER_MAX		128
+#define NVT_RETRIES		5
+
+/* Downstream defaults; the per-chip map below carries the real ones. */
+#define NVT_SWRST_N8_ADDR	0x03f0fe
+#define NVT_SPI_RD_FAST_ADDR	0x03f310
+#define NVT_ENG_RST_ADDR	0x7fff80
+#define NVT_ENG_RST_VAL		0x5a
+#define NVT_SWRST_BOOT		0x69
+#define NVT_CHIP_ID_ADDR	0x1f600
+#define NVT_CHIP_ID_OFFSET	0x4e
+
+/* Event map inside the controller's event buffer (nt36xxx.h SPI_EVENT_MAP). */
+#define NVT_EVENT_HOST_CMD	0x50
+#define NVT_EVENT_RESET_STATE	0x60
+#define NVT_EVENT_FWINFO	0x78
+#define NVT_EVENT_PROJECTID	0x9a
+
+/* Reset-complete states, in order (nt36xxx.h RST_COMPLETE_STATE). */
+#define NVT_STATE_INIT		0xa0
+#define NVT_STATE_REK		0xa1
+#define NVT_STATE_NORMAL	0xa3
+#define NVT_STATE_MAX		0xaf
+
+#define NVT_POLL_MS		20
+#define NVT_POLL_MS_IRQ		2000
+#define NVT_BRINGUP_TRIES	3
+#define NVT_BRINGUP_RETRY_MS	5000
+/* How long normal run (0xA3) may take once the image verifies. */
+#define NVT_NORMAL_WAIT_MS	5000
+/* Delay from the panel's prepare event to the upload: the vendor does it
+ * 178 us after DSI_CMD_SET_ON, but the DSI writes are fire-and-forget on this
+ * port, so leave the DDIC a moment to finish the table. */
+#define NVT_PANEL_SETTLE_MS	30
+/* While the panel is off the controller is unpowered; re-check this often. */
+#define NVT_PANEL_GATE_MS	500
+/* Polls between "is the controller still scanning?" health reads. */
+#define NVT_HEALTH_POLLS	50
