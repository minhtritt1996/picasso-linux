+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/xiaomi,g7a-37-02-0a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi g7a 37 02 0a 1080x2400 DSC DSI panel
+
+maintainers:
+  - minhtritt1996 <minhtritt1996@gmail.com>
+
+description: |
+  The 6.67" 1080x2400 AMOLED panel of the Redmi K30 5G (picasso), DSI video
+  mode with DSC 1.1 (two 540x20 slices per line).
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: xiaomi,g7a-37-02-0a
+
+  reg: true
+  reset-gpios: true
+  vddio-supply: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - port
+
+additionalProperties: false
