+static int g7a_prepare(struct drm_panel *panel)
+{
+	struct g7a *ctx = to_g7a(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	ret = regulator_enable(ctx->vddio);
+	if (ret)
+		return ret;
+
+	/* downstream reset sequence: 1 (5 ms), 0 (1 ms), 1 (10 ms) */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(5);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(1);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(10);
+
+	dev_info(&ctx->dsi->dev, "prepare: sending init sequence\n");
+	g7a_send_on(&dsi_ctx);
+	if (dsi_ctx.accum_err == 0) {
+		struct drm_dsc_picture_parameter_set pps;
+
+		drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+		mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+		mipi_dsi_compression_mode_multi(&dsi_ctx, true);
+		dev_info(&ctx->dsi->dev, "prepare: PPS sent\n");
+	}
+	ctx->prepared = true;
+	dev_info(&ctx->dsi->dev, "prepare done, err=%d\n", dsi_ctx.accum_err);
+
+	return dsi_ctx.accum_err;
+}
+
+static int g7a_unprepare(struct drm_panel *panel)
+{
+	struct g7a *ctx = to_g7a(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	if (!ctx->prepared)
+		return 0;
+
+	g7a_send_off(&dsi_ctx);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	regulator_disable(ctx->vddio);
+	ctx->prepared = false;
+
+	return 0;
+}
+
+static const struct drm_display_mode g7a_mode = {
+	/* 1080 + 40 + 12 + 40 = 1172; 2400 + 32 + 2 + 30 = 2464; 120 Hz */
+	.clock = 1172 * 2464 * 120 / 1000,
+	.hdisplay = G7A_WIDTH,
+	.hsync_start = G7A_WIDTH + 40,
+	.hsync_end = G7A_WIDTH + 40 + 12,
+	.htotal = 1172,
+	.vdisplay = G7A_HEIGHT,
+	.vsync_start = G7A_HEIGHT + 32,
+	.vsync_end = G7A_HEIGHT + 32 + 2,
+	.vtotal = 2464,
+	.width_mm = 68,
+	.height_mm = 151,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int g7a_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &g7a_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = g7a_mode.width_mm;
+	connector->display_info.height_mm = g7a_mode.height_mm;
+	connector->display_info.bpc = 8;
+
+	return 1;
+}
+
+static const struct drm_panel_funcs g7a_panel_funcs = {
+	.prepare = g7a_prepare,
+	.unprepare = g7a_unprepare,
+	.get_modes = g7a_get_modes,
+};
+
+static int g7a_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct g7a *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct g7a, panel, &g7a_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->vddio = devm_regulator_get_optional(dev, "vddio");
+	if (IS_ERR(ctx->vddio)) {
+		if (PTR_ERR(ctx->vddio) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(ctx->vddio), "Failed to get vddio\n");
+		ctx->vddio = NULL;
+	}
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT;
+
+	/* DSC 1.1, 8 bpc -> 8 bpp, two 540x20 slices, block prediction */
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_height = 20;
+	ctx->dsc.slice_count = G7A_WIDTH / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+	(void)drm_dsc_compute_rc_parameters(&ctx->dsc);
+	dsi->dsc = &ctx->dsc;
+
+	dev_info(dev, "probe: 1080x2400 video mode, DSC 8bpc\n");
+	ctx->panel.prepare_prev_first = true;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void g7a_remove(struct mipi_dsi_device *dsi)
+{
+	struct g7a *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id g7a_of_match[] = {
+	{ .compatible = "xiaomi,g7a-37-02-0a" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, g7a_of_match);
+
+static struct mipi_dsi_driver g7a_driver = {
+	.probe = g7a_probe,
+	.remove = g7a_remove,
+	.driver = {
+		.name = "panel-xiaomi-g7a",
+		.of_match_table = g7a_of_match,
+	},
+};
+module_mipi_dsi_driver(g7a_driver);
+
+MODULE_DESCRIPTION("Xiaomi g7a 37 02 0a DSI panel (picasso)");
+MODULE_LICENSE("GPL");
