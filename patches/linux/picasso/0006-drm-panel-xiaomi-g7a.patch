+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Picasso (SM7250) g7a DSI panel <-> Novatek NT36672C ordering.
+ *
+ * The touch controller is a TDDI part: its power and the reset it shares with
+ * the panel come from the panel side (vendor: novatek,reset-tddi =
+ * &pm8150l_gpios 3). Every panel prepare - boot, DPMS on, resume - pulses that
+ * reset, which throws the controller's downloaded firmware away and leaves it
+ * at 0xff on the SPI bus until it is reset and fed again. So the panel driver
+ * announces the end of its init sequence, and the touch driver rebuilds the
+ * controller from that event instead of guessing a delay.
+ */
+#ifndef _LINUX_PICASSO_G7A_H
+#define _LINUX_PICASSO_G7A_H
+
+#include <linux/notifier.h>
+
+/*
+ * Fired (blocking context, after the DCS init table and the PPS have been
+ * accepted and the display is on) with action 0 and data NULL. Fired on every
+ * prepare, not just the first one.
+ */
+extern struct blocking_notifier_head picasso_g7a_prepare_chain;
+
+/* True while the panel is prepared: streaming, backlight on. */
+bool picasso_g7a_panel_prepared(void);
+
+#endif /* _LINUX_PICASSO_G7A_H */
