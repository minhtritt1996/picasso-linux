+static int g7a_prepare(struct drm_panel *panel)
+{
+	struct g7a *ctx = to_g7a(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	ret = regulator_enable(ctx->vddio);
+	if (ret)
+		return ret;
+
+	/*
+	 * Downstream drives the line high (5 ms), low (1 ms), high (10 ms) and
+	 * leaves it high. The DT describes the reset as GPIO_ACTIVE_LOW, so the
+	 * logical values are inverted: end deasserted, or the panel never leaves
+	 * reset and every DCS command times out.
+	 */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(5);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(1);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(10);
+
+	dev_info(&ctx->dsi->dev, "prepare: sending %s init sequence\n",
+		 ctx->variant == G7A_VARIANT_36_02_0C ? "36 02 0c" : "37 02 0a");
+	g7a_send_on(ctx, &dsi_ctx);
+	if (dsi_ctx.accum_err == 0 && ctx->dsi->dsc) {
+		struct drm_dsc_picture_parameter_set pps;
+
+		drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+		mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+		mipi_dsi_compression_mode_multi(&dsi_ctx, true);
+		dev_info(&ctx->dsi->dev, "prepare: PPS sent\n");
+	} else if (dsi_ctx.accum_err == 0) {
+		/* No-DSC fork: the bootloader left the panel's DSC decoder on,
+		 * so an uncompressed stream would be decoded as garbage.
+		 */
+		mipi_dsi_compression_mode_multi(&dsi_ctx, false);
+		dev_info(&ctx->dsi->dev, "prepare: DSC disabled\n");
+	}
+
+	if (ctx->variant == G7A_VARIANT_37_02_0A) {
+		/* The 37 02 0a table carries 0x11/0x29 with a parameter byte;
+		 * follow it with clean DCS versions as this driver always has.
+		 */
+		mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+		msleep(120);
+		mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+		msleep(20);
+	} else {
+		/*
+		 * The 36 02 0c table already does 0x11 (70 ms) -> 0x29 ->
+		 * page 27h 3Fh=01/43h/40h -> page 10h, and that last group has
+		 * to remain the final DDIC state. Re-sending 0x11/0x29 here
+		 * would land after it, so the table is the only source of the
+		 * panel power commands for this variant.
+		 */
+		dev_info(&ctx->dsi->dev,
+			 "prepare: panel power driven by 36 02 0c table\n");
+	}
+	{
+		struct mipi_dsi_multi_context rd = { .dsi = ctx->dsi };
+		u8 pm = 0xff;
+
+		mipi_dsi_dcs_read_multi(&rd, MIPI_DCS_GET_POWER_MODE, &pm, 1);
+		dev_info(&ctx->dsi->dev, "prepare: power mode pm=0x%02x err=%d\n",
+			 pm, rd.accum_err);
+	}
+	ctx->prepared = true;
+	/* The PM8150L WLED is a separate device: without this the compositor
+	 * blanks the DPU but the LED strings keep the panel lit. */
+	backlight_enable(ctx->backlight);
+	dev_info(&ctx->dsi->dev, "prepare done, err=%d\n", dsi_ctx.accum_err);
+
+	/* The DDIC is out of reset and streaming: the touch controller hanging
+	 * off the same reset can be fed again. Announce it only on success. */
+	if (dsi_ctx.accum_err == 0)
+		blocking_notifier_call_chain(&picasso_g7a_prepare_chain, 0, NULL);
+
+	return dsi_ctx.accum_err;
+}
+
+static int g7a_unprepare(struct drm_panel *panel)
+{
+	struct g7a *ctx = to_g7a(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	if (!ctx->prepared)
+		return 0;
+
+	backlight_disable(ctx->backlight);
+	g7a_send_off(ctx, &dsi_ctx);
+	/* hold the panel in reset (logical 1 = physical low, active low) */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_disable(ctx->vddio);
+	ctx->prepared = false;
+
+	return 0;
+}
+
+#if G7A_NO_DSC
+/* Uncompressed 8bpc over 4 lanes: 120 Hz needs 7.5 Gbps, far past the link, so
+ * the no-DSC fork runs the panel's 60 Hz mode (1.04 Gbps/lane). */
+#define G7A_VREFRESH 60
+#else
+#define G7A_VREFRESH 120
+#endif
+
+/*
+ * "37 02 0a" timing, dsi-panel-g7a-37-02-0a-dsc-video.dtsi:66-75:
+ * h-front 40, h-pulse 12, h-back 40; v-front 32, v-pulse 2, v-back 30.
+ */
+static const struct drm_display_mode g7a_mode_37_02_0a = {
+	/* 1080 + 40 + 12 + 40 = 1172; 2400 + 32 + 2 + 30 = 2464 */
+	.clock = 1172 * 2464 * G7A_VREFRESH / 1000,
+	.hdisplay = G7A_WIDTH,
+	.hsync_start = G7A_WIDTH + 40,
+	.hsync_end = G7A_WIDTH + 40 + 12,
+	.htotal = 1172,
+	.vdisplay = G7A_HEIGHT,
+	.vsync_start = G7A_HEIGHT + 32,
+	.vsync_end = G7A_HEIGHT + 32 + 2,
+	.vtotal = 2464,
+	.width_mm = 68,
+	.height_mm = 151,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+/*
+ * "36 02 0c" timing, dsi-panel-g7a-36-02-0c-dsc-video.dtsi:66-75:
+ * h-front 30, h-pulse 4, h-back 16; v-front 32, v-pulse 4, v-back 32.
+ */
+static const struct drm_display_mode g7a_mode_36_02_0c = {
+	/* 1080 + 30 + 4 + 16 = 1130; 2400 + 32 + 4 + 32 = 2468 */
+	.clock = 1130 * 2468 * G7A_VREFRESH / 1000,
+	.hdisplay = G7A_WIDTH,
+	.hsync_start = G7A_WIDTH + 30,
+	.hsync_end = G7A_WIDTH + 30 + 4,
+	.htotal = 1130,
+	.vdisplay = G7A_HEIGHT,
+	.vsync_start = G7A_HEIGHT + 32,
+	.vsync_end = G7A_HEIGHT + 32 + 4,
+	.vtotal = 2468,
+	.width_mm = 68,
+	.height_mm = 151,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
