+static void g7a_send_off_36_02_0c(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	/* 27h: 3Fh=00 clears the TDDI/analog gate first (vendor .dtsi:197-200) */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xff, 0x27);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x3f, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xff, 0x10);
+
+	/* display off (vendor .dtsi:201) */
+	{ static const u8 b201[] = { 0x28 };
+	  mipi_dsi_dcs_write_buffer_multi(dsi_ctx, b201, sizeof(b201)); }
+
+	/* sleep in, 70 ms (vendor .dtsi:202) */
+	{ static const u8 b202[] = { 0x10 };
+	  mipi_dsi_dcs_write_buffer_multi(dsi_ctx, b202, sizeof(b202)); }
