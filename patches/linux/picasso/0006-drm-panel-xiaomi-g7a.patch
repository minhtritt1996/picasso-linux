+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Xiaomi Redmi K30 5G (picasso) DSI panel "g7a", 1080x2400 video mode with
+ * DSC 1.1.
+ *
+ * Two DDIC variants ship on this phone. The bootloader picks one from the
+ * panel's lockdown bytes; the vendor trees describe them separately:
+ *
+ *   "37 02 0a" - dsi-panel-g7a-37-02-0a-dsc-video.dtsi (default)
+ *   "36 02 0c" - dsi-panel-g7a-36-02-0c-dsc-video.dtsi (the panel fitted on
+ *                this unit, selected with the DT boolean
+ *                "xiaomi,panel-g7a-36-02-0c")
+ *
+ * The two tables differ in most DDIC pages, and they also differ in panel
+ * timing (the 36 02 0c part runs 1130x2468 totals instead of 1172x2464).
+ * Both use the same DSC configuration (1.1, 8bpc/8bpp, two 540x20 slices,
+ * block prediction). Every sequence below is a literal transcription of the
+ * cited downstream dtsi line range.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <video/mipi_display.h>
+
+#include <linux/picasso-g7a.h>
+
+/*
+ * The Novatek NT36672C next to this panel loses its firmware whenever the
+ * panel's prepare pulses the shared TDDI reset; see linux/picasso-g7a.h.
+ */
+BLOCKING_NOTIFIER_HEAD(picasso_g7a_prepare_chain);
+EXPORT_SYMBOL_GPL(picasso_g7a_prepare_chain);
+
+#define G7A_NO_DSC 0	/* uncompressed 8bpc, loader-splash compatible */
+#define G7A_WIDTH		1080
+#define G7A_HEIGHT		2400
+#define G7A_MAX_BRIGHTNESS	0x7ff
+#define G7A_DEFAULT_BRIGHTNESS	0x400
+
+enum g7a_variant {
+	G7A_VARIANT_37_02_0A,	/* dsi-panel-g7a-37-02-0a-dsc-video.dtsi */
+	G7A_VARIANT_36_02_0C,	/* dsi-panel-g7a-36-02-0c-dsc-video.dtsi */
+};
+
+struct g7a {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+	struct regulator *vddio;
+	struct backlight_device *backlight;
+	enum g7a_variant variant;
+	const struct drm_display_mode *mode;
+	bool prepared;
+};
+
+static inline struct g7a *to_g7a(struct drm_panel *panel)
+{
+	return container_of(panel, struct g7a, panel);
+}
+
+/* The one g7a on the board; the touch controller asks this before it touches
+ * the chip, because an unprepared panel means no power and no reset release. */
+static struct g7a *g7a_panel;
+
+bool picasso_g7a_panel_prepared(void)
+{
+	return g7a_panel && g7a_panel->prepared;
+}
+EXPORT_SYMBOL_GPL(picasso_g7a_panel_prepared);
+
