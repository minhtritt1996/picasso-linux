+static void g7a_send_on(struct g7a *ctx,
+			struct mipi_dsi_multi_context *dsi_ctx)
+{
+	if (ctx->variant == G7A_VARIANT_36_02_0C)
+		g7a_send_on_36_02_0c(dsi_ctx);
+	else
+		g7a_send_on_37_02_0a(dsi_ctx);
+}
