+static int g7a_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct g7a *ctx = to_g7a(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, ctx->mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = ctx->mode->width_mm;
+	connector->display_info.height_mm = ctx->mode->height_mm;
+	connector->display_info.bpc = 8;
+
+	return 1;
+}
+
+static const struct drm_panel_funcs g7a_panel_funcs = {
+	.prepare = g7a_prepare,
+	.unprepare = g7a_unprepare,
+	.get_modes = g7a_get_modes,
+};
+
+static int g7a_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct g7a *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct g7a, panel, &g7a_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->vddio = devm_regulator_get_optional(dev, "vddio");
+	if (IS_ERR(ctx->vddio)) {
+		if (PTR_ERR(ctx->vddio) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(ctx->vddio), "Failed to get vddio\n");
+		ctx->vddio = NULL;
+	}
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "Failed to get reset-gpios\n");
+
+	/* the panel's backlight (DT "backlight"), so DPMS off really turns the
+	 * LED strings off instead of leaving a dark panel with the light on */
+	ctx->backlight = devm_of_find_backlight(dev);
+	if (IS_ERR(ctx->backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->backlight), "Failed to get backlight\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	/*
+	 * Variant selection. The board DTS sets "xiaomi,panel-g7a-36-02-0c"
+	 * for the DDIC this phone actually carries; anything else keeps the
+	 * 37 02 0a table and timing, which is the driver default.
+	 */
+	if (device_property_read_bool(dev, "xiaomi,panel-g7a-36-02-0c")) {
+		ctx->variant = G7A_VARIANT_36_02_0C;
+		ctx->mode = &g7a_mode_36_02_0c;
+	} else {
+		ctx->variant = G7A_VARIANT_37_02_0A;
+		ctx->mode = &g7a_mode_37_02_0a;
+	}
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* downstream: burst mode with h-sync pulse, clock lane kept in HS */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_VIDEO_SYNC_PULSE | MIPI_DSI_MODE_LPM;
+	if (!G7A_NO_DSC)
+		dsi->mode_flags |= MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT;
+
+	/* DSC 1.1, 8 bpc -> 8 bpp, two 540x20 slices, block prediction */
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.pic_width = G7A_WIDTH;
+	ctx->dsc.pic_height = G7A_HEIGHT;
+	ctx->dsc.line_buf_depth = 9;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_height = 20;
+	ctx->dsc.slice_count = G7A_WIDTH / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+	(void)drm_dsc_compute_rc_parameters(&ctx->dsc);
+	if (!G7A_NO_DSC)
+		dsi->dsc = &ctx->dsc;
+
+	dev_info(dev, "probe: g7a %s, 1080x2400 video mode, DSC 8bpc\n",
+		 ctx->variant == G7A_VARIANT_36_02_0C ? "36 02 0c" : "37 02 0a");
+	ctx->panel.prepare_prev_first = true;
+	g7a_panel = ctx;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void g7a_remove(struct mipi_dsi_device *dsi)
+{
+	struct g7a *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id g7a_of_match[] = {
+	{ .compatible = "xiaomi,g7a-37-02-0a" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, g7a_of_match);
+
+static struct mipi_dsi_driver g7a_driver = {
+	.probe = g7a_probe,
+	.remove = g7a_remove,
+	.driver = {
+		.name = "panel-xiaomi-g7a",
+		.of_match_table = g7a_of_match,
+	},
+};
+module_mipi_dsi_driver(g7a_driver);
+
+MODULE_DESCRIPTION("Xiaomi g7a 37 02 0a / 36 02 0c DSI panel (picasso)");
+MODULE_LICENSE("GPL");
