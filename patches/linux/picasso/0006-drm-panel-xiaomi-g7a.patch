+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x3f, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xff, 0x10);
+	{ static const u8 b_28[] = { 0x28 };
+	  mipi_dsi_dcs_write_buffer_multi(dsi_ctx, b_28, sizeof(b_28)); }
+	{ static const u8 b_10[] = { 0x10 };
