+static void pm7250b_chg_tune_fast_charge(struct pm7250b_chg *chg)
+{
+	unsigned int apsd = 0, icl = 0, fcc = 0;
+
+	/* Allow autonomous HVDCP (QC2.0/QC3.0) negotiation on dedicated chargers */
+	regmap_update_bits(chg->regmap, chg->base + USBIN_OPTIONS_1_CFG,
+			   HVDCP_EN_BIT | HVDCP_AUTONOMOUS_MODE_EN_BIT,
+			   HVDCP_EN_BIT | HVDCP_AUTONOMOUS_MODE_EN_BIT);
+
+	if (pm7250b_chg_read(chg, APSD_RESULT_STATUS, &apsd))
+		return;
+
+	if (!(apsd & (APSD_QC_3P0_BIT | APSD_QC_2P0_BIT |
+		      APSD_DCP_CHARGER_BIT | APSD_CDP_CHARGER_BIT)))
+		return;
+
+	if (!pm7250b_chg_read(chg, USBIN_CURRENT_LIMIT_CFG, &icl) &&
+	    icl < PM7250B_FAST_ICL_3000MA)
+		regmap_write(chg->regmap, chg->base + USBIN_CURRENT_LIMIT_CFG,
+			     PM7250B_FAST_ICL_3000MA);
+
+	if (!pm7250b_chg_read(chg, CHGR_FAST_CHARGE_CURRENT_CFG, &fcc) &&
+	    fcc < PM7250B_FAST_FCC_3500MA)
+		regmap_write(chg->regmap,
+			     chg->base + CHGR_FAST_CHARGE_CURRENT_CFG,
+			     PM7250B_FAST_FCC_3500MA);
+}
