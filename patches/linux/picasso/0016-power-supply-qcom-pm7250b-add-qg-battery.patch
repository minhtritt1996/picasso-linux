+static int pm7250b_qg_read_u16(struct pm7250b_chg *chg, unsigned int reg,
+			       u16 *val)
+{
+	__le16 raw;
+	int ret;
+
+	ret = regmap_bulk_read(chg->regmap, reg, &raw, sizeof(raw));
+	if (ret)
+		return ret;
+
+	*val = le16_to_cpu(raw);
+	return 0;
+}
+
+static int pm7250b_bat_read_uv(struct pm7250b_chg *chg, unsigned int reg,
+			       int *uv)
+{
+	u16 raw;
+	int ret;
+
+	ret = pm7250b_qg_read_u16(chg, reg, &raw);
+	if (ret)
+		return ret;
+	if (!raw || raw == 0x8000 || raw == 0xffff)
+		return -ENODATA;
+
+	*uv = div_u64(194637ULL * raw, 1000);
+	return 0;
+}
+
+static int pm7250b_bat_current_ua(struct pm7250b_chg *chg, int *ua)
+{
+	u16 raw;
+	int ret;
+
+	ret = pm7250b_qg_read_u16(chg, QG_S2_NORMAL_AVG_I_DATA0_REG, &raw);
+	if (!ret && raw != 0x8000 && raw != 0xffff) {
+		*ua = div_s64((s64)(s16)raw * 152588LL, 1000);
+		return 0;
+	}
+
+	ret = pm7250b_qg_read_u16(chg, QG_LAST_ADC_I_DATA0_REG, &raw);
+	if (ret)
+		return ret;
+	if (raw == 0x8000 || raw == 0xffff)
+		return -ENODATA;
+
+	*ua = div_s64((s64)(s16)raw * 152588LL, 1000);
+	return 0;
+}
+
+static int pm7250b_bat_vbat_uv(struct pm7250b_chg *chg, int *uv)
+{
+	if (!pm7250b_bat_read_uv(chg, QG_S2_NORMAL_AVG_V_DATA0_REG, uv))
+		return 0;
+	if (!pm7250b_bat_read_uv(chg, QG_LAST_ADC_V_DATA0_REG, uv))
+		return 0;
+	return pm7250b_bat_read_uv(chg, QG_S7_PON_OCV_V_DATA0_REG, uv);
+}
+
+/*
+ * Estimate open-circuit voltage by compensating for ~90 mOhm battery internal
+ * resistance (current_now is positive during discharge, negative when charging).
+ */
+static int pm7250b_bat_ocv_uv(struct pm7250b_chg *chg, int *ocv_uv)
+{
+	int ret, uv, ua;
+
+	ret = pm7250b_bat_vbat_uv(chg, &uv);
+	if (ret)
+		return ret;
+
+	if (!pm7250b_bat_current_ua(chg, &ua))
+		uv += div_s64((s64)ua * 90LL, 1000);
+
+	*ocv_uv = uv;
+	return 0;
+}
+
+/* 25C OCV-SoC LUT from Xiaomi picasso G7ANVTBM4P 4500mAh batterydata */
+static int pm7250b_bat_capacity(int uv, int status)
+{
+	static const struct {
+		int mv;
+		int pct;
+	} curve[] = {
+		{ 4382, 100 },
+		{ 4339,  96 },
+		{ 4269,  90 },
+		{ 4198,  84 },
+		{ 4154,  80 },
+		{ 4052,  70 },
+		{ 3965,  60 },
+		{ 3873,  50 },
+		{ 3824,  40 },
+		{ 3782,  30 },
+		{ 3717,  20 },
+		{ 3676,  10 },
+		{ 3575,   6 },
+		{ 3496,   4 },
+		{ 3374,   2 },
+		{ 3000,   0 },
+	};
+	int mv = uv / 1000;
+	int i;
+
+	if (status == POWER_SUPPLY_STATUS_FULL || mv >= curve[0].mv)
+		return 100;
+	if (mv <= curve[ARRAY_SIZE(curve) - 1].mv)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(curve) - 1; i++) {
+		if (mv >= curve[i + 1].mv) {
+			int dv = curve[i].mv - curve[i + 1].mv;
+			int dp = curve[i].pct - curve[i + 1].pct;
+
+			return curve[i + 1].pct +
+			       ((mv - curve[i + 1].mv) * dp) / dv;
+		}
+	}
+
+	return 0;
+}
+
+static int pm7250b_bat_get_property(struct power_supply *psy,
+				    enum power_supply_property psp,
+				    union power_supply_propval *val)
+{
+	struct pm7250b_chg *chg = power_supply_get_drvdata(psy);
+	int ret, uv, status;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_HEALTH:
+		val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = 4450000;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = 3400000;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		val->intval = 4500000;
+		return 0;
+	case POWER_SUPPLY_PROP_STATUS:
+		return pm7250b_chg_status(chg, &val->intval);
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		return pm7250b_bat_vbat_uv(chg, &val->intval);
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		return pm7250b_bat_read_uv(chg, QG_S7_PON_OCV_V_DATA0_REG,
+					   &val->intval);
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		return pm7250b_bat_current_ua(chg, &val->intval);
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = pm7250b_chg_status(chg, &status);
+		if (ret)
+			return ret;
+		ret = pm7250b_bat_ocv_uv(chg, &uv);
+		if (ret)
+			return ret;
+		val->intval = pm7250b_bat_capacity(uv, status);
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		ret = pm7250b_chg_status(chg, &status);
+		if (ret)
+			return ret;
+		ret = pm7250b_bat_ocv_uv(chg, &uv);
+		if (ret)
+			return ret;
+		val->intval = pm7250b_bat_capacity(uv, status) * 45000;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
