diff --git a/drivers/media/platform/qcom/venus/core.c b/drivers/media/platform/qcom/venus/core.c
index 5edba041b..83e78b8f8 100644
--- a/drivers/media/platform/qcom/venus/core.c
+++ b/drivers/media/platform/qcom/venus/core.c
@@ -511,10 +511,15 @@ static int venus_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_of_depopulate;
 
-	ret = pm_runtime_put_sync(dev);
-	if (ret) {
-		pm_runtime_get_noresume(dev);
-		goto err_of_depopulate;
+	if (IS_IRIS1(core)) {
+		pm_runtime_forbid(dev);
+		pm_runtime_put_noidle(dev);
+	} else {
+		ret = pm_runtime_put_sync(dev);
+		if (ret) {
+			pm_runtime_get_noresume(dev);
+			goto err_of_depopulate;
+		}
 	}
 
 	venus_dbgfs_init(core);
diff --git a/drivers/media/platform/qcom/venus/hfi_venus.c b/drivers/media/platform/qcom/venus/hfi_venus.c
index 06a0ed551..e4416251e 100644
--- a/drivers/media/platform/qcom/venus/hfi_venus.c
+++ b/drivers/media/platform/qcom/venus/hfi_venus.c
@@ -131,7 +131,7 @@ struct venus_hfi_device {
 
 static bool venus_pkt_debug;
 int venus_fw_debug = HFI_DEBUG_MSG_ERROR | HFI_DEBUG_MSG_FATAL;
-static bool venus_fw_low_power_mode = true;
+static bool venus_fw_low_power_mode = false;
 static int venus_hw_rsp_timeout = 1000;
 static bool venus_fw_coverage;
 
@@ -1620,7 +1620,11 @@ static int venus_suspend_3xx(struct venus_core *core)
 	ret = readx_poll_timeout(venus_cpu_and_video_core_idle, hdev, val, val,
 				 1500, 100 * 1500);
 	if (ret) {
-		dev_err(dev, "wait for cpu and video core idle fail (%d)\n", ret);
+		u32 cpu_status = readl(hdev->core->wrapper_base + WRAPPER_CPU_STATUS);
+		u32 cs = readl(cpu_cs_base + CPU_CS_SCIACMDARG0);
+
+		dev_err(dev, "wait for cpu and video core idle fail (%d) cpu=%#x ctrl=%#x\n",
+			ret, cpu_status, cs);
 		return ret;
 	}
 
diff --git a/drivers/media/platform/qcom/venus/pm_helpers.c b/drivers/media/platform/qcom/venus/pm_helpers.c
index e88e66be4..7147b2fcf 100644
--- a/drivers/media/platform/qcom/venus/pm_helpers.c
+++ b/drivers/media/platform/qcom/venus/pm_helpers.c
@@ -554,6 +554,9 @@ static int vcodec_control_v4(struct venus_core *core, u32 coreid, bool enable)
 	u32 val;
 	int ret;
 
+	if (IS_IRIS1(core) && !enable)
+		return 0;
+
 	ret = dev_pm_genpd_set_hwmode(core->pmdomains->pd_devs[coreid], !enable);
 	if (ret == -EOPNOTSUPP) {
 		core->hwmode_dev = false;
@@ -594,6 +597,9 @@ static int poweroff_coreid(struct venus_core *core, unsigned int coreid_mask)
 	int ret;
 
 	if (coreid_mask & VIDC_CORE_ID_1) {
+		if (IS_IRIS1(core))
+			return 0;
+
 		ret = vcodec_control_v4(core, VIDC_CORE_ID_1, true);
 		if (ret)
 			return ret;
@@ -637,6 +643,11 @@ static int poweron_coreid(struct venus_core *core, unsigned int coreid_mask)
 	int ret;
 
 	if (coreid_mask & VIDC_CORE_ID_1) {
+		static bool iris1_vcodec0_on;
+
+		if (IS_IRIS1(core) && iris1_vcodec0_on)
+			goto skip_vcodec0;
+
 		ret = pm_runtime_get_sync(core->pmdomains->pd_devs[1]);
 		if (ret < 0)
 			return ret;
@@ -649,10 +660,15 @@ static int poweron_coreid(struct venus_core *core, unsigned int coreid_mask)
 		if (ret)
 			return ret;
 
-		ret = vcodec_control_v4(core, VIDC_CORE_ID_1, false);
-		if (ret < 0)
-			return ret;
+		if (!IS_IRIS1(core)) {
+			ret = vcodec_control_v4(core, VIDC_CORE_ID_1, false);
+			if (ret < 0)
+				return ret;
+		} else {
+			iris1_vcodec0_on = true;
+		}
 	}
+skip_vcodec0:
 
 	if (coreid_mask & VIDC_CORE_ID_2) {
 		ret = pm_runtime_get_sync(core->pmdomains->pd_devs[2]);
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 6a43ea191..d47f558f9 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -252,8 +252,14 @@ static int vdec_check_src_change(struct venus_inst *inst)
 
 	if (inst->subscriptions & V4L2_EVENT_SOURCE_CHANGE &&
 	    inst->codec_state == VENUS_DEC_STATE_INIT &&
-	    !inst->reconfig)
-		return -EINVAL;
+	    !inst->reconfig) {
+		if (!inst->streamon_out)
+			return -EINVAL;
+		ret = wait_event_timeout(inst->reconf_wait, inst->reconfig,
+					 msecs_to_jiffies(100));
+		if (!ret)
+			return -EINVAL;
+	}
 
 	if (inst->subscriptions & V4L2_EVENT_SOURCE_CHANGE)
 		return 0;
