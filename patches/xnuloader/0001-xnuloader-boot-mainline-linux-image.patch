+/*
+ * A word of RAM outside everything the loader and the kernel touch, used to
+ * find out how far boot_linux() got when the phone resets: DDR keeps its
+ * contents across a PSCI reset, the loader prints it at start-up.
+ */
+#define BREADCRUMB (*(volatile uint32_t *)0xF3FF0000ULL)
+
+/* why boot_linux() gave up: visible through "fastboot getvar result" */
+static int
+linux_bail(uint64_t code)
+{
+	set_result("linux-fail", code, 0);
+	return 0;
+}
+
+/*
+ * Boot a mainline Linux arm64 Image. The EFI stub reads the device tree from
+ * the EFI configuration table and the ramdisk from /chosen; when the payload
+ * has no initrd the two /chosen cells are filled here from the resident image
+ * the host sent with "oem ramdisk".
+ */
+static int
+boot_linux(const struct payload_info *pi)
+{
+	static efi_guid dtb_guid = DEVICE_TREE_GUID;
+	efi_handle handle;
+	efi_status s;
+
+	uint64_t initrd_pa = 0, initrd_size = 0;
+	/*
+	 * The payload window is ordinary RAM to the kernel, which relocates and
+	 * decompresses over it before the EFI stub reads the FDT; the stub then
+	 * reports "invalid header detected on uefi supplied fdt". Keep the tree in
+	 * this image's own storage and hand over the copy.
+	 */
+	static uint8_t dtb_copy[0x20000] __attribute__((aligned(4096)));
+
+	if (pi->linux_dtb == NULL || pi->linux_dtb_size < 0x30 ||
+	    pi->linux_dtb_size > sizeof(dtb_copy))
+		return linux_bail(5);
+	if (__builtin_bswap32(*(const uint32_t *)pi->linux_dtb) != 0xd00dfeedu)
+		return linux_bail(6);
+	memcpy(dtb_copy, pi->linux_dtb, pi->linux_dtb_size);
+	print("linux: dtb copied %x bytes\n", (uint64_t)pi->linux_dtb_size);
+
+	/*
+	 * Two ways to give Linux its root: the payload's own initrd (small, it
+	 * rides in the 63 MiB container), or the resident image the host sent
+	 * with "oem ramdisk", which sits at win_base + RESIDENT_RD_OFFSET and
+	 * can be gigabytes.  The latter needs the two /chosen cells rewritten
+	 * now, because where it lands is only known at run time.
+	 */
+	if (pi->linux_initrd != NULL) {
+		initrd_pa = (uint64_t)pi->linux_initrd;
+		initrd_size = (uint64_t)pi->linux_initrd_size;
+	} else if (resident_rd_size != 0 && win_base != 0) {
+		initrd_pa = win_base + RESIDENT_RD_OFFSET;
+		initrd_size = resident_rd_size;
+		print("linux: using the resident image: %x bytes @ %x\n",
+		    resident_rd_size, initrd_pa);
+		BREADCRUMB = 0x1002;            /* resident address resolved */
+		if (!patch_linux_initrd(dtb_copy, initrd_pa,
+					initrd_pa + initrd_size)) {
+			print("linux: the payload DTB has no usable /chosen/linux,initrd-*\n");
+			return linux_bail(2);
+		}
+	}
+	print("== LINUX Image %x @ %x, initrd %x @ %x, dtb %x @ %x ==\n",
+	    (uint64_t)pi->linux_image_size, (uint64_t)pi->linux_image,
+	    initrd_size, initrd_pa,
+	    (uint64_t)pi->linux_dtb_size, (uint64_t)pi->linux_dtb);
+	if (pi->linux_image == NULL || initrd_pa == 0 || pi->linux_dtb == NULL) {
+		print("linux: need an Image, a dtb and either an initrd in the payload or a resident image\n");
+		return linux_bail(1);
+	}
+	BREADCRUMB = 0x1003;                    /* dtb + initrd decided */
+	s = ((efi_install_configuration_table_fn)BS->install_configuration_table)(&dtb_guid, dtb_copy);
+	if (EFI_ERROR(s)) {
+		print("linux: install_configuration_table failed %x\n", s);
+		return linux_bail(3);
+	}
+	/*
+	 * The bootloader arms the APSS watchdog (~30 s bite) and mainline only
+	 * takes it over when qcom_wdt probes. A panic before that resets the
+	 * phone and the reason is lost, so stop it before handing over. The
+	 * kernel restarts it itself once the driver is up.
+	 */
+	*(volatile uint32_t *)(0x17C10000ULL + 0x08) = 0;   /* WDT_EN (kpss layout) */
+	print("linux: APSS watchdog stopped\n");
+	BREADCRUMB = 0x1004;                    /* about to LoadImage */
+	s = ((efi_load_image_fn)BS->load_image)(0, IMAGE, NULL, (void *)pi->linux_image, pi->linux_image_size, &handle);
+	if (EFI_ERROR(s)) {
+		print("linux: LoadImage failed %x\n", s);
+		return linux_bail(4);
+	}
+	BREADCRUMB = 0x1005;                    /* Image loaded, starting it */
+	print("linux: starting the kernel\n");
+	s = ((efi_start_image_fn)BS->start_image)(handle, NULL, NULL);
+	print("linux: the kernel returned %x\n", s);
+	BS->stall(30000000);            /* leave the message on the screen */
+	return 1;
+}
