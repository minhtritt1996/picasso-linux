+/*
+ * Patch /chosen/linux,initrd-start and -end in the payload's board DTB, in
+ * place: both properties must already exist with a 8-byte value (the packer
+ * writes placeholders), because growing the blob is not supported here.  They
+ * are two big-endian cells each (the root has #address-cells = 2).
+ * Returns 1 when both were written.
+ */
+static int
+patch_linux_initrd(void *fdt, uint64_t start, uint64_t end)
+{
+	uint8_t *b = fdt;
+	uint32_t p, magic, totalsize, off_struct, off_strings, version;
+	int depth = 0, in_chosen = 0, found = 0;
+
+	if (b == NULL) {
+		return 0;
+	}
+	magic = __builtin_bswap32(*(uint32_t *)(b + 0));
+	totalsize = __builtin_bswap32(*(uint32_t *)(b + 4));
+	off_struct = __builtin_bswap32(*(uint32_t *)(b + 8));
+	off_strings = __builtin_bswap32(*(uint32_t *)(b + 12));
+	version = __builtin_bswap32(*(uint32_t *)(b + 20));
+	if (magic != 0xd00dfeedu || version < 16 || totalsize > 0x1000000u ||
+	    off_struct >= totalsize || off_strings >= totalsize) {
+		print("linux: /chosen patch: not an FDT (magic %x ver %u)\n", magic, version);
+		return 0;
+	}
+
+	p = off_struct;
+	while (p + 4 <= totalsize) {
+		uint32_t tok = __builtin_bswap32(*(uint32_t *)(b + p));
+
+		p += 4;
+		if (tok == 4) {					/* NOP */
+			continue;
+		}
+		if (tok == 1) {					/* BEGIN_NODE */
+			const char *name = (const char *)(b + p);
+			uint32_t len = 0;
+
+			while (p + len < totalsize && b[p + len] != 0) {
+				len++;
+			}
+			if (!in_chosen && depth == 1 && len == 6 &&
+			    starts_with(name, "chosen")) {
+				in_chosen = 1;
+			}
+			depth++;
+			p += (len + 1 + 3) & ~3u;
+			continue;
+		}
+		if (tok == 2) {					/* END_NODE */
+			depth--;
+			if (in_chosen && depth < 2) {
+				break;
+			}
+			continue;
+		}
+		if (tok == 3) {					/* PROP */
+			uint32_t len = __builtin_bswap32(*(uint32_t *)(b + p));
+			uint32_t nameoff = __builtin_bswap32(*(uint32_t *)(b + p + 4));
+			const char *pname = (const char *)(b + off_strings + nameoff);
+			uint8_t *val = b + p + 8;
+			uint64_t v = 0;
+
+			if (p + 8 + ((len + 3) & ~3u) > totalsize) {
+				return 0;
+			}
+			if (in_chosen && depth == 2 && len == 8 &&
+			    (starts_with(pname, "linux,initrd-start") ||
+			     starts_with(pname, "linux,initrd-end"))) {
+				int is_start = starts_with(pname, "linux,initrd-start");
+
+				v = is_start ? start : end;
+				*(uint32_t *)val = __builtin_bswap32((uint32_t)(v >> 32));
+				*(uint32_t *)(val + 4) = __builtin_bswap32((uint32_t)v);
+				found |= is_start ? 1 : 2;
+			}
+			p += 8 + ((len + 3) & ~3u);
+			continue;
+		}
+		if (tok == 9) {					/* END */
+			break;
+		}
+		return 0;
+	}
+	return found == 3;
+}
