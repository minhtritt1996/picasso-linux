+/*
+ * Linux already mirrors its console into a 1 MiB RAM window (kernel/printk).
+ * Bring the tail into this log at start-up so a kernel that died before USB
+ * appeared is still readable with "fastboot get_staged" and in logdump.
+ */
+#define RAMLOG_PHYS	0xF3F00000ULL
+#define RAMLOG_DATA	0x1000U
+#define RAMLOG_ROOM	(0x100000U - RAMLOG_DATA)
+#define RAMLOG_MAGIC	0x474F4C52U
+
+static void
+ramlog_append(void)
+{
+	const uint32_t *hdr = (const uint32_t *)(uintptr_t)RAMLOG_PHYS;
+	const char *data = (const char *)(uintptr_t)(RAMLOG_PHYS + RAMLOG_DATA);
+	static const char title[] = "\n== previous kernel console ==\n";
+	uint32_t magic = hdr[0], pos = hdr[1], total = hdr[2];
+	uint32_t take, start, i;
+
+	if (magic != RAMLOG_MAGIC || total == 0) {
+		return;
+	}
+	take = total < RAMLOG_ROOM ? total : RAMLOG_ROOM;
+	if (take > 20000) {
+		take = 20000;
+	}
+	if (log_len + take + sizeof(title) + 2 >= sizeof(log_buf)) {
+		return;
+	}
+	if (total <= RAMLOG_ROOM) {
+		start = total - take;
+	} else {
+		start = (pos + RAMLOG_ROOM - take) % RAMLOG_ROOM;
+	}
+	memcpy(log_buf + log_len, title, sizeof(title) - 1);
+	log_len += sizeof(title) - 1;
+	for (i = 0; i < take; i++) {
+		log_buf[log_len++] = data[(start + i) % RAMLOG_ROOM];
+	}
+	log_buf[log_len] = 0;
+}
