+
+		print("usb: starting\n");
+		usb_ok = usb_start();
+		print("usb: start %s\n", usb_ok ? "ok" : "FAILED");
+		if (usb_ok) {
+			usb_ready = 1;
+			flush_log();
+			usb_command_loop();
+		}
 	}
 
-	/* One-shot mode: run the kernel that came with the image, then reset. */
+	/*
+	 * One-shot mode: run the kernel that came with the image. If it comes
+	 * back (the EFI stub returned instead of entering the kernel), stay in
+	 * the USB loop so the log and the error code can be read out; only a
+	 * kernel that never returns ends in the reset below.
+	 */
 	if (have_payload) {
-		run_kernel(0, 0);
+		if (!run_kernel(0, 0)) {
+			print("loader: nothing started\n");
+		} else {
+			print("loader: the kernel came back; staying in the USB loop\n");
+			flush_log();
+			if (usb_ready) {
+				usb_command_loop();
+			}
+		}
+		BS->stall(30000000);
 	}
 	reboot();
 	return 0;
