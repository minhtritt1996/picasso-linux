 		} else {
 			ramfb_phone_screen();
 		}
@@ -4356,14 +4457,40 @@ efi_main(efi_handle image, efi_system_table *st)
 	wdt_arm();
 
 	int have_payload = parse_payload(&pi, 0);
-	if (have_payload && pi.usb_mode && usb_start()) {
-		flush_log();
-		usb_command_loop();
+	int usb_ready = 0;
+	print("payload: have=%d usb_mode=%d image=%x initrd=%x dtb=%x\n", (uint64_t)have_payload,
+	    (uint64_t)pi.usb_mode, (uint64_t)(unsigned long)pi.linux_image,
+	    (uint64_t)(unsigned long)pi.linux_initrd, (uint64_t)(unsigned long)pi.linux_dtb);
+	if (have_payload && pi.usb_mode) {
