 			fb_reply("OKAY", "");
+		} else if (starts_with(cmd, "oem ramoops")) {
+			/* stage the pstore/ramoops zone from the last boot (board DTS) */
+			staged_data = (const char *)(uintptr_t)0xF3F00000ULL;
