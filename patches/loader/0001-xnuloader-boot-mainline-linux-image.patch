+/*
+ * picasso: Redmi K30 5G, SM7250 (lito). Same GIC as redwood; the cores are 6 Cortex-A55
+ * (0-5) and 2 Cortex-A76 (6-7), numbered in MPIDR's second affinity field. Linux does not
+ * use this (its own DTB describes the SoC); it is here because the display branch below
+ * needs a platform for the phone's framebuffer. Kept in sync with the HakiOS XNU port.
+ */
+static const struct platform platform_picasso = {
+	.name = "picasso", .io_base = 0x00400000, .io_size = 0x3FC00000,
+	.gic_dist = 0x17A00000, .gic_redist = 0x17A60000, .uart = 0, .log_other_cpu = 1,
+	.cores = 8, .core_shift = 8,
+	.small_cores = 0x3f,
+};
